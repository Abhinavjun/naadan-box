<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Category Details - Naadan Box</title>


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >


    <!-- =====================================================
         NAADAN BOX VIEW CATEGORY
         ===================================================== -->

    <style>

        /* =====================================================
           ROOT
           Same design system as Categories page
           ===================================================== */

        :root {

            --green: #1B5233;
            --green-dark: #16452B;
            --green-soft: #EDF4ED;

            --gold: #C99B25;
            --gold-soft: #F8EFCF;

            --cream: #F8F5ED;
            --cream-dark: #F1EDE3;

            --white: #FFFDF8;

            --text: #25372C;
            --muted: #7B857D;

            --border: #E5DFD2;

            --danger: #C95454;
            --danger-soft: #FFF0F0;
        }


        /* =====================================================
           GLOBAL
           ===================================================== */

        * {
            box-sizing: border-box;
        }


        html {
            overflow-y: scroll;
        }


        body {

            margin: 0;

            min-height: 100vh;

            background: var(--cream);

            color: var(--text);

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                "Helvetica Neue",
                Arial,
                sans-serif;
        }


        button,
        a {
            font: inherit;
        }


        button {
            cursor: pointer;
        }


        /* =====================================================
           MAIN ADMIN LAYOUT
           ===================================================== */

        .admin-main {

            position: relative;

            margin-left: 255px;

            width:
                calc(100% - 255px);

            min-height: 100vh;

            overflow: hidden;
        }


        /* =====================================================
           BOTANICAL BACKGROUND
           ===================================================== */

        .category-leaf {

            position: absolute;

            pointer-events: none;

            z-index: 0;
        }


        .category-leaf-right {

            width: 220px;
            height: 95px;

            right: -72px;
            top: 145px;

            background:
                rgba(213,216,199,.32);

            border-radius:
                100% 0 100% 0;

            transform:
                rotate(-34deg);
        }


        .category-leaf-right::after {

            content: "";

            position: absolute;

            width: 1px;
            height: 145px;

            left: 110px;
            top: -27px;

            background:
                rgba(190,181,145,.22);

            transform:
                rotate(-20deg);
        }


        .category-leaf-left {

            width: 160px;
            height: 68px;

            left: -82px;
            bottom: 90px;

            background:
                rgba(218,218,203,.25);

            border-radius:
                100% 0 100% 0;

            transform:
                rotate(43deg);
        }


        .category-leaf-left::after {

            content: "";

            position: absolute;

            width: 1px;
            height: 110px;

            left: 80px;
            top: -20px;

            background:
                rgba(190,181,145,.20);

            transform:
                rotate(-20deg);
        }


        .category-leaf-small {

            width: 90px;
            height: 38px;

            right: 100px;
            bottom: 25px;

            background:
                rgba(218,218,203,.18);

            border-radius:
                100% 0 100% 0;

            transform:
                rotate(28deg);
        }


        /* =====================================================
           PAGE CONTENT
           ===================================================== */

        .category-details-content {

            position: relative;

            z-index: 1;

            padding:
                38px
                38px
                48px;

            max-width: 1700px;

            margin: 0 auto;
        }


        /* =====================================================
           HERO
           ===================================================== */

        .category-hero {

            position: relative;

            text-align: center;

            margin-bottom: 28px;
        }


        .category-eyebrow {

            margin-bottom: 8px;

            color: var(--gold);

            font-size: 9px;

            font-weight: 700;

            letter-spacing: 2.5px;

            text-transform: uppercase;
        }


        .category-page-heading {

            margin: 0;

            color: var(--green);

            font-size: 30px;

            font-weight: 800;

            letter-spacing: -.6px;
        }


        .category-page-subtitle {

            max-width: 520px;

            margin:
                8px
                auto
                0;

            color: var(--muted);

            font-size: 12px;

            line-height: 1.6;
        }


        .hero-decoration {

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            margin-top: 14px;
        }


        .hero-decoration::before {

            content: "";

            width: 34px;
            height: 2px;

            background:
                var(--gold);

            border-radius: 10px;
        }


        .hero-decoration span {

            width: 5px;
            height: 5px;

            background:
                var(--gold);

            transform:
                rotate(45deg);
        }


        .hero-decoration::after {

            content: "";

            width: 34px;
            height: 1px;

            background:
                #D9CDA9;

            border-radius: 10px;
        }


        /* =====================================================
           TOP ACTIONS
           ===================================================== */

        .category-top-actions {

            position: relative;

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 19px;
        }


        .category-intro-note {

            display: flex;

            align-items: center;

            gap: 9px;

            color: var(--muted);

            font-size: 11px;
        }


        .category-intro-note::before {

            content: "";

            width: 28px;
            height: 2px;

            background:
                var(--gold);

            border-radius: 10px;
        }


        .top-action-group {

            display: flex;

            align-items: center;

            gap: 8px;
        }


        .top-action-button {

            height: 40px;

            min-width: 112px;

            padding:
                0 16px;

            border:
                1px solid var(--border);

            border-radius: 8px;

            background:
                var(--white);

            color:
                var(--text);

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            font-size: 11px;

            font-weight: 600;

            text-decoration: none;

            transition:
                background .2s ease,
                border-color .2s ease,
                color .2s ease,
                transform .2s ease;
        }


        .top-action-button:hover {

            background:
                var(--cream-dark);

            border-color:
                #D6CCB8;

            color:
                var(--green);

            transform:
                translateY(-1px);
        }


        .edit-action {

            min-width: 132px;

            border-color:
                var(--green);

            background:
                var(--green);

            color:
                #fff;
        }


        .edit-action:hover {

            background:
                var(--green-dark);

            border-color:
                var(--green-dark);

            color:
                #fff;
        }


        /* =====================================================
           MAIN DETAILS CARD
           ===================================================== */

        .category-details-card {

            position: relative;

            display: grid;

            grid-template-columns:
                minmax(310px, .85fr)
                minmax(420px, 1.15fr);

            gap: 0;

            background:
                var(--white);

            border:
                1px solid var(--border);

            border-radius: 14px;

            overflow: hidden;

            box-shadow:
                0 7px 25px
                rgba(27,82,51,.045);
        }


        /* =====================================================
           IMAGE PANEL
           ===================================================== */

        .category-image-panel {

            min-height: 455px;

            padding:
                28px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                linear-gradient(
                    145deg,
                    #F2EFE5,
                    #FBF9F3
                );

            border-right:
                1px solid #EEE9DF;
        }


        .category-image-frame {

            position: relative;

            width: 100%;

            max-width: 470px;

            aspect-ratio: 4 / 3;

            overflow: hidden;

            border-radius: 14px;

            background:
                #F1EEE4;

            border:
                1px solid #DDD6C7;

            box-shadow:
                0 12px 30px
                rgba(27,82,51,.08);
        }


        .category-image {

            width: 100%;
            height: 100%;

            display: block;

            object-fit: cover;
        }


        .image-placeholder {

            width: 100%;
            height: 100%;

            display: none;

            align-items: center;
            justify-content: center;

            flex-direction: column;

            gap: 8px;

            color:
                #9AA19B;

            background:
                #F1EEE4;
        }


        .image-placeholder i {

            font-size: 32px;
        }


        .image-placeholder span {

            font-size: 10px;

            color:
                var(--muted);
        }


        .image-label {

            position: absolute;

            left: 13px;
            bottom: 13px;

            padding:
                6px
                9px;

            border-radius: 6px;

            background:
                rgba(27,82,51,.88);

            color:
                #fff;

            font-size: 8px;

            font-weight: 700;

            letter-spacing: .7px;

            text-transform: uppercase;
        }


        /* =====================================================
           INFORMATION PANEL
           ===================================================== */

        .category-information-panel {

            padding:
                30px
                32px;
        }


        .information-heading {

            display: flex;

            align-items: center;

            gap: 11px;

            padding-bottom: 17px;

            border-bottom:
                1px solid #EEE9DF;
        }


        .information-mark {

            width: 36px;
            height: 36px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 9px;

            background:
                var(--green-soft);

            color:
                var(--green);

            font-size: 16px;
        }


        .information-title {

            margin: 0;

            color:
                var(--green);

            font-size: 16px;

            font-weight: 800;
        }


        .information-subtitle {

            margin-top: 3px;

            color:
                var(--muted);

            font-size: 9px;
        }


        /* =====================================================
           DETAIL ROWS
           ===================================================== */

        .details-list {

            margin-top: 7px;
        }


        .detail-row {

            min-height: 68px;

            padding:
                13px
                0;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 25px;

            border-bottom:
                1px solid #EEE9DF;
        }


        .detail-row:last-child {

            border-bottom: 0;
        }


        .detail-label {

            color:
                var(--muted);

            font-size: 9px;

            font-weight: 700;

            letter-spacing: .8px;

            text-transform: uppercase;

            white-space: nowrap;
        }


        .detail-value {

            max-width: 62%;

            color:
                var(--text);

            font-size: 12px;

            font-weight: 600;

            text-align: right;

            word-break: break-word;
        }


        .detail-value.primary {

            color:
                var(--green);

            font-size: 14px;

            font-weight: 800;
        }


        .detail-value.muted {

            color:
                var(--muted);

            font-size: 10px;

            font-weight: 500;
        }


        /* =====================================================
           STATUS
           ===================================================== */

        .status-badge {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 6px;

            min-width: 65px;

            height: 23px;

            padding:
                0 9px;

            border-radius: 13px;

            font-size: 8px;

            font-weight: 700;

            letter-spacing: .5px;

            text-transform: uppercase;
        }


        .status-dot {

            width: 5px;
            height: 5px;

            border-radius: 50%;
        }


        .status-active {

            background:
                #E2F2E5;

            color:
                #34744A;

            border:
                1px solid #D2E8D6;
        }


        .status-active .status-dot {

            background:
                #4B8A58;
        }


        .status-inactive {

            background:
                #FBE6E6;

            color:
                #B74A4A;

            border:
                1px solid #F1D2D2;
        }


        .status-inactive .status-dot {

            background:
                #B74A4A;
        }


        /* =====================================================
           ID COPY
           ===================================================== */

        .id-value {

            display: flex;

            align-items: center;

            justify-content: flex-end;

            gap: 7px;
        }


        .copy-id-button {

            width: 28px;
            height: 28px;

            padding: 0;

            border:
                1px solid #DED8CC;

            border-radius: 7px;

            background:
                #FFFDF8;

            color:
                #59655D;

            display: flex;

            align-items: center;
            justify-content: center;

            transition:
                background .2s ease,
                color .2s ease,
                border-color .2s ease;
        }


        .copy-id-button:hover {

            background:
                var(--green-soft);

            border-color:
                #D4E2D5;

            color:
                var(--green);
        }


        .copy-id-button i {

            font-size: 12px;
        }


        /* =====================================================
           ACTION PANEL
           ===================================================== */

        .category-actions-card {

            margin-top: 17px;

            padding:
                20px
                21px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            background:
                var(--white);

            border:
                1px solid var(--border);

            border-radius: 12px;

            box-shadow:
                0 5px 20px
                rgba(27,82,51,.035);
        }


        .actions-title {

            margin: 0;

            color:
                var(--green);

            font-size: 13px;

            font-weight: 800;
        }


        .actions-description {

            margin-top: 4px;

            color:
                var(--muted);

            font-size: 9px;
        }


        .actions-buttons {

            display: flex;

            align-items: center;

            gap: 8px;
        }


        .action-button {

            height: 38px;

            padding:
                0
                15px;

            border-radius: 8px;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            font-size: 10px;

            font-weight: 600;

            transition:
                background .2s ease,
                border-color .2s ease,
                color .2s ease,
                transform .2s ease;
        }


        .action-button:hover {

            transform:
                translateY(-1px);
        }


        .edit-button {

            border:
                1px solid #C99B25;

            background:
                var(--gold-soft);

            color:
                #806A27;

            min-width: 112px;
        }


        .edit-button:hover {

            background:
                #F4E6B7;

            border-color:
                #B98B18;

            color:
                #755A18;
        }


        .deactivate-button {

            border:
                1px solid #E5CACA;

            background:
                var(--danger-soft);

            color:
                var(--danger);

            min-width: 145px;
        }


        .deactivate-button:hover {

            background:
                #FBE2E2;

            border-color:
                #DDB7B7;

            color:
                #B54444;
        }


        .deactivate-button:disabled {

            opacity: .55;

            cursor: not-allowed;

            transform: none;
        }

.restore-button {
    border: 1px solid #C9DCCB;
    background: var(--green-soft);
    color: var(--green);
    min-width: 145px;
}

.restore-button:hover {
    background: #DDEBDD;
    border-color: #B7CFBA;
    color: var(--green-dark);
}

.restore-button:disabled {
    opacity: .55;
    cursor: not-allowed;
    transform: none;
}




        /* =====================================================
           PAGE STATES
           ===================================================== */

        .page-state {

            min-height: 430px;

            padding:
                70px
                20px;

            display: flex;

            align-items: center;

            justify-content: center;

            flex-direction: column;

            text-align: center;

            background:
                var(--white);

            border:
                1px solid var(--border);

            border-radius: 14px;

            box-shadow:
                0 7px 25px
                rgba(27,82,51,.045);
        }


        .page-state-icon {

            width: 58px;
            height: 58px;

            margin-bottom: 15px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                var(--green-soft);

            color:
                var(--green);

            font-size: 23px;
        }


        .page-state.error .page-state-icon {

            background:
                var(--danger-soft);

            color:
                var(--danger);
        }


        .page-state h3 {

            margin:
                0 0 6px;

            color:
                var(--green);

            font-size: 17px;

            font-weight: 800;
        }


        .page-state p {

            max-width: 390px;

            margin:
                0
                auto
                18px;

            color:
                var(--muted);

            font-size: 10px;

            line-height: 1.6;
        }


        .state-button {

            height: 37px;

            padding:
                0
                16px;

            border:
                0;

            border-radius: 8px;

            background:
                var(--green);

            color:
                #fff;

            font-size: 10px;

            font-weight: 600;
        }


        .state-button:hover {

            background:
                var(--green-dark);
        }


        .loading-spinner {

            width: 27px;
            height: 27px;

            margin-bottom: 14px;

            border:
                2px solid #E4DDD1;

            border-top-color:
                var(--green);

            border-radius: 50%;

            animation:
                categorySpin .7s linear infinite;
        }


        @keyframes categorySpin {

            to {
                transform:
                    rotate(360deg);
            }
        }


        /* =====================================================
           CONFIRMATION MODAL
           Same system as Categories page
           ===================================================== */

        .confirmation-modal {

            position: fixed;

            inset: 0;

            z-index: 3000;

            display: none;

            align-items: center;

            justify-content: center;

            padding: 20px;

            background:
                rgba(27,82,51,.27);

            backdrop-filter:
                blur(5px);

            -webkit-backdrop-filter:
                blur(5px);
        }


        .confirmation-modal.show {

            display: flex;
        }


        .confirmation-box {

            width: 100%;

            max-width: 365px;

            padding:
                30px
                26px
                23px;

            background:
                var(--white);

            border:
                1px solid var(--border);

            border-radius: 14px;

            text-align: center;

            box-shadow:
                0 25px 65px
                rgba(27,82,51,.18);

            animation:
                categoryModalShow
                .18s ease-out;
        }


        .confirmation-icon {

            width: 52px;
            height: 52px;

            margin:
                0
                auto
                15px;

            border-radius: 50%;

            background:
                var(--danger-soft);

            color:
                var(--danger);

            display: flex;

            align-items: center;
            justify-content: center;

            font-size: 19px;
        }


        .confirmation-title {

            margin: 0;

            color:
                var(--green);

            font-size: 19px;

            font-weight: 800;
        }


        .confirmation-message {

            margin:
                8px
                auto
                22px;

            max-width: 290px;

            color:
                var(--muted);

            font-size: 11px;

            line-height: 1.6;
        }


        .confirmation-actions {

            display: flex;

            justify-content: center;

            gap: 9px;
        }


        .confirmation-button {

            min-width: 108px;

            height: 39px;

            border-radius: 7px;

            font-size: 11px;

            font-weight: 600;

            cursor: pointer;

            transition: .2s ease;
        }


        .confirmation-button:disabled {

            opacity: .5;

            cursor: not-allowed;
        }


        .confirmation-cancel {

            border:
                1px solid var(--border);

            background:
                #fff;

            color:
                var(--text);
        }


        .confirmation-cancel:hover {

            background:
                var(--cream-dark);
        }


        .confirmation-confirm {

            border:
                1px solid var(--danger);

            background:
                var(--danger);

            color:
                #fff;
        }


        .confirmation-confirm:hover {

            background:
                #B54444;
        }


        @keyframes categoryModalShow {

            from {

                opacity: 0;

                transform:
                    translateY(8px)
                    scale(.98);
            }

            to {

                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);
            }
        }


        /* =====================================================
           TOAST
           ===================================================== */

        .category-toast {

            position: fixed;

            right: 25px;
            bottom: 25px;

            z-index: 4000;

            min-width: 280px;
            max-width: 380px;

            padding:
                13px
                16px;

            border-radius: 9px;

            background:
                var(--green);

            color:
                #fff;

            box-shadow:
                0 12px 35px
                rgba(20,48,31,.22);

            display: none;

            font-size: 11px;
        }


        .category-toast.show {

            display: block;

            animation:
                categoryToastIn
                .25s ease;
        }


        .category-toast.error {

            background:
                #8F5555;
        }


        @keyframes categoryToastIn {

            from {

                opacity: 0;

                transform:
                    translateY(10px);
            }

            to {

                opacity: 1;

                transform:
                    translateY(0);
            }
        }


        /* =====================================================
           RESPONSIVE
           ===================================================== */

        @media (max-width: 1000px) {

            .category-details-card {

                grid-template-columns:
                    1fr;
            }


            .category-image-panel {

                min-height: 390px;

                border-right: 0;

                border-bottom:
                    1px solid #EEE9DF;
            }
        }


        @media (max-width: 900px) {

            .admin-main {

                margin-left: 78px;

                width:
                    calc(100% - 78px);
            }


            .category-details-content {

                padding:
                    27px
                    20px
                    35px;
            }
        }


        @media (max-width: 650px) {

            .admin-main {

                margin-left: 65px;

                width:
                    calc(100% - 65px);
            }


            .category-details-content {

                padding:
                    20px
                    12px
                    30px;
            }


            .category-page-heading {

                font-size: 25px;
            }


            .category-page-subtitle {

                font-size: 11px;
            }


            .category-hero {

                text-align: left;
            }


            .category-page-subtitle {

                margin-left: 0;
            }


            .hero-decoration {

                justify-content: flex-start;
            }


            .category-top-actions {

                align-items: flex-start;

                flex-direction: column;

                gap: 12px;
            }


            .top-action-group {

                width: 100%;
            }


            .top-action-button {

                flex: 1;
            }


            .category-image-panel {

                padding: 18px;

                min-height: 300px;
            }


            .category-information-panel {

                padding:
                    23px
                    19px;
            }


            .detail-row {

                align-items: flex-start;

                flex-direction: column;

                gap: 6px;
            }


            .detail-value {

                max-width: 100%;

                text-align: left;
            }


            .id-value {

                justify-content: flex-start;
            }


            .category-actions-card {

                align-items: flex-start;

                flex-direction: column;
            }


            .actions-buttons {

                width: 100%;

                flex-direction: column;
            }


            .action-button {

                width: 100%;
            }


            .category-toast {

                right: 15px;

                left: 15px;

                min-width: 0;
            }
        }

    </style>

</head>


<body>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <%- include("partials/sidebar", {
        activePage: "categories"
    }) %>


    <!-- =====================================================
         MAIN
         ===================================================== -->

    <main class="admin-main">


        <!-- =================================================
             HEADER
             ================================================= -->

        <%- include("partials/header", {
            pageTitle: "Category Details",
            showSearch: false,
            admin: admin
        }) %>


        <!-- =================================================
             BOTANICAL DECORATIONS
             ================================================= -->

        <div class="category-leaf category-leaf-right"></div>

        <div class="category-leaf category-leaf-left"></div>

        <div class="category-leaf category-leaf-small"></div>


        <!-- =================================================
             CONTENT
             ================================================= -->

        <section class="category-details-content">


            <!-- =================================================
                 HERO
                 ================================================= -->

            <div class="category-hero">

                <div class="category-eyebrow">
                    Naadan Box Collection
                </div>


                <h2 class="category-page-heading">
                    Category Details
                </h2>


                <p class="category-page-subtitle">
                    View the details and current status of this
                    Naadan Box category.
                </p>


                <div class="hero-decoration">

                    <span></span>

                </div>

            </div>


            <!-- =================================================
                 TOP ACTIONS
                 ================================================= -->

            <div class="category-top-actions">

                <div class="category-intro-note">
                    Category Information
                </div>


                <div class="top-action-group">

                    <a
                        href="/admin/categories"
                        class="top-action-button"
                    >

                        <i class="bi bi-arrow-left"></i>

                        Back to Categories

                    </a>


                    <a
                        href="#"
                        class="top-action-button edit-action"
                        id="topEditButton"
                    >

                        <i class="bi bi-pencil"></i>

                        Edit Category

                    </a>

                </div>

            </div>


            <!-- =================================================
                 LOADING STATE
                 ================================================= -->

            <div
                class="page-state"
                id="loadingState"
            >

                <div class="loading-spinner"></div>

                <h3>
                    Loading category
                </h3>

                <p>
                    Fetching the latest category information.
                </p>

            </div>


            <!-- =================================================
                 ERROR STATE
                 ================================================= -->

            <div
                class="page-state error"
                id="errorState"
                style="display:none;"
            >

                <div class="page-state-icon">

                    <i class="bi bi-exclamation-triangle"></i>

                </div>


                <h3 id="errorTitle">
                    Unable to load category
                </h3>


                <p id="errorMessage">
                    Something went wrong while loading this category.
                </p>


                <button
                    type="button"
                    class="state-button"
                    id="retryButton"
                >

                    Try Again

                </button>

            </div>


            <!-- =================================================
                 CATEGORY DETAILS
                 ================================================= -->

            <div
                id="categoryContent"
                style="display:none;"
            >


                <div class="category-details-card">


                    <!-- IMAGE -->

                    <div class="category-image-panel">

                        <div class="category-image-frame">

                            <img
                                id="categoryImage"
                                class="category-image"
                                src=""
                                alt=""
                            >


                            <div
                                class="image-placeholder"
                                id="imagePlaceholder"
                            >

                                <i class="bi bi-image"></i>

                                <span>
                                    Category image unavailable
                                </span>

                            </div>


                            <div
                                class="image-label"
                                id="imageLabel"
                            >
                                Category Image
                            </div>

                        </div>

                    </div>


                    <!-- INFORMATION -->

                    <div class="category-information-panel">


                        <div class="information-heading">

                            <div class="information-mark">

                                <i class="bi bi-diagram-3"></i>

                            </div>


                            <div>

                                <h3 class="information-title">
                                    Category Information
                                </h3>

                                <div class="information-subtitle">
                                    Current details stored in Naadan Box
                                </div>

                            </div>

                        </div>


                        <div class="details-list">


                            <!-- NAME -->

                            <div class="detail-row">

                                <div class="detail-label">
                                    Category Name
                                </div>

                                <div
                                    class="detail-value primary"
                                    id="categoryName"
                                >
                                    -
                                </div>

                            </div>


                            <!-- STATUS -->

                            <div class="detail-row">

                                <div class="detail-label">
                                    Status
                                </div>

                                <div
                                    class="detail-value"
                                    id="categoryStatus"
                                >
                                    -
                                </div>

                            </div>


                            <!-- SLUG -->

                            <div class="detail-row">

                                <div class="detail-label">
                                    Slug
                                </div>

                                <div
                                    class="detail-value muted"
                                    id="categorySlug"
                                >
                                    -
                                </div>

                            </div>


                            <!-- ID -->

                            <div class="detail-row">

                                <div class="detail-label">
                                    Category ID
                                </div>

                                <div class="detail-value">

                                    <div class="id-value">

                                        <span
                                            id="categoryId"
                                            class="detail-value muted"
                                        >
                                            -
                                        </span>


                                        <button
                                            type="button"
                                            class="copy-id-button"
                                            id="copyIdButton"
                                            title="Copy category ID"
                                            aria-label="Copy category ID"
                                        >

                                            <i class="bi bi-copy"></i>

                                        </button>

                                    </div>

                                </div>

                            </div>


                            <!-- CREATED -->

                            <div class="detail-row">

                                <div class="detail-label">
                                    Created
                                </div>

                                <div
                                    class="detail-value muted"
                                    id="categoryCreated"
                                >
                                    -
                                </div>

                            </div>


                            <!-- UPDATED -->

                            <div class="detail-row">

                                <div class="detail-label">
                                    Last Updated
                                </div>

                                <div
                                    class="detail-value muted"
                                    id="categoryUpdated"
                                >
                                    -
                                </div>

                            </div>


                        </div>

                    </div>

                </div>


                <!-- =================================================
                     ACTION CARD
                     ================================================= -->

                <div class="category-actions-card">


                    <div>

                        <h3 class="actions-title">
                            Category Actions
                        </h3>

                        <div
                            class="actions-description"
                            id="actionsDescription"
                        >
                            Manage this category from here.

                        </div>

                    </div>


                    <div class="actions-buttons">


                        <a
                            href="#"
                            class="action-button edit-button"
                            id="editButton"
                        >

                            <i class="bi bi-pencil"></i>

                            Edit Category

                        </a>


                        <button
                            type="button"
                            class="action-button deactivate-button"
                            id="deactivateButton"
                        >

                            <i class="bi bi-slash-circle"></i>

                            Deactivate Category

                        </button>

                        <button
    type="button"
    class="action-button restore-button"
    id="restoreButton"
    style="display: none;"
>
    <i class="bi bi-arrow-counterclockwise"></i>
    Restore Category
</button>

                    </div>

                </div>

            </div>


        </section>

    </main>


    <!-- =====================================================
         DEACTIVATE MODAL
         ===================================================== -->

    <div
        class="confirmation-modal"
        id="deactivateModal"
        aria-hidden="true"
    >

        <div
            class="confirmation-box"
            role="dialog"
            aria-modal="true"
            aria-labelledby="confirmationTitle"
        >

            <div class="confirmation-icon">

                <i class="bi bi-exclamation-triangle"></i>

            </div>


            <h2
                class="confirmation-title"
                id="confirmationTitle"
            >
                Deactivate Category?
            </h2>


            <p
                class="confirmation-message"
                id="confirmationMessage"
            >
                This category will no longer be available to customers.
                Existing data will be preserved.
            </p>


            <div class="confirmation-actions">

                <button
                    type="button"
                    class="confirmation-button confirmation-cancel"
                    id="cancelDeactivate"
                >
                    Cancel
                </button>


                <button
                    type="button"
                    class="confirmation-button confirmation-confirm"
                    id="confirmDeactivate"
                >
                    Deactivate
                </button>

            </div>

        </div>

    </div>


    <!-- =====================================================
         TOAST
         Used only for success / unexpected system errors
         ===================================================== -->

    <div
        class="category-toast"
        id="toast"
        role="status"
        aria-live="polite"
    ></div>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script>

        /* =====================================================
           CATEGORY ID
           ===================================================== */

        const pathParts =
            window.location.pathname
                .split("/")
                .filter(Boolean);

        const categoryId =
            pathParts[
                pathParts.indexOf("categories") + 1
            ];


        /* =====================================================
           ELEMENTS
           ===================================================== */

        const loadingState =
            document.getElementById(
                "loadingState"
            );

        const errorState =
            document.getElementById(
                "errorState"
            );

        const errorTitle =
            document.getElementById(
                "errorTitle"
            );

        const errorMessage =
            document.getElementById(
                "errorMessage"
            );

        const retryButton =
            document.getElementById(
                "retryButton"
            );

        const categoryContent =
            document.getElementById(
                "categoryContent"
            );

        const categoryImage =
            document.getElementById(
                "categoryImage"
            );

        const imagePlaceholder =
            document.getElementById(
                "imagePlaceholder"
            );

        const categoryName =
            document.getElementById(
                "categoryName"
            );

        const categoryStatus =
            document.getElementById(
                "categoryStatus"
            );

        const categorySlug =
            document.getElementById(
                "categorySlug"
            );

        const categoryIdElement =
            document.getElementById(
                "categoryId"
            );

        const categoryCreated =
            document.getElementById(
                "categoryCreated"
            );

        const categoryUpdated =
            document.getElementById(
                "categoryUpdated"
            );

        const copyIdButton =
            document.getElementById(
                "copyIdButton"
            );

        const editButton =
            document.getElementById(
                "editButton"
            );

        const topEditButton =
            document.getElementById(
                "topEditButton"
            );

        const deactivateButton =
            document.getElementById(
                "deactivateButton"
            );
            const restoreButton =
    document.getElementById(
        "restoreButton"
    );

        const actionsDescription =
            document.getElementById(
                "actionsDescription"
            );

        const deactivateModal =
            document.getElementById(
                "deactivateModal"
            );

        const cancelDeactivate =
            document.getElementById(
                "cancelDeactivate"
            );

        const confirmDeactivate =
            document.getElementById(
                "confirmDeactivate"
            );

        const confirmationMessage =
            document.getElementById(
                "confirmationMessage"
            );

        const toast =
            document.getElementById(
                "toast"
            );


        /* =====================================================
           STATE
           ===================================================== */

       let categoryData = null;

let isDeactivating = false;

let isRestoring = false;

let toastTimeout = null;


        /* =====================================================
           ESCAPE HTML
           ===================================================== */

        function escapeHtml(value) {

            if (
                value === null ||
                value === undefined
            ) {
                return "";
            }

            return String(value)

                .replace(
                    /&/g,
                    "&amp;"
                )

                .replace(
                    /</g,
                    "&lt;"
                )

                .replace(
                    />/g,
                    "&gt;"
                )

                .replace(
                    /"/g,
                    "&quot;"
                )

                .replace(
                    /'/g,
                    "&#039;"
                );
        }


        /* =====================================================
           IMAGE URL
           ===================================================== */

        function getImageUrl(image) {

            if (!image) {
                return null;
            }


            if (
                image.startsWith("http://") ||
                image.startsWith("https://") ||
                image.startsWith("/")
            ) {
                return image;
            }


            return `/${image.replace(/^\/+/, "")}`;
        }


        /* =====================================================
           FORMAT DATE
           ===================================================== */

        function formatDate(dateValue) {

            if (!dateValue) {
                return "-";
            }


            const date =
                new Date(dateValue);


            if (
                Number.isNaN(
                    date.getTime()
                )
            ) {
                return "-";
            }


            return date.toLocaleString(
                "en-IN",
                {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: true
                }
            );
        }


        /* =====================================================
           SHOW TOAST
           ===================================================== */

        function showToast(
            message,
            isError = false
        ) {

            clearTimeout(
                toastTimeout
            );


            toast.textContent =
                message;


            toast.classList.toggle(
                "error",
                isError
            );


            toast.classList.add(
                "show"
            );


            toastTimeout =
                setTimeout(
                    () => {

                        toast.classList.remove(
                            "show"
                        );

                    },
                    3000
                );
        }


        /* =====================================================
           SHOW LOADING
           ===================================================== */

        function showLoading() {

            loadingState.style.display =
                "flex";

            errorState.style.display =
                "none";

            categoryContent.style.display =
                "none";
        }


        /* =====================================================
           SHOW ERROR
           ===================================================== */

        function showError(
            title,
            message
        ) {

            loadingState.style.display =
                "none";

            categoryContent.style.display =
                "none";

            errorState.style.display =
                "flex";

            errorTitle.textContent =
                title;

            errorMessage.textContent =
                message;
        }


        /* =====================================================
           SHOW CONTENT
           ===================================================== */

        function showContent() {

            loadingState.style.display =
                "none";

            errorState.style.display =
                "none";

            categoryContent.style.display =
                "block";
        }


        /* =====================================================
           RENDER IMAGE
           ===================================================== */

        function renderImage(
            image,
            name
        ) {

            const imageUrl =
                getImageUrl(image);


            imagePlaceholder.style.display =
                "none";

            categoryImage.style.display =
                "block";


            if (!imageUrl) {

                categoryImage.style.display =
                    "none";

                imagePlaceholder.style.display =
                    "flex";

                return;
            }


            categoryImage.src =
                imageUrl;

            categoryImage.alt =
                `Image of ${name || "category"}`;
        }


        categoryImage.addEventListener(
            "error",
            () => {

                categoryImage.style.display =
                    "none";

                imagePlaceholder.style.display =
                    "flex";
            }
        );


        /* =====================================================
           RENDER STATUS
           ===================================================== */

        function renderStatus(
            isActive
        ) {

            categoryStatus.innerHTML =
                isActive

                    ? `
                        <span
                            class="status-badge status-active"
                        >
                            <span class="status-dot"></span>
                            Active
                        </span>
                    `

                    : `
                        <span
                            class="status-badge status-inactive"
                        >
                            <span class="status-dot"></span>
                            Inactive
                        </span>
                    `;
        }


        /* =====================================================
           RENDER CATEGORY
           ===================================================== */

        function renderCategory(
            category
        ) {

            categoryData =
                category;


            const name =
                category.name || "-";


            categoryName.textContent =
                name;


            categorySlug.textContent =
                category.slug
                    ? `/${category.slug}`
                    : "-";


            categoryIdElement.textContent =
                category._id || "-";


            categoryCreated.textContent =
                formatDate(
                    category.createdAt
                );


            categoryUpdated.textContent =
                formatDate(
                    category.updatedAt
                );


            renderImage(
                category.image,
                name
            );


            renderStatus(
                Boolean(category.isActive)
            );


            const editUrl =
                `/admin/categories/${encodeURIComponent(category._id)}/edit`;


            editButton.href =
                editUrl;

            topEditButton.href =
                editUrl;


           if (category.isActive) {

    deactivateButton.disabled = false;
    deactivateButton.style.display = "flex";

    restoreButton.disabled = false;
    restoreButton.style.display = "none";

    actionsDescription.textContent =
        "Edit the category or deactivate it when it should no longer be available.";

} else {

    deactivateButton.style.display = "none";

    restoreButton.disabled = false;
    restoreButton.style.display = "flex";

    actionsDescription.textContent =
        "This category is inactive. Existing category data has been preserved.";

}


            showContent();
        }


        /* =====================================================
           LOAD CATEGORY
           ===================================================== */

        async function loadCategory() {

            if (!categoryId) {

                showError(
                    "Invalid category",
                    "The category ID is missing from this page."
                );

                return;
            }


            showLoading();


            try {

                const response =
                    await fetch(
                        `/api/admin/categories/${encodeURIComponent(categoryId)}`,
                        {
                            headers: {
                                "Accept":
                                    "application/json"
                            }
                        }
                    );


                const contentType =
                    response.headers.get(
                        "content-type"
                    ) || "";


                if (
                    !contentType.includes(
                        "application/json"
                    )
                ) {

                    throw new Error(
                        "Unexpected server response."
                    );
                }


                const result =
                    await response.json();


                if (
                    !response.ok ||
                    !result.success
                ) {

                    const message =
                        result.message ||
                        "Unable to load category.";


                    if (
                        response.status === 404 ||
                        message
                            .toLowerCase()
                            .includes("not found")
                    ) {

                        showError(
                            "Category not found",
                            "The category may have been deleted or the link may no longer be valid."
                        );

                        return;
                    }


                    throw new Error(
                        message
                    );
                }


                const category =
                    result.data;


                if (
                    !category ||
                    !category._id
                ) {

                    throw new Error(
                        "Invalid category data received from server."
                    );
                }


                renderCategory(
                    category
                );


            } catch (error) {

                console.error(
                    "Load category error:",
                    error
                );


                showError(
                    "Unable to load category",
                    error.message ||
                    "Something went wrong while loading this category."
                );
            }
        }


        /* =====================================================
           COPY CATEGORY ID
           ===================================================== */

        copyIdButton.addEventListener(
            "click",
            async () => {

                if (
                    !categoryData ||
                    !categoryData._id
                ) {
                    return;
                }


                try {

                    await navigator.clipboard.writeText(
                        String(categoryData._id)
                    );


                    showToast(
                        "Category ID copied."
                    );


                } catch (error) {

                    console.error(
                        "Copy ID error:",
                        error
                    );


                    showToast(
                        "Unable to copy category ID.",
                        true
                    );
                }
            }
        );


        /* =====================================================
           DEACTIVATE MODAL
           ===================================================== */

        function openDeactivateModal() {

            if (
                !categoryData ||
                !categoryData.isActive ||
                isDeactivating
            ) {
                return;
            }


            confirmationMessage.textContent =
                `Are you sure you want to deactivate "${categoryData.name}"? The category will no longer be active, but its existing data will be preserved.`;


            deactivateModal.classList.add(
                "show"
            );


            deactivateModal.setAttribute(
                "aria-hidden",
                "false"
            );


            requestAnimationFrame(
                () => {
                    confirmDeactivate.focus();
                }
            );
        }


        function closeDeactivateModal() {

            if (isDeactivating) {
                return;
            }


            deactivateModal.classList.remove(
                "show"
            );


            deactivateModal.setAttribute(
                "aria-hidden",
                "true"
            );
        }


        deactivateButton.addEventListener(
            "click",
            openDeactivateModal
        );


        cancelDeactivate.addEventListener(
            "click",
            closeDeactivateModal
        );


        deactivateModal.addEventListener(
            "click",
            event => {

                if (
                    event.target ===
                    deactivateModal
                ) {

                    closeDeactivateModal();
                }
            }
        );


        document.addEventListener(
            "keydown",
            event => {

                if (
                    event.key === "Escape" &&
                    deactivateModal.classList.contains(
                        "show"
                    )
                ) {

                    closeDeactivateModal();
                }
            }
        );


        /* =====================================================
           DEACTIVATE CATEGORY
           ===================================================== */

        confirmDeactivate.addEventListener(
            "click",
            async () => {

                if (
                    !categoryData ||
                    !categoryData._id ||
                    !categoryData.isActive ||
                    isDeactivating
                ) {
                    return;
                }


                isDeactivating =
                    true;


                confirmDeactivate.disabled =
                    true;

                cancelDeactivate.disabled =
                    true;

                confirmDeactivate.textContent =
                    "Deactivating...";


                try {

                    const response =
                        await fetch(
                            `/api/admin/categories/${encodeURIComponent(categoryData._id)}/deactivate`,
                            {
                                method: "PATCH",

                                headers: {
                                    "Accept":
                                        "application/json"
                                }
                            }
                        );


                    const contentType =
                        response.headers.get(
                            "content-type"
                        ) || "";


                    if (
                        !contentType.includes(
                            "application/json"
                        )
                    ) {

                        throw new Error(
                            "Unexpected server response."
                        );
                    }


                    const result =
                        await response.json();


                    if (
                        !response.ok ||
                        !result.success
                    ) {

                        throw new Error(
                            result.message ||
                            "Unable to deactivate category."
                        );
                    }


                    categoryData =
                        result.data ||
                        {
                            ...categoryData,
                            isActive: false
                        };


                    renderCategory(
                        categoryData
                    );


                    closeDeactivateModal();


                    showToast(
                        "Category deactivated successfully."
                    );


                } catch (error) {

                    console.error(
                        "Deactivate category error:",
                        error
                    );


                    showToast(
                        error.message ||
                        "Unable to deactivate category.",
                        true
                    );


                } finally {

                    isDeactivating =
                        false;

                    confirmDeactivate.disabled =
                        false;

                    cancelDeactivate.disabled =
                        false;

                    confirmDeactivate.textContent =
                        "Deactivate";
                }
            }
        );

// RESTORE CATEGORY

restoreButton.addEventListener(
    "click",
    async () => {

        if (
            !categoryData ||
            !categoryData._id ||
            categoryData.isActive ||
            isRestoring
        ) {
            return;
        }

        isRestoring = true;

        restoreButton.disabled = true;
        restoreButton.innerHTML = `
            <i class="bi bi-arrow-repeat"></i>
            Restoring...
        `;

        try {

            const response =
                await fetch(
                    `/api/admin/categories/${encodeURIComponent(categoryData._id)}/restore`,
                    {
                        method: "PATCH",

                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );

            const contentType =
                response.headers.get("content-type") || "";

            if (
                !contentType.includes("application/json")
            ) {
                throw new Error(
                    "Unexpected server response."
                );
            }

            const result =
                await response.json();

            if (
                !response.ok ||
                !result.success
            ) {
                throw new Error(
                    result.message ||
                    "Unable to restore category."
                );
            }

            categoryData =
                result.data ||
                {
                    ...categoryData,
                    isActive: true
                };

            renderCategory(categoryData);

            showToast(
                "Category restored successfully."
            );

        } catch (error) {

            console.error(
                "Restore category error:",
                error
            );

            showToast(
                error.message ||
                "Unable to restore category.",
                true
            );

        } finally {

            isRestoring = false;

            restoreButton.disabled = false;

            restoreButton.innerHTML = `
                <i class="bi bi-arrow-counterclockwise"></i>
                Restore Category
            `;
        }
    }
);



        /* =====================================================
           RETRY
           ===================================================== */

        retryButton.addEventListener(
            "click",
            loadCategory
        );


        /* =====================================================
           INITIAL LOAD
           ===================================================== */

        document.addEventListener(
            "DOMContentLoaded",
            () => {

                loadCategory();

            }
        );

    </script>


