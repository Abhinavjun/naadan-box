<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Edit Category - Naadan Box</title>


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

         <link
    href="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.css"
    rel="stylesheet"
>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
        rel="stylesheet"
    >


    <!-- =====================================================
         NAADAN BOX - EDIT CATEGORY
         ===================================================== -->

    <style>

        /* =====================================================
           ROOT
           ===================================================== */

        :root {

            --green: #1B5233;
            --green-dark: #16452B;
            --green-soft: #EDF4ED;

            --gold: #C99B25;
            --gold-soft: #F8EFCF;

            --cream: #F8F5ED;
            --cream-dark: #F1EDE3;

            --white: #FFFDF8;

            --text: #25372C;
            --muted: #7B857D;

            --border: #E5DFD2;

            --danger: #C95454;
            --danger-soft: #FFF0F0;

            --success: #34744A;
            --success-soft: #E2F2E5;
        }


        /* =====================================================
           GLOBAL
           ===================================================== */

        * {
            box-sizing: border-box;
        }


        html {
            overflow-y: scroll;
        }


        body {

            margin: 0;

            min-height: 100vh;

            background:
                var(--cream);

            color:
                var(--text);

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                "Helvetica Neue",
                Arial,
                sans-serif;
        }


        button,
        input {
            font: inherit;
        }


        button {
            cursor: pointer;
        }


        /* =====================================================
           MAIN ADMIN LAYOUT
           ===================================================== */

        .admin-main {

            position: relative;

            margin-left: 255px;

            width:
                calc(100% - 255px);

            min-height: 100vh;

            overflow: hidden;
        }


        /* =====================================================
           BOTANICAL BACKGROUND
           ===================================================== */

        .category-leaf {

            position: absolute;

            pointer-events: none;

            z-index: 0;
        }


        .category-leaf-right {

            width: 225px;
            height: 98px;

            right: -78px;
            top: 138px;

            background:
                rgba(213,216,199,.30);

            border-radius:
                100% 0 100% 0;

            transform:
                rotate(-34deg);
        }


        .category-leaf-right::after {

            content: "";

            position: absolute;

            width: 1px;
            height: 150px;

            left: 112px;
            top: -28px;

            background:
                rgba(190,181,145,.20);

            transform:
                rotate(-20deg);
        }


        .category-leaf-left {

            width: 170px;
            height: 72px;

            left: -88px;
            bottom: 70px;

            background:
                rgba(218,218,203,.22);

            border-radius:
                100% 0 100% 0;

            transform:
                rotate(43deg);
        }


        .category-leaf-left::after {

            content: "";

            position: absolute;

            width: 1px;
            height: 115px;

            left: 84px;
            top: -20px;

            background:
                rgba(190,181,145,.18);

            transform:
                rotate(-20deg);
        }


        .category-leaf-small {

            width: 100px;
            height: 42px;

            right: 105px;
            bottom: 24px;

            background:
                rgba(218,218,203,.16);

            border-radius:
                100% 0 100% 0;

            transform:
                rotate(28deg);
        }


        /* =====================================================
           CONTENT
           ===================================================== */

        .add-category-content {

            position: relative;

            z-index: 1;

            max-width: 1420px;

            margin: 0 auto;

            padding:
                30px
                38px
                55px;
        }


        /* =====================================================
           BREADCRUMB
           ===================================================== */

        .category-breadcrumb {

            display: flex;

            align-items: center;

            gap: 7px;

            margin-bottom: 18px;

            font-size: 10px;

            color:
                var(--muted);
        }


        .category-breadcrumb a {

            color:
                var(--green);

            text-decoration: none;

            font-weight: 600;

            transition:
                color .2s ease;
        }


        .category-breadcrumb a:hover {

            color:
                var(--gold);
        }


        .category-breadcrumb i {

            color:
                #B7B4AA;

            font-size: 8px;
        }


        /* =====================================================
           HERO
           ===================================================== */

        .category-hero {

            text-align: center;

            margin-bottom: 28px;
        }


        .category-eyebrow {

            margin-bottom: 7px;

            color:
                var(--gold);

            font-size: 8px;

            font-weight: 700;

            letter-spacing: 3px;

            text-transform: uppercase;
        }


        .category-page-heading {

            margin: 0;

            color:
                var(--green);

            font-size: 31px;

            font-weight: 800;

            letter-spacing: -.8px;
        }


        .category-page-subtitle {

            max-width: 560px;

            margin:
                8px auto 0;

            color:
                var(--muted);

            font-size: 11px;

            line-height: 1.7;
        }


        /* =====================================================
           HERO DECORATION
           ===================================================== */

        .hero-decoration {

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            margin-top: 13px;
        }


        .hero-decoration::before {

            content: "";

            width: 38px;
            height: 2px;

            background:
                var(--gold);

            border-radius: 10px;
        }


        .hero-decoration span {

            width: 5px;
            height: 5px;

            background:
                var(--gold);

            transform:
                rotate(45deg);
        }


        .hero-decoration::after {

            content: "";

            width: 38px;
            height: 1px;

            background:
                #D9CDA9;

            border-radius: 10px;
        }


        /* =====================================================
           MAIN WORKSPACE
           ===================================================== */

        .category-workspace {

            display: grid;

            grid-template-columns:
                minmax(0, 1.25fr)
                minmax(330px, .75fr);

            gap: 18px;

            align-items: stretch;
        }


        /* =====================================================
           FORM WORKSPACE
           ===================================================== */

        .category-form-card {

            position: relative;

            overflow: hidden;

            background:
                var(--white);

            border:
                1px solid var(--border);

            border-radius: 16px;

            box-shadow:
                0 12px 35px
                rgba(27,82,51,.055);
        }


        .category-form-card::before {

            content: "";

            position: absolute;

            top: 0;
            left: 26px;

            width: 48px;
            height: 3px;

            background:
                var(--gold);

            border-radius:
                0 0 5px 5px;
        }


        /* =====================================================
           FORM HEADER
           ===================================================== */

        .form-header {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            padding:
                21px
                25px;

            border-bottom:
                1px solid #EEE9DF;

            background:
                linear-gradient(
                    110deg,
                    #FFFDF8,
                    #FCFAF4
                );
        }


        .form-header-left {

            display: flex;

            align-items: center;

            gap: 12px;
        }


        .form-header-icon {

            width: 40px;
            height: 40px;

            min-width: 40px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 10px;

            background:
                var(--green-soft);

            color:
                var(--green);

            font-size: 17px;
        }


        .form-header-title {

            margin: 0;

            color:
                var(--green);

            font-size: 16px;

            font-weight: 800;
        }


        .form-header-subtitle {

            margin-top: 3px;

            color:
                var(--muted);

            font-size: 8.5px;
        }


        .form-header-badge {

            display: inline-flex;

            align-items: center;

            gap: 6px;

            height: 25px;

            padding:
                0 9px;

            border:
                1px solid #D5E5D7;

            border-radius: 14px;

            background:
                #F4F9F4;

            color:
                var(--success);

            font-size: 8px;

            font-weight: 700;

            white-space: nowrap;
        }


        .form-header-badge i {

            font-size: 9px;
        }


        /* =====================================================
           FORM BODY
           ===================================================== */

        .category-form {

            padding:
                25px;
        }


        /* =====================================================
           NAME SECTION
           ===================================================== */

        .section-label {

            display: flex;

            align-items: center;

            gap: 7px;

            margin-bottom: 8px;

            color:
                var(--text);

            font-size: 9px;

            font-weight: 700;

            letter-spacing: .25px;

            text-transform: uppercase;
        }


        .section-label i {

            color:
                var(--gold);

            font-size: 11px;
        }


        .name-field {

            margin-bottom: 23px;
        }


        .name-input-wrapper {

            position: relative;
        }


        .category-input {

            width: 100%;

            height: 48px;

            padding:
                0 46px 0 15px;

            border:
                1px solid #DCD6CA;

            border-radius: 9px;

            outline: none;

            background:
                #FFFEFB;

            color:
                var(--text);

            font-size: 11px;

            transition:
                border-color .2s ease,
                background .2s ease,
                box-shadow .2s ease;
        }


        .category-input:hover {

            border-color:
                #D0C5B3;
        }


        .category-input:focus {

            border-color:
                #CDBB7C;

            background:
                #fff;

            box-shadow:
                0 0 0 3px
                rgba(201,155,37,.08);
        }


        .category-input.input-error {

            border-color:
                #D98B8B;

            box-shadow:
                0 0 0 3px
                rgba(201,84,84,.055);
        }


        .category-input.input-success {

            border-color:
                #A8C7AD;
        }


        .category-input::placeholder {

            color:
                #A2A69F;
        }


        .character-count {

            position: absolute;

            right: 14px;
            top: 50%;

            transform:
                translateY(-50%);

            color:
                #A0A59F;

            font-size: 8px;

            pointer-events: none;
        }


        .field-error {

            min-height: 15px;

            margin-top: 6px;

            color:
                var(--danger);

            font-size: 8.5px;

            line-height: 1.5;
        }


        /* =====================================================
           EDIT PAGE HELPERS
           ===================================================== */

        .current-image-note {
            display: flex;
            align-items: flex-start;
            gap: 7px;
            margin: 0 0 9px;
            color: var(--muted);
            font-size: 8px;
            line-height: 1.5;
        }

        .current-image-note i {
            color: var(--gold);
            font-size: 10px;
            margin-top: 1px;
        }

        .page-loading-overlay {
            position: fixed;
            inset: 0;
            z-index: 9000;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(248,245,237,.82);
            backdrop-filter: blur(4px);
        }

        .page-loading-overlay.hidden {
            display: none;
        }

        .page-loading-card {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 17px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--white);
            color: var(--green);
            font-size: 9px;
            font-weight: 700;
            box-shadow: 0 12px 35px rgba(27,82,51,.10);
        }

        .page-loading-spinner {
            width: 14px;
            height: 14px;
            border: 2px solid #DCE7DD;
            border-top-color: var(--green);
            border-radius: 50%;
            animation: submitSpin .7s linear infinite;
        }


        /* =====================================================
           IMAGE UPLOAD SECTION
           ===================================================== */

        .image-section {

            margin-top: 3px;
        }


        .image-upload-area {

            position: relative;

            min-height: 265px;

            border:
                1px dashed #D3CABB;

            border-radius: 12px;

            overflow: hidden;

            background:
                linear-gradient(
                    145deg,
                    #FCFAF5,
                    #F9F6EE
                );

            transition:
                border-color .25s ease,
                background .25s ease,
                box-shadow .25s ease;
        }


        .image-upload-area:hover {

            border-color:
                #CDBB7C;

            background:
                linear-gradient(
                    145deg,
                    #FEFCF7,
                    #FBF8EF
                );
        }


        .image-upload-area.dragover {

            border-color:
                var(--gold);

            background:
                linear-gradient(
                    145deg,
                    #FFFDF4,
                    #F8F0D5
                );

            box-shadow:
                0 0 0 4px
                rgba(201,155,37,.07);
        }


        .upload-content {

            min-height: 265px;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            padding: 25px;
        }


        .upload-symbol {

            position: relative;

            width: 62px;
            height: 62px;

            margin-bottom: 13px;

            display: flex;

            align-items: center;

            justify-content: center;

            border:
                1px solid #DCE7DD;

            border-radius: 17px;

            background:
                var(--green-soft);

            color:
                var(--green);

            font-size: 23px;

            box-shadow:
                0 7px 18px
                rgba(27,82,51,.055);
        }


        .upload-symbol::after {

            content: "";

            position: absolute;

            right: -5px;
            top: -5px;

            width: 13px;
            height: 13px;

            border-radius: 50%;

            background:
                var(--gold);

            box-shadow:
                0 0 0 3px
                #FCFAF5;
        }


        .upload-title {

            margin: 0;

            color:
                var(--green);

            font-size: 13px;

            font-weight: 800;
        }


        .upload-description {

            max-width: 340px;

            margin:
                6px auto 15px;

            text-align: center;

            color:
                var(--muted);

            font-size: 9px;

            line-height: 1.6;
        }


        .browse-button {

            height: 36px;

            padding:
                0 16px;

            border:
                1px solid #D8CDAE;

            border-radius: 8px;

            background:
                #FFFDF8;

            color:
                var(--green);

            font-size: 9.5px;

            font-weight: 700;

            box-shadow:
                0 4px 12px
                rgba(27,82,51,.035);

            transition:
                background .2s ease,
                border-color .2s ease,
                transform .2s ease,
                box-shadow .2s ease;
        }


        .browse-button:hover {

            background:
                var(--gold-soft);

            border-color:
                #DDC981;

            transform:
                translateY(-1px);

            box-shadow:
                0 7px 16px
                rgba(27,82,51,.06);
        }


        .upload-hint {

            margin-top: 12px;

            color:
                #9B9F98;

            font-size: 7.5px;

            letter-spacing: .1px;
        }


        #categoryImage {

            position: absolute;

            width: 1px;
            height: 1px;

            opacity: 0;

            pointer-events: none;
        }


        /* =====================================================
           IMAGE PREVIEW
           ===================================================== */

        .image-preview-wrapper {

            position: absolute;

            inset: 0;

            display: none;

            background:
                #F4F1E9;
        }


        .image-preview-wrapper.show {

            display: block;
        }


        .image-preview {

            width: 100%;
            height: 100%;

            object-fit: contain;

            padding: 12px;
        }


        .image-preview-overlay {

            position: absolute;

            left: 0;
            right: 0;
            bottom: 0;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            padding:
                28px 14px 13px;

            background:
                linear-gradient(
                    transparent,
                    rgba(22,69,43,.78)
                );
        }


        .image-preview-name {

            min-width: 0;

            overflow: hidden;

            color:
                #fff;

            font-size: 8.5px;

            text-overflow: ellipsis;

            white-space: nowrap;
        }


        .remove-image-button {

            width: 32px;
            height: 32px;

            min-width: 32px;

            display: flex;

            align-items: center;

            justify-content: center;

            border:
                1px solid
                rgba(255,255,255,.30);

            border-radius: 8px;

            background:
                rgba(255,255,255,.13);

            color:
                #fff;

            backdrop-filter:
                blur(6px);

            transition:
                background .2s ease,
                transform .2s ease;
        }


        .remove-image-button:hover {

            background:
                rgba(201,84,84,.85);

            transform:
                translateY(-1px);
        }


        .image-error {

            display: none;

            margin-top: 7px;

            color:
                var(--danger);

            font-size: 8.5px;

            line-height: 1.5;
        }


        /* =====================================================
           FORM FOOTER
           ===================================================== */

        .form-footer {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-top: 23px;

            padding-top: 19px;

            border-top:
                1px solid #EEE9DF;
        }


        .form-footer-note {

            display: flex;

            align-items: center;

            gap: 7px;

            color:
                var(--muted);

            font-size: 8px;
        }


        .form-footer-note i {

            color:
                var(--green);

            font-size: 11px;
        }


        .form-actions {

            display: flex;

            align-items: center;

            gap: 8px;
        }


        .form-button {

            height: 40px;

            padding:
                0 17px;

            border-radius: 8px;

            font-size: 9.5px;

            font-weight: 700;

            transition:
                background .2s ease,
                border-color .2s ease,
                color .2s ease,
                transform .2s ease,
                box-shadow .2s ease;
        }


        .cancel-button {

            border:
                1px solid #DCD6CA;

            background:
                #FFFDF8;

            color:
                #59655D;
        }


        .cancel-button:hover {

            background:
                var(--cream-dark);

            border-color:
                #CEC5B6;
        }


        .submit-button {

            border:
                1px solid var(--green);

            background:
                var(--green);

            color:
                #fff;

            box-shadow:
                0 6px 15px
                rgba(27,82,51,.13);
        }


        .submit-button:hover:not(:disabled) {

            background:
                var(--green-dark);

            border-color:
                var(--green-dark);

            transform:
                translateY(-1px);

            box-shadow:
                0 9px 21px
                rgba(27,82,51,.18);
        }


        .submit-button:disabled {

            opacity: .65;

            cursor: not-allowed;

            transform: none;

            box-shadow: none;
        }


        .submit-spinner {

            display: inline-block;

            width: 12px;
            height: 12px;

            margin-right: 7px;

            vertical-align: -2px;

            border:
                2px solid
                rgba(255,255,255,.35);

            border-top-color:
                #fff;

            border-radius: 50%;

            animation:
                submitSpin .7s linear infinite;
        }


        @keyframes submitSpin {

            to {
                transform:
                    rotate(360deg);
            }
        }


        /* =====================================================
           LIVE PREVIEW CARD
           ===================================================== */

        .preview-card {

            position: relative;

            overflow: hidden;

            background:
                var(--white);

            border:
                1px solid var(--border);

            border-radius: 16px;

            box-shadow:
                0 12px 35px
                rgba(27,82,51,.055);
        }


        .preview-card::before {

            content: "";

            position: absolute;

            top: 0;
            left: 23px;

            width: 42px;
            height: 3px;

            background:
                var(--gold);

            border-radius:
                0 0 5px 5px;
        }


        .preview-header {

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding:
                20px 22px 17px;

            border-bottom:
                1px solid #EEE9DF;

            background:
                linear-gradient(
                    90deg,
                    #FFFDF8,
                    #FBF9F3
                );
        }


        .preview-header-left {

            display: flex;

            align-items: center;

            gap: 10px;
        }


        .preview-header-icon {

            width: 34px;
            height: 34px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 9px;

            background:
                var(--gold-soft);

            color:
                #806A27;

            font-size: 14px;
        }


        .preview-header h2 {

            margin: 0;

            color:
                var(--green);

            font-size: 14px;

            font-weight: 800;
        }


        .preview-header p {

            margin:
                2px 0 0;

            color:
                var(--muted);

            font-size: 8px;
        }


        .preview-live {

            display: inline-flex;

            align-items: center;

            gap: 5px;

            color:
                var(--success);

            font-size: 7.5px;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: .5px;
        }


        .preview-live-dot {

            width: 6px;
            height: 6px;

            border-radius: 50%;

            background:
                #5C9667;

            box-shadow:
                0 0 0 3px
                rgba(92,150,103,.10);
        }


        /* =====================================================
           PREVIEW BODY
           ===================================================== */

        .preview-body {

            padding:
                20px;
        }


        .preview-label {

            margin-bottom: 9px;

            color:
                #7D847E;

            font-size: 7.5px;

            font-weight: 700;

            letter-spacing: 1px;

            text-transform: uppercase;
        }


        /* =====================================================
           STORE PREVIEW
           ===================================================== */

        .store-preview {

            overflow: hidden;

            border:
                1px solid #E3DDD1;

            border-radius: 12px;

            background:
                #fff;

            box-shadow:
                0 7px 22px
                rgba(27,82,51,.045);
        }


        .store-preview-image {

            position: relative;

            height: 245px;

            overflow: hidden;

            background:
                linear-gradient(
                    135deg,
                    #F3F0E7,
                    #ECE8DD
                );
        }


        .store-preview-image img {

            width: 100%;
            height: 100%;

            object-fit: cover;

            display: none;
        }


        .store-preview-image.has-image img {

            display: block;
        }


        .preview-placeholder {

            position: absolute;

            inset: 0;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            padding: 25px;

            text-align: center;
        }


        .store-preview-image.has-image
        .preview-placeholder {

            display: none;
        }


        .preview-placeholder-symbol {

            width: 55px;
            height: 55px;

            margin-bottom: 11px;

            display: flex;

            align-items: center;

            justify-content: center;

            border:
                1px solid #D8D5C9;

            border-radius: 15px;

            background:
                rgba(255,253,248,.72);

            color:
                #A6AAA2;

            font-size: 20px;
        }


        .preview-placeholder-title {

            margin: 0;

            color:
                #778078;

            font-size: 10px;

            font-weight: 700;
        }


        .preview-placeholder-text {

            max-width: 190px;

            margin:
                5px 0 0;

            color:
                #9B9F98;

            font-size: 7.5px;

            line-height: 1.5;
        }


        .preview-image-badge {

            position: absolute;

            top: 12px;
            left: 12px;

            display: inline-flex;

            align-items: center;

            gap: 5px;

            height: 23px;

            padding:
                0 8px;

            border-radius: 12px;

            background:
                rgba(255,253,248,.92);

            color:
                var(--green);

            font-size: 7px;

            font-weight: 700;

            box-shadow:
                0 4px 12px
                rgba(27,82,51,.08);

            backdrop-filter:
                blur(5px);
        }


        .preview-image-badge i {

            color:
                var(--gold);

            font-size: 8px;
        }


        /* =====================================================
           PREVIEW DETAILS
           ===================================================== */

        .store-preview-details {

            padding:
                17px 17px 18px;
        }


        .preview-category-label {

            color:
                var(--gold);

            font-size: 7px;

            font-weight: 700;

            letter-spacing: 1.3px;

            text-transform: uppercase;
        }


        .preview-category-name {

            margin:
                4px 0 8px;

            color:
                var(--green);

            font-size: 18px;

            font-weight: 800;

            line-height: 1.2;

            word-break: break-word;
        }


        .preview-category-name.placeholder {

            color:
                #B1B3AD;

            font-weight: 600;
        }


        .preview-status {

            display: inline-flex;

            align-items: center;

            gap: 6px;

            height: 24px;

            padding:
                0 9px;

            border:
                1px solid #D5E7D8;

            border-radius: 13px;

            background:
                var(--success-soft);

            color:
                var(--success);

            font-size: 7.5px;

            font-weight: 700;
        }


        .preview-status-dot {

            width: 5px;
            height: 5px;

            border-radius: 50%;

            background:
                #4B8A58;
        }


        /* =====================================================
           PREVIEW FOOTER
           ===================================================== */

        .preview-store-footer {

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 10px;

            margin-top: 16px;

            padding-top: 15px;

            border-top:
                1px solid #EEE9DF;
        }


        .preview-footer-note {

            color:
                var(--muted);

            font-size: 7.5px;

            line-height: 1.5;
        }


        .preview-footer-icon {

            width: 29px;
            height: 29px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 8px;

            background:
                var(--green-soft);

            color:
                var(--green);

            font-size: 12px;
        }


        /* =====================================================
           QUICK TIPS
           ===================================================== */

        .quick-tips {

            margin-top: 17px;

            padding:
                15px;

            border:
                1px solid #E8DFC3;

            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    #FFFDF7,
                    #F9F3DC
                );
        }


        .quick-tips-title {

            display: flex;

            align-items: center;

            gap: 7px;

            margin-bottom: 8px;

            color:
                #806A27;

            font-size: 8.5px;

            font-weight: 700;
        }


        .quick-tips-title i {

            font-size: 10px;
        }


        .quick-tips-text {

            margin: 0;

            color:
                #82795C;

            font-size: 7.8px;

            line-height: 1.65;
        }




/* =====================================================
   IMAGE CROP MODAL
   ===================================================== */

.crop-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;

    display: none;
    align-items: center;
    justify-content: center;

    padding: 24px;
}

.crop-modal.show {
    display: flex;
}

.crop-modal-backdrop {
    position: absolute;
    inset: 0;

    background:
        rgba(20, 35, 27, .72);

    backdrop-filter: blur(7px);
}

.crop-modal-card {
    position: relative;
    z-index: 1;

    width: min(760px, 100%);

    overflow: hidden;

    background:
        var(--white);

    border:
        1px solid rgba(255,255,255,.25);

    border-radius: 18px;

    box-shadow:
        0 30px 80px
        rgba(0,0,0,.28);
}


/* HEADER */

.crop-modal-header {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding:
        19px 22px;

    border-bottom:
        1px solid #EEE9DF;

    background:
        linear-gradient(
            110deg,
            #FFFDF8,
            #FCFAF4
        );
}

.crop-modal-title-wrapper {
    display: flex;

    align-items: center;

    gap: 12px;
}

.crop-modal-icon {
    width: 40px;
    height: 40px;

    min-width: 40px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background:
        var(--green-soft);

    color:
        var(--green);

    font-size: 17px;
}

.crop-modal-header h2 {
    margin: 0;

    color:
        var(--green);

    font-size: 15px;

    font-weight: 800;
}

.crop-modal-header p {
    margin:
        3px 0 0;

    color:
        var(--muted);

    font-size: 8.5px;
}

.crop-close-button {
    width: 34px;
    height: 34px;

    display: flex;

    align-items: center;
    justify-content: center;

    border:
        1px solid #DED8CC;

    border-radius: 8px;

    background:
        #FFFDF8;

    color:
        #69736C;

    font-size: 11px;

    transition:
        background .2s ease,
        color .2s ease,
        border-color .2s ease;
}

.crop-close-button:hover {
    background:
        #F7EEEE;

    border-color:
        #E0BBBB;

    color:
        var(--danger);
}


/* BODY */

.crop-modal-body {
    padding:
        20px 22px;
}

.crop-instruction {
    display: flex;

    align-items: center;

    gap: 7px;

    margin-bottom: 12px;

    color:
        var(--muted);

    font-size: 8.5px;
}

.crop-instruction i {
    color:
        var(--gold);

    font-size: 11px;
}


/* CROP CONTAINER */

.crop-container {
    width: 100%;

    height: 390px;

    overflow: hidden;

    border:
        1px solid #DCD6CA;

    border-radius: 11px;

    background:
        #202620;
}

.crop-container img {
    display: block;

    max-width: 100%;
}


/* CONTROLS */

.crop-controls {
    display: flex;

    align-items: center;
    justify-content: center;

    gap: 8px;

    margin-top: 14px;
}

.crop-control-button {
    min-width: 34px;
    height: 34px;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 6px;

    padding:
        0 9px;

    border:
        1px solid #DCD6CA;

    border-radius: 8px;

    background:
        #FFFDF8;

    color:
        var(--green);

    font-size: 9px;

    transition:
        background .2s ease,
        border-color .2s ease,
        transform .2s ease;
}

.crop-control-button:hover {
    background:
        var(--green-soft);

    border-color:
        #BDD1C1;

    transform:
        translateY(-1px);
}

.crop-zoom-label {
    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding:
        0 7px;

    color:
        var(--muted);

    font-size: 8px;

    font-weight: 600;
}

.crop-zoom-label i {
    color:
        var(--gold);
}

.crop-control-divider {
    width: 1px;
    height: 22px;

    margin:
        0 3px;

    background:
        #E3DDD1;
}


/* FOOTER */

.crop-modal-footer {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 20px;

    padding:
        15px 22px;

    border-top:
        1px solid #EEE9DF;

    background:
        #FCFAF4;
}

.crop-ratio-info {
    display: flex;

    align-items: center;

    gap: 7px;

    color:
        var(--muted);

    font-size: 8px;
}

.crop-ratio-info i {
    color:
        var(--gold);

    font-size: 11px;
}

.crop-ratio-info strong {
    color:
        var(--green);

    font-weight: 800;
}

.crop-modal-actions {
    display: flex;

    align-items: center;

    gap: 8px;
}

.crop-cancel-button,
.crop-confirm-button {
    height: 37px;

    padding:
        0 15px;

    border-radius: 8px;

    font-size: 9px;

    font-weight: 700;

    transition:
        background .2s ease,
        border-color .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}

.crop-cancel-button {
    border:
        1px solid #DCD6CA;

    background:
        #FFFDF8;

    color:
        #59655D;
}

.crop-cancel-button:hover {
    background:
        var(--cream-dark);

    border-color:
        #CEC5B6;
}

.crop-confirm-button {
    border:
        1px solid var(--green);

    background:
        var(--green);

    color:
        #fff;

    box-shadow:
        0 5px 13px
        rgba(27,82,51,.13);
}

.crop-confirm-button:hover {
    background:
        var(--green-dark);

    border-color:
        var(--green-dark);

    transform:
        translateY(-1px);

    box-shadow:
        0 8px 18px
        rgba(27,82,51,.18);
}


/* MOBILE */

@media (max-width: 650px) {

    .crop-modal {
        padding: 12px;
    }

    .crop-modal-header {
        padding:
            16px;
    }

    .crop-modal-body {
        padding:
            15px;
    }

    .crop-container {
        height: 300px;
    }

    .crop-modal-footer {
        flex-direction: column;

        align-items: stretch;

        padding:
            13px 15px;
    }

    .crop-ratio-info {
        justify-content: center;
    }

    .crop-modal-actions {
        width: 100%;
    }

    .crop-cancel-button,
    .crop-confirm-button {
        flex: 1;
    }

}


        /* =====================================================
           TOAST
           ===================================================== */

        .category-toast {

            position: fixed;

            right: 25px;
            bottom: 25px;

            z-index: 5000;

            min-width: 280px;
            max-width: 390px;

            padding:
                13px
                16px;

            border-radius: 9px;

            background:
                var(--green);

            color:
                #fff;

            box-shadow:
                0 12px 35px
                rgba(20,48,31,.22);

            display: none;

            font-size: 10px;
        }


        .category-toast.show {

            display: block;

            animation:
                toastIn .25s ease;
        }


        .category-toast.error {

            background:
                #8F5555;
        }


        @keyframes toastIn {

            from {

                opacity: 0;

                transform:
                    translateY(10px);
            }

            to {

                opacity: 1;

                transform:
                    translateY(0);
            }
        }


        /* =====================================================
           RESPONSIVE
           ===================================================== */

        @media (max-width: 1200px) {

            .add-category-content {

                padding-left: 27px;

                padding-right: 27px;
            }


            .category-workspace {

                grid-template-columns:
                    minmax(0, 1.15fr)
                    minmax(300px, .75fr);
            }


            .store-preview-image {

                height: 215px;
            }
        }


        @media (max-width: 1000px) {

            .category-workspace {

                grid-template-columns: 1fr;
            }


            .preview-card {

                order: 2;
            }


            .category-form-card {

                order: 1;
            }


            .store-preview-image {

                height: 300px;
            }
        }


        @media (max-width: 900px) {

            .admin-main {

                margin-left: 78px;

                width:
                    calc(100% - 78px);
            }


            .add-category-content {

                padding:
                    25px
                    20px
                    42px;
            }
        }


        @media (max-width: 650px) {

            .admin-main {

                margin-left: 65px;

                width:
                    calc(100% - 65px);
            }


            .add-category-content {

                padding:
                    20px
                    12px
                    30px;
            }


            .category-breadcrumb {

                font-size: 9px;
            }


            .category-hero {

                text-align: left;
            }


            .category-eyebrow {

                font-size: 7px;
            }


            .category-page-heading {

                font-size: 25px;
            }


            .category-page-subtitle {

                margin-left: 0;

                font-size: 10px;
            }


            .hero-decoration {

                justify-content: flex-start;
            }


            .form-header {

                align-items: flex-start;

                padding:
                    18px;
            }


            .form-header-badge {

                display: none;
            }


            .category-form {

                padding:
                    20px 18px;
            }


            .image-upload-area,
            .upload-content {

                min-height: 230px;
            }


            .form-footer {

                flex-direction: column;

                align-items: stretch;

                gap: 15px;
            }


            .form-actions {

                width: 100%;
            }


            .form-button {

                flex: 1;
            }


            .store-preview-image {

                height: 250px;
            }


            .category-toast {

                right: 15px;

                left: 15px;

                min-width: 0;
            }
        }

    </style>

</head>


<body>


    <!-- =====================================================
         SIDEBAR
         ===================================================== -->

    <%- include("partials/sidebar", {
        activePage: "categories"
    }) %>


    <!-- =====================================================
         MAIN
         ===================================================== -->

    <main class="admin-main">

        <div class="page-loading-overlay" id="pageLoadingOverlay" aria-live="polite">
            <div class="page-loading-card">
                <span class="page-loading-spinner"></span>
                <span>Loading category...</span>
            </div>
        </div>


        <!-- =================================================
             HEADER
             ================================================= -->

        <%- include("partials/header", {
            pageTitle: "Edit Category",
            showSearch: false,
            admin: admin
        }) %>


        <!-- =================================================
             BOTANICAL DECORATIONS
             ================================================= -->

        <div class="category-leaf category-leaf-right"></div>

        <div class="category-leaf category-leaf-left"></div>

        <div class="category-leaf category-leaf-small"></div>


        <!-- =================================================
             PAGE CONTENT
             ================================================= -->

        <section class="add-category-content">


            <!-- =================================================
                 BREADCRUMB
                 ================================================= -->

            <div class="category-breadcrumb">

                <a href="/admin/categories">
                    Categories
                </a>

                <i class="bi bi-chevron-right"></i>

                <span>
                    Edit Category
                </span>

            </div>


            <!-- =================================================
                 HERO
                 ================================================= -->

            <div class="category-hero">

                <div class="category-eyebrow">
                    Naadan Box Collection
                </div>


                <h1 class="category-page-heading">
                    Edit Category
                </h1>


                <p class="category-page-subtitle">
                    Update your category information and keep your Naadan Box
                    collection looking its best.
                </p>


                <div class="hero-decoration">

                    <span></span>

                </div>

            </div>


            <!-- =================================================
                 WORKSPACE
                 ================================================= -->

            <div class="category-workspace">


                <!-- =================================================
                     LEFT - FORM
                     ================================================= -->

                <div class="category-form-card">


                    <!-- FORM HEADER -->

                    <div class="form-header">

                        <div class="form-header-left">

                            <div class="form-header-icon">

                                <i class="bi bi-pencil-square"></i>

                            </div>


                            <div>

                                <h2 class="form-header-title">
                                    Category Information
                                </h2>


                                <div class="form-header-subtitle">
                                    Update how this collection appears
                                    across your store.
                                </div>

                            </div>

                        </div>


                        <div class="form-header-badge" id="statusBadge">

                            <i class="bi bi-check-circle-fill"></i>

                            <span id="statusBadgeText">Active Category</span>

                        </div>

                    </div>


                    <!-- FORM -->

                    <form
                        id="categoryForm"
                        class="category-form"
                        novalidate
                    >


                        <!-- =================================================
                             NAME
                             ================================================= -->

                        <div class="name-field">

                            <div class="section-label">

                                <i class="bi bi-type"></i>

                                Category Name

                                <span
                                    style="color: var(--danger);"
                                >
                                    *
                                </span>

                            </div>


                            <div class="name-input-wrapper">

                                <input
                                    type="text"
                                    id="categoryName"
                                    name="name"
                                    class="category-input"
                                    placeholder="e.g. Kerala Veg Specials"
                                    maxlength="50"
                                    autocomplete="off"
                                    spellcheck="false"
                                    required
                                >


                                <span
                                    class="character-count"
                                    id="nameCharacterCount"
                                >
                                    0 / 50
                                </span>

                            </div>


                            <div
                                class="field-error"
                                id="nameError"
                                aria-live="polite"
                            ></div>

                        </div>


                        <!-- =================================================
                             IMAGE
                             ================================================= -->

                        <div class="image-section">

                            <div class="section-label">

                                <i class="bi bi-image"></i>

                                Category Cover Image

                                <span
                                    style="color: var(--muted); font-weight: 500;"
                                >
                                    (Optional)
                                </span>

                            </div>


                            <div
                                class="current-image-note"
                                id="currentImageNote"
                            >
                                <i class="bi bi-info-circle"></i>
                                <span>Current category image is shown below. Choose a new image only if you want to replace it.</span>
                            </div>

                            <div
                                class="image-upload-area"
                                id="imageUploadArea"
                            >


                                <!-- UPLOAD CONTENT -->

                                <div
                                    class="upload-content"
                                    id="uploadContent"
                                >

                                    <div class="upload-symbol">

                                        <i class="bi bi-cloud-arrow-up"></i>

                                    </div>


                                    <h3 class="upload-title">
                                        Drop a new category image here
                                    </h3>


                                    <p class="upload-description">
                                        Use a clear, high-quality image
                                        that represents this collection
                                        beautifully.
                                    </p>


                                    <button
                                        type="button"
                                        class="browse-button"
                                        id="browseButton"
                                    >
                                        <i class="bi bi-folder2-open"></i>
                                        &nbsp;
                                        Browse from device
                                    </button>


                                    <div class="upload-hint">
                                        JPG · JPEG · PNG · WEBP
                                        &nbsp;•&nbsp;
                                        Maximum 5 MB
                                    </div>

                                </div>


                                <!-- FILE INPUT -->

                                <input
                                    type="file"
                                    id="categoryImage"
                                    name="image"
                                    accept="image/jpeg,image/jpg,image/png,image/webp"
                                >


                                <!-- PREVIEW -->

                                <div
                                    class="image-preview-wrapper"
                                    id="imagePreviewWrapper"
                                >

                                    <img
                                        id="imagePreview"
                                        class="image-preview"
                                        alt="Category image preview"
                                    >


                                    <div class="image-preview-overlay">

                                        <div
                                            class="image-preview-name"
                                            id="imagePreviewName"
                                        ></div>


                                        <button
                                            type="button"
                                            class="remove-image-button"
                                            id="removeImageButton"
                                            title="Remove image"
                                            aria-label="Remove image"
                                        >

                                            <i class="bi bi-arrow-repeat"></i>

                                        </button>

                                    </div>

                                </div>

                            </div>


                            <div
                                class="image-error"
                                id="imageError"
                                aria-live="polite"
                            ></div>

                        </div>


                        <!-- =================================================
                             FOOTER
                             ================================================= -->

                        <div class="form-footer">


                            <div class="form-footer-note">

                                <i class="bi bi-shield-check"></i>

                                <span>
                                    Your category will be updated securely.
                                </span>

                            </div>


                            <div class="form-actions">

                                <button
                                    type="button"
                                    class="form-button cancel-button"
                                    id="cancelButton"
                                >
                                    Cancel
                                </button>


                                <button
                                    type="submit"
                                    class="form-button submit-button"
                                    id="submitButton"
                                >

                                    <span id="submitText">
                                        Update Category
                                        <i class="bi bi-check2 ms-1"></i>
                                    </span>

                                </button>

                            </div>

                        </div>

                    </form>

                </div>


                <!-- =================================================
                     RIGHT - LIVE PREVIEW
                     ================================================= -->

                <aside class="preview-card">


                    <!-- PREVIEW HEADER -->

                    <div class="preview-header">

                        <div class="preview-header-left">

                            <div class="preview-header-icon">

                                <i class="bi bi-eye"></i>

                            </div>


                            <div>

                                <h2>
                                    Store Preview
                                </h2>

                                <p>
                                    See how your category will look
                                </p>

                            </div>

                        </div>


                        <div class="preview-live">

                            <span
                                class="preview-live-dot"
                            ></span>

                            Live Preview

                        </div>

                    </div>


                    <!-- PREVIEW BODY -->

                    <div class="preview-body">


                        <div class="preview-label">
                            Customer-facing appearance
                        </div>


                        <!-- STORE CARD -->

                        <div class="store-preview">


                            <!-- IMAGE -->

                            <div
                                class="store-preview-image"
                                id="storePreviewImage"
                            >


                                <img
                                    id="storePreviewImageElement"
                                    alt="Category preview"
                                >


                                <div class="preview-placeholder">

                                    <div
                                        class="preview-placeholder-symbol"
                                    >
                                        <i class="bi bi-image"></i>
                                    </div>


                                    <h3
                                        class="preview-placeholder-title"
                                    >
                                        Category Image
                                    </h3>


                                    <p
                                        class="preview-placeholder-text"
                                    >
                                        Your selected category image
                                        will appear here.
                                    </p>

                                </div>


                                <div class="preview-image-badge">

                                    <i class="bi bi-stars"></i>

                                    Naadan Box

                                </div>

                            </div>


                            <!-- DETAILS -->

                            <div class="store-preview-details">

                                <div class="preview-category-label">
                                    Category
                                </div>


                                <div
                                    class="preview-category-name placeholder"
                                    id="previewCategoryName"
                                >
                                    Your Category
                                </div>


                                <div class="preview-status">

                                    <span
                                        class="preview-status-dot"
                                    ></span>

                                    Active Category

                                </div>


                                <div class="preview-store-footer">

                                    <div class="preview-footer-note">
                                        Changes will appear across your
                                        Naadan Box collection.
                                    </div>


                                    <div class="preview-footer-icon">

                                        <i class="bi bi-arrow-up-right"></i>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- QUICK TIPS -->

                        <div class="quick-tips">

                            <div class="quick-tips-title">

                                <i class="bi bi-lightbulb"></i>

                                Editing tip

                            </div>


                            <p class="quick-tips-text">
                                You can update the category name, replace its image, or keep
                                the existing image. Changes are saved only after you select
                                Update Category.
                            </p>

                        </div>

                    </div>

                </aside>

            </div>

        </section>

    </main>


    <!-- IMAGE CROP MODAL -->
    <div class="crop-modal" id="cropModal" aria-hidden="true">
        <div class="crop-modal-backdrop" id="cropModalBackdrop"></div>
        <div class="crop-modal-card" role="dialog" aria-modal="true" aria-labelledby="cropModalTitle">
            <div class="crop-modal-header">
                <div class="crop-modal-title-wrapper">
                    <div class="crop-modal-icon"><i class="bi bi-crop"></i></div>
                    <div>
                        <h2 id="cropModalTitle">Crop Category Image</h2>
                        <p>Adjust the image to fit your storefront perfectly.</p>
                    </div>
                </div>
                <button type="button" class="crop-close-button" id="cropCloseButton" aria-label="Close crop window">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="crop-modal-body">
                <div class="crop-instruction">
                    <i class="bi bi-info-circle"></i>
                    <span>Drag to reposition and use the controls below to adjust your image.</span>
                </div>
                <div class="crop-container">
                    <img id="cropImage" alt="Image to crop">
                </div>
                <div class="crop-controls">
                    <button type="button" class="crop-control-button" id="cropZoomOut" title="Zoom out">
                        <i class="bi bi-dash-lg"></i>
                    </button>
                    <div class="crop-zoom-label">
                        <i class="bi bi-search"></i>
                        <span>Zoom</span>
                    </div>
                    <button type="button" class="crop-control-button" id="cropZoomIn" title="Zoom in">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                    <div class="crop-control-divider"></div>
                    <button type="button" class="crop-control-button crop-reset-button" id="cropResetButton" title="Reset image">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>Reset</span>
                    </button>
                </div>
            </div>

            <div class="crop-modal-footer">
                <div class="crop-ratio-info">
                    <i class="bi bi-aspect-ratio"></i>
                    <span>Recommended ratio <strong>4 : 3</strong></span>
                </div>
                <div class="crop-modal-actions">
                    <button type="button" class="crop-cancel-button" id="cropCancelButton">Cancel</button>
                    <button type="button" class="crop-confirm-button" id="cropConfirmButton">
                        <i class="bi bi-check2"></i>
                        Crop Image
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- =====================================================
         TOAST
         ===================================================== -->

    <div
        class="category-toast"
        id="toast"
        role="status"
        aria-live="polite"
    ></div>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script
        src="https://cdn.jsdelivr.net/npm/cropperjs@1.6.2/dist/cropper.min.js">
    </script>

    <script>

        const categoryForm = document.getElementById("categoryForm");
        const categoryName = document.getElementById("categoryName");
        const categoryImage = document.getElementById("categoryImage");
        const imageUploadArea = document.getElementById("imageUploadArea");
        const uploadContent = document.getElementById("uploadContent");
        const browseButton = document.getElementById("browseButton");
        const imagePreviewWrapper = document.getElementById("imagePreviewWrapper");
        const imagePreview = document.getElementById("imagePreview");
        const imagePreviewName = document.getElementById("imagePreviewName");
        const removeImageButton = document.getElementById("removeImageButton");
        const nameError = document.getElementById("nameError");
        const imageError = document.getElementById("imageError");
        const nameCharacterCount = document.getElementById("nameCharacterCount");
        const previewCategoryName = document.getElementById("previewCategoryName");
        const storePreviewImage = document.getElementById("storePreviewImage");
        const storePreviewImageElement = document.getElementById("storePreviewImageElement");
        const submitButton = document.getElementById("submitButton");
        const submitText = document.getElementById("submitText");
        const cancelButton = document.getElementById("cancelButton");
        const toast = document.getElementById("toast");
        const pageLoadingOverlay = document.getElementById("pageLoadingOverlay");
        const statusBadge = document.getElementById("statusBadge");
        const statusBadgeText = document.getElementById("statusBadgeText");

        const cropModal = document.getElementById("cropModal");
        const cropModalBackdrop = document.getElementById("cropModalBackdrop");
        const cropImage = document.getElementById("cropImage");
        const cropCloseButton = document.getElementById("cropCloseButton");
        const cropCancelButton = document.getElementById("cropCancelButton");
        const cropConfirmButton = document.getElementById("cropConfirmButton");
        const cropZoomIn = document.getElementById("cropZoomIn");
        const cropZoomOut = document.getElementById("cropZoomOut");
        const cropResetButton = document.getElementById("cropResetButton");

        const MAX_IMAGE_SIZE = 5 * 1024 * 1024;
        const ALLOWED_IMAGE_TYPES = ["image/jpeg", "image/jpg", "image/png", "image/webp"];

  const pathParts = window.location.pathname
    .split("/")
    .filter(Boolean);

const categoryId =
    pathParts[pathParts.length - 1] === "edit"
        ? pathParts[pathParts.length - 2]
        : null;


     let toastTimeout = null;
let currentPreviewUrl = null;
let currentImageUrl = null;
let originalCategoryName = "";
let cropper = null;
let pendingCropFile = null;
let cropObjectUrl = null;
let isSubmitting = false;
let categoryLoaded = false;


        function showToast(message, isError = false) {
            clearTimeout(toastTimeout);
            toast.textContent = message;
            toast.classList.toggle("error", isError);
            toast.classList.add("show");
            toastTimeout = setTimeout(() => toast.classList.remove("show"), 3500);
        }

        function normalizeCategoryName(value) {
            return value.replace(/\s+/g, " ").trim();
        }

        function updateCharacterCount() {
            nameCharacterCount.textContent = `${categoryName.value.length} / 50`;
        }

        function updateNamePreview() {
            const value = normalizeCategoryName(categoryName.value);
            if (!value) {
                previewCategoryName.textContent = "Your Category";
                previewCategoryName.classList.add("placeholder");
                return;
            }
            previewCategoryName.textContent = value;
            previewCategoryName.classList.remove("placeholder");
        }

        function clearNameError() {
            nameError.textContent = "";
            categoryName.classList.remove("input-error");
        }

        function clearImageError() {
            imageError.textContent = "";
            imageError.style.display = "none";
        }

        function validateName() {
            clearNameError();
            const normalizedName = normalizeCategoryName(categoryName.value);

            if (!normalizedName) {
                nameError.textContent = "Category name is required.";
                categoryName.classList.add("input-error");
                return false;
            }
            if (normalizedName.length < 2) {
                nameError.textContent = "Category name must be at least 2 characters.";
                categoryName.classList.add("input-error");
                return false;
            }
            if (normalizedName.length > 50) {
                nameError.textContent = "Category name cannot exceed 50 characters.";
                categoryName.classList.add("input-error");
                return false;
            }

            categoryName.value = normalizedName;
            categoryName.classList.add("input-success");
            updateCharacterCount();
            updateNamePreview();
            return true;
        }

        function validateImage(file) {
            clearImageError();
            if (!file) return false;

            if (!ALLOWED_IMAGE_TYPES.includes(file.type)) {
                imageError.textContent = "Only JPG, JPEG, PNG and WEBP images are allowed.";
                imageError.style.display = "block";
                return false;
            }
            if (file.size > MAX_IMAGE_SIZE) {
                imageError.textContent = "Image size cannot exceed 5 MB.";
                imageError.style.display = "block";
                return false;
            }
            return true;
        }

        function showImagePreview(file) {
            if (currentPreviewUrl) URL.revokeObjectURL(currentPreviewUrl);
            currentPreviewUrl = URL.createObjectURL(file);

            imagePreview.src = currentPreviewUrl;
            imagePreview.alt = `Preview of ${file.name}`;
            imagePreviewName.textContent = file.name;
            uploadContent.style.display = "none";
            imagePreviewWrapper.classList.add("show");

            storePreviewImageElement.src = currentPreviewUrl;
            storePreviewImageElement.alt = `Preview of ${file.name}`;
            storePreviewImage.classList.add("has-image");
        }

      function showExistingImage(imageUrl) {
    if (!imageUrl || typeof imageUrl !== "string") {
        return;
    }

    const normalizedImageUrl = imageUrl
        .trim()
        .replace(/\\/g, "/");

    const browserImageUrl = normalizedImageUrl.startsWith("/")
        ? normalizedImageUrl
        : `/${normalizedImageUrl}`;

    currentImageUrl = browserImageUrl;

    imagePreview.src = browserImageUrl;
    imagePreview.alt = "Current category image";
    imagePreviewName.textContent = "Current category image";
    uploadContent.style.display = "none";
    imagePreviewWrapper.classList.add("show");

    storePreviewImageElement.src = browserImageUrl;
    storePreviewImageElement.alt = "Current category image";
    storePreviewImage.classList.add("has-image");
}

      function restoreExistingImage() {
    categoryImage.value = "";
    clearImageError();

    if (currentPreviewUrl) {
        URL.revokeObjectURL(currentPreviewUrl);
        currentPreviewUrl = null;
    }

    if (currentImageUrl) {
        showExistingImage(currentImageUrl);
    } else {
        imagePreviewWrapper.classList.remove("show");
        uploadContent.style.display = "";
        storePreviewImageElement.src = "";
        storePreviewImage.classList.remove("has-image");
    }
}

        function handleImageFile(file) {
            if (!validateImage(file)) return;
            openCropper(file);
        }

        function openCropper(file) {
            pendingCropFile = file;

            if (cropObjectUrl) URL.revokeObjectURL(cropObjectUrl);
            cropObjectUrl = URL.createObjectURL(file);
            cropImage.src = cropObjectUrl;

            cropModal.classList.add("show");
            cropModal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";

            if (cropper) {
                cropper.destroy();
                cropper = null;
            }

            cropImage.onload = () => {
                cropper = new Cropper(cropImage, {
                    aspectRatio: 4 / 3,
                    viewMode: 1,
                    dragMode: "move",
                    autoCropArea: 0.9,
                    responsive: true,
                    restore: false,
                    guides: true,
                    center: true,
                    highlight: false,
                    cropBoxMovable: true,
                    cropBoxResizable: true,
                    toggleDragModeOnDblclick: false
                });
            };
        }

        function closeCropper() {
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
            cropModal.classList.remove("show");
            cropModal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            cropImage.onload = null;

            if (cropObjectUrl) {
                URL.revokeObjectURL(cropObjectUrl);
                cropObjectUrl = null;
            }

            pendingCropFile = null;
            cropImage.src = "";
        }

        function replaceInputFile(file) {
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            categoryImage.files = dataTransfer.files;
        }

        function createCroppedFile() {
            if (!cropper || !pendingCropFile) return;

            cropConfirmButton.disabled = true;

            const originalName = pendingCropFile.name.replace(/\.[^/.]+$/, "");
            const outputType =
                pendingCropFile.type === "image/png" ? "image/png" :
                pendingCropFile.type === "image/webp" ? "image/webp" :
                "image/jpeg";
            const extension =
                outputType === "image/png" ? "png" :
                outputType === "image/webp" ? "webp" : "jpg";

            cropper.getCroppedCanvas({
                width: 1200,
                height: 900,
                imageSmoothingEnabled: true,
                imageSmoothingQuality: "high"
            }).toBlob(blob => {
                if (!blob) {
                    cropConfirmButton.disabled = false;
                    showToast("Unable to crop the image. Please try again.", true);
                    return;
                }

                const croppedFile = new File(
                    [blob],
                    `${originalName}-cropped.${extension}`,
                    { type: outputType, lastModified: Date.now() }
                );

                if (!validateImage(croppedFile)) {
                    cropConfirmButton.disabled = false;
                    return;
                }

                try {
                    replaceInputFile(croppedFile);
                } catch (error) {
                    console.error("Unable to assign cropped file:", error);
                    cropConfirmButton.disabled = false;
                    showToast("Unable to prepare the cropped image. Please try again.", true);
                    return;
                }

                closeCropper();
                cropConfirmButton.disabled = false;
                showImagePreview(croppedFile);
            }, outputType, outputType === "image/jpeg" ? 0.92 : undefined);
        }

        cropZoomIn.addEventListener("click", () => {
            if (cropper) cropper.zoom(0.1);
        });

        cropZoomOut.addEventListener("click", () => {
            if (cropper) cropper.zoom(-0.1);
        });

        cropResetButton.addEventListener("click", () => {
            if (cropper) cropper.reset();
        });

        cropConfirmButton.addEventListener("click", createCroppedFile);
        cropCloseButton.addEventListener("click", closeCropper);
        cropCancelButton.addEventListener("click", closeCropper);
        cropModalBackdrop.addEventListener("click", closeCropper);

        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && cropModal.classList.contains("show")) {
                closeCropper();
            }
        });

        browseButton.addEventListener("click", () => categoryImage.click());

        categoryImage.addEventListener("change", () => {
            const file = categoryImage.files[0];
            if (file) handleImageFile(file);
        });

      removeImageButton.addEventListener("click", () => {
    const hasNewImage = Boolean(categoryImage.files[0]);

    if (hasNewImage) {
        restoreExistingImage();
        return;
    }

    // Existing image is currently being displayed.
    // Do not delete it from the database.
    // Simply switch back to the upload area so a replacement can be selected.

    imagePreviewWrapper.classList.remove("show");
    uploadContent.style.display = "";
    categoryImage.value = "";

    clearImageError();

    storePreviewImageElement.src = currentImageUrl || "";
    storePreviewImageElement.alt = "Current category image";
    storePreviewImage.classList.toggle(
        "has-image",
        Boolean(currentImageUrl)
    );

    showToast(
        "Choose a new image to replace the current category image."
    );
});

        imageUploadArea.addEventListener("dragover", event => {
            event.preventDefault();
            imageUploadArea.classList.add("dragover");
        });

        imageUploadArea.addEventListener("dragleave", event => {
            if (!imageUploadArea.contains(event.relatedTarget)) {
                imageUploadArea.classList.remove("dragover");
            }
        });

        imageUploadArea.addEventListener("drop", event => {
            event.preventDefault();
            imageUploadArea.classList.remove("dragover");

            const file = event.dataTransfer.files[0];
            if (file) handleImageFile(file);
        });

        categoryName.addEventListener("input", () => {
            clearNameError();
            categoryName.classList.remove("input-success");
            updateCharacterCount();
            updateNamePreview();
        });

        categoryName.addEventListener("blur", () => {
            if (categoryName.value) validateName();
        });

        cancelButton.addEventListener("click", () => {
            window.location.href =
                `/admin/categories/${encodeURIComponent(categoryId)}`;
        });

        async function loadCategory() {
            try {
                if (!categoryId || !/^[a-fA-F0-9]{24}$/.test(categoryId)) {
                    throw new Error("Invalid category ID.");
                }

                const response = await fetch(
                    `/api/admin/categories/${encodeURIComponent(categoryId)}`,
                    { headers: { Accept: "application/json" } }
                );

                const contentType = response.headers.get("content-type") || "";

                if (!contentType.includes("application/json")) {
                    throw new Error("Unexpected server response.");
                }

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(result.message || "Unable to load category.");
                }

                const category = result.data;

                if (!category) {
                    throw new Error("Category not found.");
                }

               categoryName.value = category.name || "";

originalCategoryName = normalizeCategoryName(
    category.name || ""
);

updateCharacterCount();
updateNamePreview();

                if (category.image) {
                    showExistingImage(category.image);
                }

                if (category.isActive) {
                    statusBadgeText.textContent = "Active Category";
                } else {
                    statusBadgeText.textContent = "Inactive Category";
                    statusBadge.style.background = "#FFF5F5";
                    statusBadge.style.borderColor = "#E9CFCF";
                    statusBadge.style.color = "var(--danger)";
                }

                categoryLoaded = true;
            } catch (error) {
                console.error("Load category error:", error);
                showToast(error.message || "Unable to load category.", true);

                setTimeout(() => {
                    window.location.href = "/admin/categories";
                }, 1200);
            } finally {
                pageLoadingOverlay.classList.add("hidden");
            }
        }

        categoryForm.addEventListener("submit", async event => {
            event.preventDefault();

            if (isSubmitting || !categoryLoaded) return;

            const validName = validateName();

            if (!validName) {
                categoryName.focus();
                return;
            }

            isSubmitting = true;
            submitButton.disabled = true;

            submitText.innerHTML = `
                <span class="submit-spinner"></span>
                Updating...
            `;

            try {
             
const formData = new FormData();

const currentName = normalizeCategoryName(
    categoryName.value
);

const file = categoryImage.files[0];

const nameChanged =
    currentName !== originalCategoryName;

const imageChanged = Boolean(file);

if (!nameChanged && !imageChanged) {
    showToast("No changes to update.");

    submitButton.disabled = false;
    isSubmitting = false;

    submitText.innerHTML = `
        Update Category
        <i class="bi bi-check2 ms-1"></i>
    `;

    return;
}

if (nameChanged) {
    formData.append("name", currentName);
}

if (imageChanged) {
    formData.append("image", file);
}


                const response = await fetch(
                    `/api/admin/categories/${encodeURIComponent(categoryId)}`,
                    {
                        method: "PUT",
                        body: formData,
                        headers: { Accept: "application/json" }
                    }
                );

                const contentType = response.headers.get("content-type") || "";

                if (!contentType.includes("application/json")) {
                    throw new Error("Unexpected server response.");
                }

                const result = await response.json();

                if (!response.ok || !result.success) {
                    const serverMessage =
                        result.message || "Unable to update category.";

                    if (serverMessage.includes("already exists")) {
                        clearNameError();
                        nameError.textContent = serverMessage;
                        categoryName.classList.add("input-error");
                        categoryName.focus();

                        submitButton.disabled = false;
                        isSubmitting = false;

                        submitText.innerHTML = `
                            Update Category
                            <i class="bi bi-check2 ms-1"></i>
                        `;

                        return;
                    }

                    throw new Error(serverMessage);
                }

                showToast("Category updated successfully.");

                setTimeout(() => {
                    window.location.href =
                        `/admin/categories/${encodeURIComponent(categoryId)}`;
                }, 700);

            } catch (error) {
                console.error("Update category error:", error);
                showToast(error.message || "Unable to update category.", true);

                submitButton.disabled = false;
                isSubmitting = false;

                submitText.innerHTML = `
                    Update Category
                    <i class="bi bi-check2 ms-1"></i>
                `;
            }
        });

        updateCharacterCount();
        updateNamePreview();
        loadCategory();

    </script>
<script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    ></script>


</body>

</html>