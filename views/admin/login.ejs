<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Naadan Box</title>

    <!-- BOOTSTRAP -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- BOOTSTRAP ICONS -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    >

    <style>
        /* =========================================================
           ROOT
           ========================================================= */

        :root {
            --green: #1B5233;
            --green-dark: #16452B;
            --green-soft: #EDF4ED;

            --gold: #C99B25;
            --gold-soft: #F8EFCF;

            --cream: #F8F5ED;
            --cream-dark: #F1EDE3;

            --white: #FFFDF8;

            --text: #25372C;
            --muted: #7B857D;

            --border: #E5DFD2;

            --danger: #C95454;
            --danger-soft: #FFF0F0;
        }


        /* =========================================================
           GLOBAL
           ========================================================= */

        * {
            box-sizing: border-box;
        }

        html {
            height: 100%;
            overflow: hidden;
        }

        body {
            margin: 0;
            height: 100vh;
            min-height: 100vh;
            overflow: hidden;
            background: var(--cream);
            color: var(--text);
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                "Helvetica Neue",
                Arial,
                sans-serif;
        }


        /* =========================================================
           PAGE
           ========================================================= */

        .login-page {
            position: relative;
            height: 100vh;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }


        /* =========================================================
           BACKGROUND DECORATION
           ========================================================= */

        .login-leaf {
            position: absolute;
            pointer-events: none;
            z-index: 0;
        }

        .login-leaf-right {
            width: 220px;
            height: 95px;
            right: -70px;
            top: 95px;
            background: rgba(213, 216, 199, .32);
            border-radius: 100% 0 100% 0;
            transform: rotate(-34deg);
        }

        .login-leaf-right::after {
            content: "";
            position: absolute;
            width: 1px;
            height: 145px;
            left: 110px;
            top: -27px;
            background: rgba(190, 181, 145, .22);
            transform: rotate(-20deg);
        }

        .login-leaf-left {
            width: 160px;
            height: 68px;
            left: -82px;
            bottom: 55px;
            background: rgba(218, 218, 203, .25);
            border-radius: 100% 0 100% 0;
            transform: rotate(43deg);
        }

        .login-leaf-left::after {
            content: "";
            position: absolute;
            width: 1px;
            height: 110px;
            left: 80px;
            top: -20px;
            background: rgba(190, 181, 145, .20);
            transform: rotate(-20deg);
        }

        .login-leaf-small {
            width: 90px;
            height: 38px;
            right: 120px;
            bottom: 30px;
            background: rgba(218, 218, 203, .18);
            border-radius: 100% 0 100% 0;
            transform: rotate(28deg);
        }


        /* =========================================================
           MAIN
           ========================================================= */

        .login-main {
            position: relative;
            z-index: 2;
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 34px;
            overflow: hidden;
        }

        .login-shell {
            width: 100%;
            max-width: 980px;
            display: grid;
            grid-template-columns: minmax(0, 1fr) 400px;
            align-items: stretch;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 13px;
            box-shadow: 0 10px 25px rgba(27,82,51,.07);
            overflow: hidden;
        }


        /* =========================================================
           BRAND / VISUAL PANEL
           ========================================================= */

        .login-brand-panel {
            position: relative;
            min-height: 425px;
            padding: 34px 38px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            overflow: hidden;
            background:
                linear-gradient(
                    145deg,
                    #F4F0E4 0%,
                    #F8F5ED 58%,
                    #F1EDE3 100%
                );
            border-right: 1px solid var(--border);
        }

        .brand-panel-pattern {
            position: absolute;
            width: 220px;
            height: 220px;
            right: -72px;
            bottom: -76px;
            border: 1px solid rgba(201, 155, 37, .17);
            border-radius: 50%;
        }

        .brand-panel-pattern::before {
            content: "";
            position: absolute;
            inset: 23px;
            border: 1px solid rgba(201, 155, 37, .13);
            border-radius: 50%;
        }

        .brand-panel-pattern::after {
            content: "";
            position: absolute;
            width: 1px;
            height: 240px;
            left: 108px;
            top: -8px;
            background: rgba(201, 155, 37, .13);
            transform: rotate(42deg);
        }

        .panel-eyebrow {
            position: relative;
            z-index: 2;
            margin-bottom: 10px;
            color: var(--gold);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 2.2px;
            text-transform: uppercase;
        }

        .panel-title {
            position: relative;
            z-index: 2;
            max-width: 390px;
            margin: 0;
            color: var(--green);
            font-size: 27px;
            font-weight: 800;
            line-height: 1.13;
            letter-spacing: -.6px;
        }

        .panel-description {
            position: relative;
            z-index: 2;
            max-width: 365px;
            margin: 10px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.65;
        }

        .panel-decoration {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 17px;
        }

        .panel-decoration::before {
            content: "";
            width: 32px;
            height: 2px;
            background: var(--gold);
            border-radius: 10px;
        }

        .panel-decoration span {
            width: 5px;
            height: 5px;
            background: var(--gold);
            transform: rotate(45deg);
        }

        .panel-decoration::after {
            content: "";
            width: 30px;
            height: 1px;
            background: #D9CDA9;
            border-radius: 10px;
        }

        .admin-access-note {
            position: relative;
            z-index: 2;
            width: fit-content;
            margin-top: 25px;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: rgba(255, 253, 248, .72);
            color: var(--green);
            font-size: 10px;
            font-weight: 600;
        }

        .admin-access-note i {
            color: var(--gold);
            font-size: 13px;
        }

        .panel-mini-cards {
            position: relative;
            z-index: 2;
            display: flex;
            gap: 8px;
            margin-top: 34px;
        }

        .mini-card {
            min-width: 82px;
            padding: 9px 10px;
            border: 1px solid rgba(229, 223, 210, .9);
            border-radius: 8px;
            background: rgba(255, 253, 248, .68);
        }

        .mini-card i {
            display: block;
            margin-bottom: 5px;
            color: var(--green);
            font-size: 13px;
        }

        .mini-card:nth-child(2) i {
            color: var(--gold);
        }

        .mini-card:nth-child(3) i {
            color: #6B8172;
        }

        .mini-card span {
            color: var(--muted);
            font-size: 8px;
            font-weight: 600;
        }


        /* =========================================================
           LOGIN CARD
           ========================================================= */

        .login-card {
            position: relative;
            padding: 30px 30px 24px;
            background: var(--white);
        }

        .login-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 34px;
            width: 30px;
            height: 3px;
            background: var(--gold);
            border-radius: 0 0 5px 5px;
        }

        .card-heading {
            margin-bottom: 22px;
        }

        .card-icon {
            width: 38px;
            height: 38px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: var(--green-soft);
            color: var(--green);
            font-size: 15px;
        }

        .card-title {
            margin: 0;
            color: var(--green);
            font-size: 17px;
            font-weight: 800;
            letter-spacing: -.2px;
        }

        .card-subtitle {
            margin: 5px 0 0;
            color: var(--muted);
            font-size: 10px;
            line-height: 1.5;
        }


        /* =========================================================
           ERROR
           ========================================================= */

        .login-error {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 17px;
            padding: 10px 11px;
            border: 1px solid #F0CCCC;
            border-radius: 8px;
            background: var(--danger-soft);
            color: var(--danger);
            font-size: 10px;
            line-height: 1.5;
        }

        .login-error i {
            flex-shrink: 0;
            margin-top: 1px;
        }


        /* =========================================================
           FORM
           ========================================================= */

        .form-group {
            margin-bottom: 16px;
        }

        .form-label-custom {
            display: block;
            margin-bottom: 6px;
            color: var(--text);
            font-size: 10px;
            font-weight: 700;
        }

        .input-wrapper {
            position: relative;
        }

        .form-control-custom {
            width: 100%;
            height: 40px;
            padding: 0 12px;
            border: 1px solid #DED8CC;
            border-radius: 8px;
            outline: none;
            background: #F9F7F1;
            color: var(--text);
            font-size: 11px;
            transition:
                border-color .2s ease,
                background .2s ease,
                box-shadow .2s ease;
        }

        .form-control-custom:hover {
            border-color: #D6CCB8;
        }

        .form-control-custom:focus {
            border-color: #CDBB7C;
            background: #FFFDF8;
            box-shadow: 0 0 0 3px rgba(201, 155, 37, .08);
        }

        .form-control-custom::placeholder {
            color: #969D97;
        }

        .password-wrapper .form-control-custom {
            padding-right: 40px;
        }

        .password-toggle-btn {
            position: absolute;
            right: 10px;
            top: 50%;
            width: 24px;
            height: 24px;
            padding: 0;
            border: 0;
            background: transparent;
            color: #8A948D;
            transform: translateY(-50%);
            cursor: pointer;
            font-size: 13px;
        }

        .password-toggle-btn:hover {
            color: var(--green);
        }

        .remember-row {
            margin: 1px 0 19px;
        }

        .remember-row .form-check {
            min-height: auto;
            margin: 0;
            padding-left: 21px;
        }

        .remember-row .form-check-input {
            width: 14px;
            height: 14px;
            margin-top: 0;
            margin-left: -21px;
            border: 1px solid #D6D0C5;
            cursor: pointer;
        }

        .remember-row .form-check-input:checked {
            border-color: var(--green);
            background-color: var(--green);
        }

        .remember-row .form-check-label {
            color: var(--muted);
            font-size: 10px;
            font-weight: 500;
            cursor: pointer;
        }

        .btn-login {
            width: 100%;
            height: 40px;
            border: 0;
            border-radius: 8px;
            background: var(--green);
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 6px 15px rgba(27, 82, 51, .11);
            transition:
                background .2s ease,
                transform .2s ease,
                box-shadow .2s ease;
        }

        .btn-login:hover {
            background: var(--green-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 9px 19px rgba(27, 82, 51, .15);
        }

        .btn-login:active {
            transform: translateY(0);
        }


        /* =========================================================
           SECURITY
           ========================================================= */

        .security-divider {
            height: 1px;
            margin: 19px 0 13px;
            background: #EEE9DF;
        }

        .security-message {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: var(--muted);
            font-size: 9px;
            line-height: 1.5;
            text-align: center;
        }

        .security-message i {
            color: var(--green);
            font-size: 11px;
        }


        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @media (max-width: 800px) {

            .login-main {
                padding: 20px 22px;
            }

            .login-shell {
                max-width: 470px;
                grid-template-columns: 1fr;
            }

            .login-brand-panel {
                min-height: auto;
                padding: 28px 28px 24px;
                border-right: 0;
                border-bottom: 1px solid var(--border);
            }

            .panel-title {
                font-size: 26px;
            }

            .panel-description {
                max-width: 470px;
            }

            .panel-mini-cards {
                margin-top: 22px;
            }

            .login-card {
                padding: 30px 28px 26px;
            }

            .login-card::before {
                left: 30px;
            }
        }

        @media (max-width: 520px) {

            .login-main {
                padding: 14px 13px;
            }

            .login-shell {
                border-radius: 13px;
            }

            .login-brand-panel {
                padding: 25px 22px 22px;
            }

            .panel-title {
                font-size: 24px;
            }

            .panel-description {
                font-size: 11px;
            }

            .panel-mini-cards {
                gap: 6px;
            }

            .mini-card {
                min-width: 0;
                flex: 1;
                padding: 8px;
            }

            .login-card {
                padding: 27px 20px 24px;
            }

            .login-card::before {
                left: 20px;
            }

            .card-title {
                font-size: 19px;
            }

            .login-leaf-right {
                opacity: .55;
            }

            .login-leaf-left,
            .login-leaf-small {
                opacity: .55;
            }
        }
    </style>
</head>

<body>

    <div class="login-page">

        <!-- =====================================================
             BACKGROUND DECORATIONS
             ===================================================== -->

        <div class="login-leaf login-leaf-right"></div>
        <div class="login-leaf login-leaf-left"></div>
        <div class="login-leaf login-leaf-small"></div>


        <!-- =====================================================
             SHARED ADMIN HEADER
             ===================================================== -->
<!-- =====================================================
             MAIN
             ===================================================== -->

        <main class="login-main">

            <div class="login-shell">

                <!-- =================================================
                     BRAND PANEL
                     ================================================= -->

                <section class="login-brand-panel">

                    <div class="brand-panel-pattern"></div>

                    <div class="panel-eyebrow">
                        Naadan Box Management
                    </div>

                    <h1 class="panel-title">
                        Welcome back,<br>
                        Admin.
                    </h1>

                    <p class="panel-description">
                        A dedicated space to manage your store,
                        products, customers, orders, offers,
                        and everyday operations.
                    </p>

                    <div class="panel-decoration">
                        <span></span>
                    </div>

                    <div class="admin-access-note">
                        <i class="bi bi-shield-check"></i>
                        <span>Authorized administrators only</span>
                    </div>

                    <div class="panel-mini-cards">

                        <div class="mini-card">
                            <i class="bi bi-box-seam"></i>
                            <span>Products</span>
                        </div>

                        <div class="mini-card">
                            <i class="bi bi-receipt"></i>
                            <span>Orders</span>
                        </div>

                        <div class="mini-card">
                            <i class="bi bi-people"></i>
                            <span>Customers</span>
                        </div>

                    </div>

                </section>


                <!-- =================================================
                     LOGIN CARD
                     ================================================= -->

                <section class="login-card">

                    <div class="card-heading">

                        <div class="card-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>

                        <h2 class="card-title">
                            Sign in to Admin
                        </h2>

                        <p class="card-subtitle">
                            Enter your administrator credentials to continue.
                        </p>

                    </div>


                    <!-- ERROR -->

                    <% if (typeof error !== 'undefined' && error) { %>

                        <div class="login-error" role="alert">

                            <i class="bi bi-exclamation-circle-fill"></i>

                            <span>
                                <%= error %>
                            </span>

                        </div>

                    <% } %>


                    <!-- LOGIN FORM -->

                    <form
                        action="/admin/login"
                        method="POST"
                        id="adminLoginForm"
                    >

                        <!-- EMAIL -->

                        <div class="form-group">

                            <label
                                for="email"
                                class="form-label-custom"
                            >
                                Admin Email Address
                            </label>

                            <div class="input-wrapper">

                                <input
                                    type="email"
                                    class="form-control-custom"
                                    id="email"
                                    name="email"
                                    value="<%= typeof email !== 'undefined' ? email : '' %>"
                                    autocomplete="off"
                                    required
                                >

                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group">

                            <label
                                for="password"
                                class="form-label-custom"
                            >
                                Password
                            </label>

                            <div class="input-wrapper password-wrapper">

                                <input
                                    type="password"
                                    class="form-control-custom"
                                    id="password"
                                    name="password"
                                    placeholder="••••••••"
                                    autocomplete="new-password"
                                    required
                                >

                                <button
                                    type="button"
                                    class="password-toggle-btn"
                                    id="togglePasswordBtn"
                                    aria-label="Show password"
                                >
                                    <i class="bi bi-eye"></i>
                                </button>

                            </div>

                        </div>


                        <!-- REMEMBER ME -->

                        <div class="remember-row">

                            <div class="form-check">

                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    id="rememberMe"
                                    name="rememberMe"
                                >

                                <label
                                    class="form-check-label"
                                    for="rememberMe"
                                >
                                    Remember Me
                                </label>

                            </div>

                        </div>


                        <!-- LOGIN BUTTON -->

                        <button
                            type="submit"
                            class="btn-login"
                        >
                            Login
                        </button>

                    </form>


                    <!-- SECURITY MESSAGE -->

                    <div class="security-divider"></div>

                    <div class="security-message">

                        <i class="bi bi-shield-check"></i>

                        <span>
                            Only authorized administrators can access this portal.
                        </span>

                    </div>

                </section>

            </div>

        </main>


    </div>


    <!-- =========================================================
         PASSWORD TOGGLE
         ========================================================= -->

    <script>

        const togglePasswordBtn =
            document.getElementById("togglePasswordBtn");

        const passwordInput =
            document.getElementById("password");

        togglePasswordBtn?.addEventListener("click", () => {

            const isPassword =
                passwordInput.type === "password";

            passwordInput.type =
                isPassword ? "text" : "password";

            togglePasswordBtn.innerHTML =
                isPassword
                    ? '<i class="bi bi-eye-slash"></i>'
                    : '<i class="bi bi-eye"></i>';

            togglePasswordBtn.setAttribute(
                "aria-label",
                isPassword
                    ? "Hide password"
                    : "Show password"
            );

        });

    </script>

</body>
</html>
