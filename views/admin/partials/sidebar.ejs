</aside>


<!-- =========================================================
     LOGOUT MODAL
     ========================================================= -->

<div
    class="logout-modal-overlay"
    id="logoutModal"
>

    <div class="logout-modal">

        <div class="logout-modal-icon">

            <i class="bi bi-box-arrow-right"></i>

        </div>


        <h3>
            Logout
        </h3>


        <p>
            Are you sure you want to logout from the admin panel?
        </p>


        <div class="logout-modal-actions">

            <button
                type="button"
                class="logout-cancel"
                id="logoutCancel"
            >
                Cancel
            </button>


            <button
                type="button"
                class="logout-confirm"
                id="logoutConfirm"
            >
                Logout
            </button>

        </div>

    </div>

</div>


<!-- =========================================================
     LOGOUT SCRIPT
     ========================================================= -->

<script>

    const logoutLink =
        document.getElementById("adminLogout");

    const logoutModal =
        document.getElementById("logoutModal");

    const logoutCancel =
        document.getElementById("logoutCancel");

    const logoutConfirm =
        document.getElementById("logoutConfirm");


    logoutLink?.addEventListener(
        "click",
        function(event) {

            event.preventDefault();

            logoutModal.classList.add("show");

        }
    );


    logoutCancel?.addEventListener(
        "click",
        function() {

            logoutModal.classList.remove("show");

        }
    );


    logoutConfirm?.addEventListener(
        "click",
        function() {

            window.location.href =
                logoutLink.href;

        }
    );


    logoutModal?.addEventListener(
        "click",
        function(event) {

            if (event.target === logoutModal) {

                logoutModal.classList.remove("show");

            }

        }
    );




    

</script>

 
<!-- ADMIN SESSION EXPIRED MODAL -->
<div
    class="session-expired-overlay"
    id="adminSessionExpiredModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sessionExpiredTitle"
    aria-describedby="sessionExpiredMessage"
    hidden
>
    <div class="session-expired-modal">
        <div class="session-expired-icon">
            <i class="bi bi-shield-lock"></i>
        </div>

        <h3 id="sessionExpiredTitle">Session Expired</h3>

        <p id="sessionExpiredMessage">
            Your admin session has expired for security reasons.
            Please log in again to continue.
        </p>

        <button
            type="button"
            class="session-expired-login"
            id="adminSessionLoginAgain"
        >
            Login Again
            <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

<style>
    .session-expired-overlay {
        position: fixed;
        inset: 0;
        z-index: 6000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(30, 45, 35, .52);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
    }

    .session-expired-overlay[hidden] {
        display: none !important;
    }

    .session-expired-modal {
        width: 400px;
        max-width: 100%;
        padding: 34px 30px;
        text-align: center;
        background: #fffdf8;
        border: 1px solid #e5dfd2;
        border-radius: 16px;
        box-shadow: 0 25px 65px rgba(30, 45, 35, .22);
        animation: sessionModalEnter .22s ease;
    }

    .session-expired-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #edf4ed;
        color: #1b5233;
        font-size: 24px;
    }

    .session-expired-modal h3 {
        margin: 0;
        color: #1b5233;
        font-size: 21px;
        font-weight: 800;
    }

    .session-expired-modal p {
        margin: 11px 0 24px;
        color: #788078;
        font-size: 13px;
        line-height: 1.7;
    }

    .session-expired-login {
        width: 100%;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border: 0;
        border-radius: 8px;
        background: #1b5233;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: background .2s ease;
    }

    .session-expired-login:hover {
        background: #16452b;
    }

    .session-expired-login:focus-visible {
        outline: 3px solid #c99b25;
        outline-offset: 3px;
    }

    @keyframes sessionModalEnter {
        from {
            opacity: 0;
            transform: translateY(10px) scale(.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (max-width: 480px) {
        .session-expired-modal {
            padding: 28px 22px;
        }
    }
</style>

<script>
    (() => {
        // Prevent duplicate initialization if this script is loaded twice.
        if (window.adminSessionWatcherStarted) return;
        window.adminSessionWatcherStarted = true;

        const modal = document.getElementById("adminSessionExpiredModal");
        const loginButton = document.getElementById("adminSessionLoginAgain");

        if (!modal || !loginButton) return;

        let sessionExpired = false;
        let checkingSession = false;

        const showExpiredModal = () => {
            if (sessionExpired) return;

            sessionExpired = true;
            modal.hidden = false;

            // Prevent accidental interaction with the expired admin page.
            document.body.style.overflow = "hidden";
            loginButton.focus();
        };

        loginButton.addEventListener("click", () => {
            window.location.replace("/admin/login");
        });

        const checkAdminSession = async () => {
            if (sessionExpired || checkingSession) return;

            checkingSession = true;

            try {
                const response = await fetch("/admin/session-status", {
                    method: "GET",
                    credentials: "same-origin",
                    cache: "no-store",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (response.status === 401) {
                    showExpiredModal();
                    return;
                }

                // A server error or unexpected response is not proof
                // that the session has expired. Try again next time.
                if (!response.ok) return;

                const result = await response.json();

                if (result.authenticated !== true) {
                    showExpiredModal();
                }
            } catch (error) {
                // Temporary network errors should not log out the admin.
                console.error("Admin session check failed:", error);
            } finally {
                checkingSession = false;
            }
        };

        // Check immediately, then every 15 seconds.
        checkAdminSession();
        window.setInterval(checkAdminSession, 15000);
    })();
</script>
