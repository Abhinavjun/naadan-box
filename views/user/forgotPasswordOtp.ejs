<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Verify OTP - Naadan Box</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- Bootstrap Icons -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    >


    <style>

        :root {

            --green: #1B4D2E;
            --dark-green: #133821;

            --cream: #FBF7EE;
            --light-cream: #F8F3E6;

            --text: #222222;
            --muted: #6C757D;

            --border: #E0DACF;

            --gold: #B8860B;
        }


        /* =====================================
           PAGE
        ===================================== */

        html,
        body {

            width: 100%;
            height: 100%;

            margin: 0;
            padding: 0;

            overflow: hidden;
        }


        body {

            background-color: var(--cream);

            color: var(--text);

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                "Helvetica Neue",
                Arial,
                sans-serif;

            display: flex;
            flex-direction: column;
        }


        /* =====================================
           NAVBAR
        ===================================== */

        header {

            flex-shrink: 0;

            background-color: var(--cream);

            border-bottom:
                1px solid var(--border);
        }


        .navbar-brand {

            color: var(--green) !important;

            font-weight: 800;

            letter-spacing: 0.5px;
        }


        .nav-link {

            color: var(--text) !important;

            font-size: 0.95rem;

            font-weight: 500;
        }


        .nav-link:hover {

            color: var(--green) !important;
        }


        /* =====================================
           MAIN
        ===================================== */

        .main-wrapper {

            flex: 1;

            min-height: 0;

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 1rem;
        }


        /* =====================================
           MAIN SPLIT CARD
        ===================================== */

        .split-card {

            width: 100%;

            max-width: 1050px;

            border: 1px solid var(--border);

            border-radius: 16px;

            overflow: hidden;

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.03);
        }


        /* =====================================
           LEFT SIDE
        ===================================== */

        .left-panel {

            background-color: var(--light-cream);

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 3.5rem 3rem;
        }


        .left-content {

            width: 100%;

            max-width: 500px;
        }


        .left-title {

            color: var(--green);

            font-size:
                calc(1.8rem + 1vw);

            font-weight: 800;

            line-height: 1.15;

            margin-bottom: 1rem;
        }


        .left-description {

            color: var(--muted);

            font-size: 1rem;

            line-height: 1.6;

            margin: 0;
        }


        /* =====================================
           RIGHT SIDE
        ===================================== */

        .right-panel {

            background-color: var(--cream);

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 2rem;
        }


        /* =====================================
           OTP CARD
        ===================================== */

        .otp-card {

            width: 100%;

            max-width: 420px;

            background-color: #ffffff;

            border:
                1px solid var(--border);

            border-radius: 20px;

            padding: 2.2rem 2rem;

            box-shadow:
                0 10px 30px rgba(0, 0, 0, 0.04);
        }


        /* =====================================
           TITLE
        ===================================== */

        .otp-title {

            color: var(--green);

            font-size: 1.6rem;

            font-weight: 700;

            margin-bottom: 0.3rem;
        }


        .otp-subtitle {

            color: var(--muted);

            font-size: 0.85rem;

            margin-bottom: 0.3rem;
        }


        .otp-email {

            color: var(--green);

            font-size: 0.9rem;

            font-weight: 700;

            word-break: break-word;
        }


        /* =====================================
           ERROR
        ===================================== */

        .otp-error {

            color: #DC3545;

            background-color: #FDF2F2;

            border: 1px solid #DC3545;

            border-radius: 8px;

            padding: 0.6rem 0.75rem;

            font-size: 0.85rem;

            margin-bottom: 1rem;
        }


        /* =====================================
           OTP INPUTS
        ===================================== */

        .otp-container {

            display: flex;

            justify-content: center;

            align-items: center;

            gap: 10px;

            margin: 1.5rem 0;
        }


        .otp-input {

            width: 48px;

            height: 54px;

            padding: 0;

            text-align: center;

            font-size: 1.2rem;

            font-weight: 700;

            color: var(--green);

            background-color: #ffffff;

            border:
                1px solid var(--border);

            border-radius: 10px;

            outline: none;
        }


        .otp-input:focus {

            border-color: var(--green);

            box-shadow:
                0 0 0 3px
                rgba(27, 77, 46, 0.12);
        }


        /* =====================================
           VERIFY BUTTON
        ===================================== */

        .verify-btn {

            width: 100%;

            border: none;

            border-radius: 12px;

            background-color: var(--green);

            color: #ffffff;

            padding: 0.8rem;

            font-size: 0.95rem;

            font-weight: 700;

            cursor: pointer;
        }


        .verify-btn:hover {

            background-color: var(--dark-green);
        }


        /* =====================================
           RESEND
        ===================================== */

        .resend-section {

            text-align: center;

            margin-top: 1.5rem;

            color: var(--muted);

            font-size: 0.85rem;
        }


        .resend-btn {

            border: none;

            background: none;

            padding: 0;

            color: var(--gold);

            font-weight: 700;

            cursor: pointer;
        }


        .resend-btn:hover:not(:disabled) {

            text-decoration: underline;
        }


        .resend-btn:disabled {

            color: #C7B27D;

            cursor: not-allowed;
        }


        .timer {

            margin-top: 0.25rem;

            min-height: 18px;

            color: var(--muted);

            font-size: 0.8rem;

            font-weight: 600;
        }


        /* =====================================
           INFO
        ===================================== */

        .otp-info {

            display: flex;

            justify-content: center;

            align-items: center;

            gap: 0.4rem;

            margin-top: 1.2rem;

            padding-top: 1.1rem;

            border-top:
                1px solid var(--border);

            color: var(--muted);

            font-size: 0.75rem;
        }


        /* =====================================
           FOOTER
        ===================================== */

        footer {

            flex-shrink: 0;

            background-color: var(--cream);

            border-top:
                1px solid var(--border);
        }


        .footer-brand {

            color: var(--green);

            font-weight: 800;

            font-size: 0.85rem;
        }


        .footer-links {

            font-size: 0.85rem;
        }


        .footer-links a {

            color: var(--text);

            text-decoration: none;
        }


        .footer-links a:hover {

            color: var(--green);
        }


        .footer-copy {

            color: var(--muted);

            font-size: 0.85rem;
        }


        /* =====================================
           MOBILE
        ===================================== */

        @media (max-width: 991px) {

            .main-wrapper {

                padding: 0.75rem;
            }


            .left-panel {

                padding: 1.5rem;

                text-align: center;
            }


            .left-title {

                font-size: 2rem;
            }


            .right-panel {

                padding: 1rem;
            }


            .otp-card {

                padding: 1.5rem 1.25rem;
            }
        }


        @media (max-width: 420px) {

            .otp-container {

                gap: 6px;
            }


            .otp-input {

                width: 42px;

                height: 50px;
            }
        }


        @media (max-width: 360px) {

            .otp-container {

                gap: 4px;
            }


            .otp-input {

                width: 38px;

                height: 46px;
            }
        }

    </style>

</head>


<body>


    <!-- =====================================
         NAVBAR
    ===================================== -->

    <header class="py-3 px-3 px-md-5">

        <div class="container-fluid">

            <div
                class="
                    d-flex
                    justify-content-between
                    align-items-center
                "
            >

                <a
                    href="/"
                    class="navbar-brand fs-4"
                >
                    NAADAN BOX
                </a>


                <nav class="d-none d-md-flex gap-4">

                    <a
                        href="/"
                        class="nav-link"
                    >
                        Home
                    </a>

                    <a
                        href="#"
                        class="nav-link"
                    >
                        Products
                    </a>

                    <a
                        href="#"
                        class="nav-link"
                    >
                        About Us
                    </a>

                    <a
                        href="#"
                        class="nav-link"
                    >
                        Contact
                    </a>

                </nav>

            </div>

        </div>

    </header>



    <!-- =====================================
         MAIN
    ===================================== -->

    <main class="main-wrapper">

        <div class="split-card">

            <div class="row g-0">


                <!-- LEFT -->

                <div
                    class="
                        col-12
                        col-lg-6
                        left-panel
                    "
                >

                    <div class="left-content">

                        <h1 class="left-title">

                            Verify Your Email

                        </h1>


                        <p class="left-description">

                            We've sent a verification code to
                            your registered email address.
                            Enter the code below to continue
                            resetting your password.

                        </p>

                    </div>

                </div>



                <!-- RIGHT -->

                <div
                    class="
                        col-12
                        col-lg-6
                        right-panel
                    "
                >

                    <div
                        class="otp-card"
                        id="otpContainer"
                        data-resend-remaining="<%= resendRemaining || 0 %>"
                    >


                        <!-- TITLE -->

                        <div class="text-center">

                            <h2 class="otp-title">

                                Verify Your Email

                            </h2>


                            <p class="otp-subtitle">

                                We've sent a verification code to

                            </p>


                            <div class="otp-email">

                                <%= email || "" %>

                            </div>

                        </div>



                        <!-- ERROR -->

                        <% if (
                            typeof otpError !== "undefined"
                            && otpError
                        ) { %>

                            <div class="otp-error mt-3">

                                <%= otpError %>

                            </div>

                        <% } %>



                        <!-- OTP FORM -->

                        <form
                            id="otpForm"
                            action="/forgot-password/verify-otp"
                            method="POST"
                        >

                            <!-- Hidden OTP -->

                            <input
                                type="hidden"
                                name="otp"
                                id="fullOtpInput"
                            >


                            <!-- OTP BOXES -->

                            <div class="otp-container">

                                <input
                                    type="text"
                                    class="otp-input"
                                    id="otp1"
                                    maxlength="1"
                                    inputmode="numeric"
                                    autocomplete="one-time-code"
                                    aria-label="OTP digit 1"
                                >

                                <input
                                    type="text"
                                    class="otp-input"
                                    id="otp2"
                                    maxlength="1"
                                    inputmode="numeric"
                                    autocomplete="off"
                                    aria-label="OTP digit 2"
                                >

                                <input
                                    type="text"
                                    class="otp-input"
                                    id="otp3"
                                    maxlength="1"
                                    inputmode="numeric"
                                    autocomplete="off"
                                    aria-label="OTP digit 3"
                                >

                                <input
                                    type="text"
                                    class="otp-input"
                                    id="otp4"
                                    maxlength="1"
                                    inputmode="numeric"
                                    autocomplete="off"
                                    aria-label="OTP digit 4"
                                >

                                <input
                                    type="text"
                                    class="otp-input"
                                    id="otp5"
                                    maxlength="1"
                                    inputmode="numeric"
                                    autocomplete="off"
                                    aria-label="OTP digit 5"
                                >

                                <input
                                    type="text"
                                    class="otp-input"
                                    id="otp6"
                                    maxlength="1"
                                    inputmode="numeric"
                                    autocomplete="off"
                                    aria-label="OTP digit 6"
                                >

                            </div>



                            <!-- VERIFY BUTTON -->

                            <button
                                type="submit"
                                class="verify-btn"
                            >

                                Verify OTP →

                            </button>

                        </form>



                        <!-- RESEND -->

                        <div class="resend-section">

                            <div>

                                Didn't receive the code?

                                <button
                                    type="button"
                                    id="resendBtn"
                                    class="resend-btn"
                                >
                                    Resend OTP
                                </button>

                            </div>


                            <div
                                id="timerDisplay"
                                class="timer"
                            ></div>

                        </div>



                        <!-- INFO -->

                        <div class="otp-info">

                            <i class="bi bi-clock"></i>

                            <span>

                                Your verification code will expire
                                in 5 minutes.

                            </span>

                        </div>


                    </div>

                </div>

            </div>

        </div>

    </main>



    <!-- =====================================
         FOOTER
    ===================================== -->

    <footer class="py-3 px-3 px-md-5">

        <div class="container-fluid">

            <div
                class="
                    d-flex
                    flex-column
                    flex-md-row
                    justify-content-between
                    align-items-center
                    gap-3
                "
            >

                <div class="footer-brand">

                    NAADAN BOX

                </div>


                <div
                    class="
                        d-flex
                        flex-wrap
                        justify-content-center
                        gap-4
                        footer-links
                    "
                >

                    <a href="#">
                        Privacy Policy
                    </a>

                    <a href="#">
                        Terms of Service
                    </a>

                    <a href="#">
                        Shipping Policy
                    </a>

                    <a href="#">
                        Refund Policy
                    </a>

                </div>


                <div class="footer-copy">

                    © 2024 NAADAN BOX.
                    Authentic Kerala Flavors.

                </div>

            </div>

        </div>

    </footer>



    <!-- =====================================
         JAVASCRIPT
    ===================================== -->

    <script src="/js/forgotPasswordOtp.js"></script>

</body>

</html>