<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Naadan Box</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --brand-primary-green: #1B4D2E;
            --brand-hover-green: #133821;
            --brand-gold: #B8860B;
            --background-cream: #FBF7EE;
            --card-background: #F8F3E6;
            --primary-text-dark: #222222;
            --muted-text: #6C757D;
            --border-divider-neutral: #E0DACF;
            --danger-validation-red: #DC3545;
            --input-bg-subtle: #FAF5EA;
        }

        body {
            background-color: var(--background-cream);
            color: var(--primary-text-dark);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        /* Navigation Header */
        header {
            background-color: var(--background-cream);
            border-bottom: 1px solid var(--border-divider-neutral);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            font-weight: 800;
            color: var(--brand-primary-green) !important;
            letter-spacing: 0.5px;
        }

        .nav-link {
            color: var(--primary-text-dark) !important;
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.2s ease;
        }

        .nav-link:hover,
        .nav-link.active {
            color: var(--brand-primary-green) !important;
            font-weight: 700;
        }

        .nav-icon-link {
            color: var(--primary-text-dark);
            font-size: 1.1rem;
            text-decoration: none;
            position: relative;
            transition: color 0.2s ease;
        }

        .nav-icon-link:hover {
            color: var(--brand-primary-green);
        }

        .cart-badge {
            position: absolute;
            top: -6px;
            right: -8px;
            background-color: var(--brand-gold);
            color: #ffffff;
            font-size: 0.65rem;
            font-weight: 700;
            border-radius: 50%;
            width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-nav-login {
            background-color: var(--brand-primary-green);
            color: #ffffff;
            font-weight: 600;
            padding: 0.4rem 1.2rem;
            border-radius: 8px;
            font-size: 0.85rem;
            text-decoration: none;
            transition: background-color 0.2s ease;
        }

        .btn-nav-login:hover {
            background-color: var(--brand-hover-green);
            color: #ffffff;
        }

        /* Hero Section */
        .hero-section {
            position: relative;
            min-height: 420px;
            display: flex;
            align-items: center;
            padding: 4rem 1rem;
            background-color: var(--background-cream);
            overflow: hidden;
        }

        .hero-section::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: url("/images/home/hero.png");
            background-size: cover;
            background-position: center;
            opacity: 0.70;
            -webkit-mask-image: linear-gradient(
                to bottom,
                transparent 0%,
                black 10%,
                black 88%,
                transparent 100%
            );
            mask-image: linear-gradient(
                to bottom,
                transparent 0%,
                black 10%,
                black 88%,
                transparent 100%
            );
        }

        .hero-section::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(
                90deg,
                rgba(251, 247, 238, 0.92) 0%,
                rgba(251, 247, 238, 0.70) 38%,
                rgba(251, 247, 238, 0.15) 72%,
                rgba(251, 247, 238, 0) 100%
            );
        }

        .hero-section .container {
            position: relative;
            z-index: 1;
        }

        .hero-content {
            max-width: 570px;
        }

        .hero-title {
            color: var(--brand-primary-green);
            font-weight: 800;
            font-size: clamp(2.5rem, 4.5vw, 3.8rem);
            line-height: 1.08;
            letter-spacing: -1px;
        }

        .hero-description {
            max-width: 500px;
            color: var(--muted-text);
            font-size: 1rem;
            line-height: 1.7;
        }

        .btn-brand-primary {
            background-color: var(--brand-primary-green);
            color: #ffffff;
            font-weight: 700;
            padding: 0.75rem 1.75rem;
            border-radius: 8px;
            border: none;
            text-decoration: none;
            display: inline-block;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .btn-brand-primary:hover {
            background-color: var(--brand-hover-green);
            color: #ffffff;
            transform: translateY(-1px);
        }

        /* Section Headings */
      .section-title {
    font-weight: 800;
    color: var(--brand-primary-green);
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: -0.5px;
    position: relative;
    display: inline-block;
}

.section-title::after {
    content: '';
    display: block;
    width: 42px;
    height: 3px;
    background-color: var(--brand-gold);
    margin: 0.45rem auto 0;
    border-radius: 2px;
}

        /* Category Cards */
        .category-card {
            overflow: hidden;
            border-radius: 14px;
            background-color: var(--card-background);
            border: 1px solid var(--border-divider-neutral);
            text-align: left;
            height: 100%;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .category-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(27, 77, 46, 0.08);
        }

 .category-card img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;

    -webkit-mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        black 12%,
        black 82%,
        transparent 100%
    );

    mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        black 12%,
        black 82%,
        transparent 100%
    );
}

        .category-card:hover img {
            transform: scale(1.02);
        }

        .category-info {
            padding: 1.15rem 1.25rem 1.25rem;
        }

        .category-info h4 {
            color: var(--brand-primary-green);
            font-size: 1.2rem;
            font-weight: 700;
            margin-bottom: 0.35rem;
        }

        .category-info p {
            color: var(--muted-text);
            font-size: 0.88rem;
            line-height: 1.5;
            margin-bottom: 0.75rem;
        }

        .category-link {
            color: var(--brand-primary-green);
            font-size: 0.9rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: color 0.2s ease, gap 0.2s ease;
        }

        .category-link:hover {
            color: var(--brand-hover-green);
            gap: 0.5rem;
        }

        /* Features Section */
        .feature-icon-wrapper {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background-color: #E8F3EC;
            color: var(--brand-primary-green);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
        }

        /* Testimonial Cards */
        .testimonial-card {
            background-color: var(--card-background);
            border-radius: 12px;
            padding: 1.75rem 1.5rem;
            border: 1px solid var(--border-divider-neutral);
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .star-rating {
            color: var(--brand-gold);
            font-size: 0.9rem;
        }

        /* Footer */
        footer {
            background-color: var(--card-background);
            border-top: 1px solid var(--border-divider-neutral);
            font-size: 0.85rem;
        }

        footer a {
            color: var(--primary-text-dark);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        footer a:hover {
            color: var(--brand-primary-green);
        }

        .footer-heading {
            font-weight: 700;
            font-size: 0.85rem;
            color: var(--primary-text-dark);
            margin-bottom: 0.75rem;
        }

        /* Logout Popups */
        .logout-popup-overlay {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            background: rgba(0, 0, 0, .45) !important;
            display: none !important;
            z-index: 9999 !important;
        }

        .logout-popup-overlay.show {
            display: block !important;
        }

        .logout-popup-card {
            position: fixed !important;
            top: 50% !important;
            left: 50% !important;
            width: 360px;
            max-width: calc(100vw - 32px);
            margin: 0 !important;
            padding: 1.5rem;
            background: #ffffff;
            border: 1px solid var(--border-divider-neutral);
            border-radius: 14px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .18);
            transform: translate(-50%, -50%) !important;
        }

        .logout-popup-icon {
            width: 48px;
            height: 48px;
            margin: 0 auto 1rem;
            border-radius: 50%;
            background: #E8F3EC;
            color: var(--brand-primary-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
        }

        .logout-popup-title {
            color: var(--primary-text-dark);
            font-weight: 700;
            margin-bottom: .5rem;
        }

        .logout-popup-text {
            color: var(--muted-text);
            font-size: .9rem;
            margin-bottom: 1.25rem;
        }

        .logout-popup-actions {
            display: flex;
            justify-content: center;
            gap: .75rem;
        }

        .logout-cancel-btn {
            background: transparent;
            color: var(--primary-text-dark);
            border: 1px solid var(--border-divider-neutral);
            border-radius: 8px;
            padding: .55rem 1.25rem;
            font-weight: 600;
        }

        .logout-cancel-btn:hover {
            border-color: var(--brand-primary-green);
            color: var(--brand-primary-green);
        }

        .logout-confirm-btn {
            background: var(--brand-primary-green);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            padding: .55rem 1.25rem;
            font-weight: 600;
        }

        .logout-confirm-btn:hover {
            background: var(--brand-hover-green);
        }

        .logout-confirm-btn:disabled,
        .logout-cancel-btn:disabled {
            opacity: .7;
            cursor: not-allowed;
        }
    </style>
</head>

