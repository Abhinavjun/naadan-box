<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Reset Password - Naadan Box</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    >

    <style>

        :root {
            --green: #1B4D2E;
            --green-dark: #133821;
            --gold: #C89B3C;

            --cream: #FBF7EE;
            --cream-soft: #F8F4EA;

            --white: #FFFFFF;

            --text: #1F2D26;
            --muted: #718078;

            --border: #E4DED2;
            --input: #FCFAF5;

            --danger: #DC3545;
            --success: #198754;
        }


        * {
            box-sizing: border-box;
        }


        html,
        body {
            min-height: 100%;
            margin: 0;
            padding: 0;
        }


        body {
            background: var(--cream);
            color: var(--text);

            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                "Helvetica Neue",
                Arial,
                sans-serif;
        }


        /* =========================
           HEADER
           ========================= */

        .security-header {
            height: 72px;

            display: flex;
            align-items: center;

            background: rgba(251, 247, 238, .98);

            border-bottom: 1px solid var(--border);

            position: relative;
            z-index: 10;
        }


        .security-header-inner {
            width: 100%;
            max-width: 1400px;

            margin: 0 auto;

            padding: 0 3rem;
        }


        .brand {
            color: var(--green);

            font-size: 1.35rem;
            font-weight: 800;

            letter-spacing: .7px;

            text-decoration: none;
        }


        .brand:hover {
            color: var(--green);
        }


        .security-label {
            display: flex;
            align-items: center;

            gap: .5rem;

            color: var(--muted);

            font-size: .72rem;
            font-weight: 600;

            letter-spacing: .4px;
        }


        .security-label i {
            color: var(--green);

            font-size: .9rem;
        }


        /* =========================
           MAIN PAGE
           ========================= */

        .reset-page {
            position: relative;

            min-height: calc(100vh - 72px);

            display: flex;
            flex-direction: column;

            overflow: hidden;
        }


        .page-content {
            position: relative;

            z-index: 2;

            flex: 1;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 3rem 1.25rem 3.5rem;
        }


        .reset-content {
            position: relative;

            z-index: 3;

            width: 100%;
            max-width: 510px;

            margin: 0 auto;
        }


        /* =========================
           BANANA LEAF DECORATIONS
           ========================= */

        .banana-leaf {
            position: absolute;

            pointer-events: none;

            z-index: 0;

            opacity: .065;
        }


        .banana-leaf svg {
            width: 100%;
            height: 100%;

            display: block;
        }


        .leaf-top-left {
            width: 340px;
            height: 340px;

            top: 15px;
            left: -120px;

            transform: rotate(-12deg);
        }


        .leaf-bottom-right {
            width: 410px;
            height: 410px;

            right: -150px;
            bottom: -150px;

            transform: rotate(12deg);
        }


        .leaf-middle-right {
            width: 190px;
            height: 190px;

            top: 18%;
            right: 8%;

            opacity: .025;

            transform: rotate(150deg);
        }


        .leaf-bottom-left {
            width: 160px;
            height: 160px;

            bottom: 5%;
            left: 13%;

            opacity: .025;

            transform: rotate(-35deg);
        }


        /* =========================
           HEADING
           ========================= */

        .page-kicker {
            margin-bottom: .45rem;

            color: var(--gold);

            text-align: center;

            font-size: .68rem;
            font-weight: 800;

            letter-spacing: 2px;

            text-transform: uppercase;
        }


        .page-title {
            margin: 0;

            color: var(--green);

            text-align: center;

            font-size: 2rem;
            font-weight: 800;

            letter-spacing: -.5px;
        }


        .page-description {
            max-width: 450px;

            margin: .65rem auto 0;

            color: var(--muted);

            text-align: center;

            font-size: .84rem;

            line-height: 1.6;
        }


        .heading-decoration {
            display: flex;

            align-items: center;
            justify-content: center;

            gap: 7px;

            margin: .9rem 0 1.7rem;
        }


        .heading-decoration span {
            display: block;

            width: 32px;
            height: 2px;

            background: var(--gold);

            border-radius: 3px;
        }


        .heading-decoration span:nth-child(2) {
            width: 7px;
            height: 7px;

            transform: rotate(45deg);
        }


        /* =========================
           RESET CARD
           ========================= */

        .reset-card {
            position: relative;

            width: 100%;

            padding: 1.9rem;

            background: rgba(255, 255, 255, .97);

            border: 1px solid rgba(27, 77, 46, .09);

            border-radius: 17px;

            box-shadow:
                0 18px 45px rgba(27, 77, 46, .08),
                0 3px 12px rgba(27, 77, 46, .035);

            overflow: hidden;
        }


        .reset-card::before {
            content: "";

            position: absolute;

            top: 0;
            left: 0;

            width: 100%;
            height: 3px;

            background:
                linear-gradient(
                    90deg,
                    var(--green),
                    var(--gold),
                    var(--green)
                );
        }


        .reset-card-header {
            display: flex;

            align-items: center;

            gap: .85rem;

            margin-bottom: 1.5rem;
        }


        .reset-icon {
            width: 45px;
            height: 45px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            background: rgba(27, 77, 46, .07);

            border: 1px solid rgba(27, 77, 46, .1);

            border-radius: 12px;

            color: var(--green);

            font-size: 1.15rem;
        }


        .reset-card-title {
            margin: 0 0 .15rem;

            color: var(--green);

            font-size: .98rem;
            font-weight: 800;
        }


        .reset-card-subtitle {
            margin: 0;

            color: var(--muted);

            font-size: .73rem;

            line-height: 1.45;
        }


        /* =========================
           FORM
           ========================= */

        .form-label-custom {
            display: block;

            margin-bottom: .5rem;

            color: var(--text);

            font-size: .7rem;
            font-weight: 800;

            letter-spacing: .65px;

            text-transform: uppercase;
        }


        .password-field-wrapper {
            position: relative;
        }


        .form-control-custom {
            width: 100%;
            height: 46px;

            padding: .65rem 3rem .65rem .9rem;

            background: var(--input);

            border: 1px solid var(--border);

            border-radius: 9px;

            color: var(--text);

            font-size: .83rem;

            transition:
                border-color .2s ease,
                box-shadow .2s ease,
                background .2s ease;
        }


        .form-control-custom::placeholder {
            color: #9A9B96;
        }


        .form-control-custom:hover {
            border-color: #CFC8BA;
        }


        .form-control-custom:focus {
            background: #fff;

            border-color: var(--green);

            box-shadow:
                0 0 0 .18rem rgba(27, 77, 46, .09);

            outline: none;
        }


        .password-toggle-btn {
            position: absolute;

            top: 50%;
            right: 13px;

            width: 30px;
            height: 30px;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 0;

            background: transparent;

            border: 0;

            color: var(--muted);

            cursor: pointer;

            transform: translateY(-50%);

            font-size: .95rem;
        }


        .password-toggle-btn:hover {
            color: var(--green);
        }


        /* =========================
           PASSWORD REQUIREMENTS
           ========================= */

        .password-requirements {
            margin-top: .65rem;

            padding: .75rem .8rem;

            background: var(--cream-soft);

            border: 1px solid var(--border);

            border-radius: 9px;
        }


        .password-rule {
            display: flex;

            align-items: center;

            gap: .45rem;

            margin-bottom: .32rem;

            font-size: .7rem;

            line-height: 1.4;
        }


        .password-rule:last-child {
            margin-bottom: 0;
        }


        .password-rule i {
            flex-shrink: 0;

            font-size: .72rem;
        }


        .password-rule.text-danger {
            color: var(--danger) !important;
        }


        .password-rule.text-success {
            color: var(--success) !important;
        }


        .password-message {
            margin-top: .45rem;

            font-size: .7rem;
            font-weight: 600;
        }


        .password-message.text-danger {
            color: var(--danger) !important;
        }


        .password-message.text-success {
            color: var(--success) !important;
        }


        /* =========================
           UPDATE BUTTON
           ========================= */

        .btn-brand {
            width: 100%;

            min-height: 45px;

            margin-top: .45rem;

            display: inline-flex;

            align-items: center;
            justify-content: center;

            background: var(--green);

            border: 1px solid var(--green);

            border-radius: 9px;

            color: #fff;

            font-size: .8rem;
            font-weight: 700;

            transition:
                background .2s ease,
                border-color .2s ease,
                transform .2s ease,
                box-shadow .2s ease;
        }


        .btn-brand:hover {
            background: var(--green-dark);

            border-color: var(--green-dark);

            color: #fff;

            transform: translateY(-1px);

            box-shadow:
                0 7px 16px rgba(27, 77, 46, .15);
        }


        .btn-brand:disabled {
            opacity: .7;

            cursor: not-allowed;

            transform: none;

            box-shadow: none;
        }


        /* =========================
           BACK TO LOGIN
           ========================= */

        .back-login {
            display: inline-flex;

            align-items: center;

            gap: .25rem;

            color: var(--green);

            font-size: .72rem;
            font-weight: 700;

            text-decoration: none;
        }


        .back-login:hover {
            color: var(--green-dark);

            text-decoration: underline;
        }


        /* =========================
           SECURITY NOTE
           ========================= */

        .security-note {
            display: flex;

            align-items: flex-start;

            gap: .7rem;

            margin-top: .9rem;

            padding: .85rem 1rem;

            background:
                linear-gradient(
                    135deg,
                    rgba(255, 248, 233, .96),
                    rgba(251, 247, 238, .96)
                );

            border: 1px solid rgba(200, 155, 60, .24);

            border-radius: 11px;
        }


        .security-note-icon {
            width: 31px;
            height: 31px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            background: rgba(27, 77, 46, .08);

            border-radius: 8px;

            color: var(--green);

            font-size: .82rem;
        }


        .security-note-title {
            margin: 0 0 .15rem;

            color: var(--green);

            font-size: .7rem;
            font-weight: 800;
        }


        .security-note-text {
            margin: 0;

            color: var(--muted);

            font-size: .65rem;

            line-height: 1.5;
        }


        /* =========================
           FOOTER
           ========================= */

        .security-footer {
            position: relative;

            padding: 1rem 1.25rem;

            background: var(--cream-soft);

            border-top: 1px solid var(--border);

            text-align: center;
        }


        .security-footer::before {
            content: "";

            position: absolute;

            top: 0;
            left: 50%;

            width: 100px;
            height: 2px;

            background: var(--gold);

            transform: translateX(-50%);

            opacity: .65;
        }


        .footer-brand {
            margin-bottom: .25rem;

            color: var(--green);

            font-size: .82rem;
            font-weight: 800;

            letter-spacing: .6px;
        }


        .footer-text {
            margin: 0;

            color: var(--muted);

            font-size: .65rem;
        }


        .footer-links {
            display: flex;

            align-items: center;
            justify-content: center;

            gap: 1rem;

            margin-top: .45rem;
        }


        .footer-links a {
            color: var(--muted);

            font-size: .63rem;

            text-decoration: none;

            transition: color .2s ease;
        }


        .footer-links a:hover {
            color: var(--green);
        }


        /* =========================
           POPUPS
           ========================= */

        .popup-overlay {
            position: fixed !important;

            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;

            width: 100vw !important;
            height: 100vh !important;

            display: none !important;

            background: rgba(20, 31, 25, .46) !important;

            z-index: 9999 !important;
        }


        .popup-overlay.show {
            display: block !important;
        }


        .popup-card {
            position: fixed !important;

            top: 50% !important;
            left: 50% !important;

            width: 370px;

            max-width: calc(100vw - 32px);

            margin: 0 !important;

            padding: 1.6rem;

            background: #fff;

            border: 1px solid var(--border);

            border-radius: 15px;

            text-align: center;

            box-shadow:
                0 20px 55px rgba(0, 0, 0, .18);

            transform: translate(-50%, -50%) !important;

            animation: popupShow .2s ease;
        }


        @keyframes popupShow {

            from {
                opacity: 0;

                transform:
                    translate(-50%, -50%)
                    scale(.95) !important;
            }


            to {
                opacity: 1;

                transform:
                    translate(-50%, -50%)
                    scale(1) !important;
            }

        }


        .popup-icon {
            width: 48px;
            height: 48px;

            margin: 0 auto .8rem !important;

            display: flex;
            align-items: center;
            justify-content: center;

            background: rgba(27, 77, 46, .09);

            border-radius: 50%;

            color: var(--green);

            font-size: 1.3rem;
        }


        .popup-title {
            width: 100%;

            margin: 0 0 .45rem;

            color: var(--green);

            text-align: center !important;

            font-size: 1.08rem;
            font-weight: 800;
        }


        .popup-message {
            width: 100%;

            margin: 0 0 1.2rem;

            color: var(--muted);

            text-align: center !important;

            font-size: .82rem;

            line-height: 1.5;
        }


        .popup-actions {
            display: flex;

            align-items: center;
            justify-content: center !important;

            gap: .6rem;

            width: 100%;
        }


        .popup-btn {
            min-height: 37px;

            padding: .5rem 1.05rem;

            border: 0;

            border-radius: 8px;

            font-size: .76rem;
            font-weight: 700;

            cursor: pointer;

            transition:
                background .2s ease,
                transform .2s ease;
        }


        .popup-btn:hover {
            transform: translateY(-1px);
        }


        .popup-btn-cancel {
            background: #E9E5DC;

            color: var(--text);
        }


        .popup-btn-cancel:hover {
            background: #DDD8CD;
        }


        .popup-btn-confirm,
        .popup-btn-success {
            background: var(--green);

            color: #fff;
        }


        .popup-btn-confirm:hover,
        .popup-btn-success:hover {
            background: var(--green-dark);

            color: #fff;
        }


        .popup-btn-success {
            min-width: 105px;
        }


        .popup-btn:disabled {
            opacity: .7;

            cursor: not-allowed;

            transform: none;
        }


        /* =========================
           RESPONSIVE
           ========================= */

        @media (max-width: 767.98px) {

            .security-header {
                height: 64px;
            }


            .security-header-inner {
                padding: 0 1.25rem;
            }


            .brand {
                font-size: 1.15rem;
            }


            .security-label {
                font-size: .62rem;
            }


            .page-content {
                padding: 2rem 1rem 2.5rem;
            }


            .page-title {
                font-size: 1.65rem;
            }


            .page-description {
                font-size: .79rem;
            }


            .reset-card {
                padding: 1.5rem 1.2rem;
            }


            .leaf-top-left {
                width: 230px;
                height: 230px;

                left: -105px;
            }


            .leaf-bottom-right {
                width: 270px;
                height: 270px;

                right: -120px;
                bottom: -80px;
            }


            .leaf-middle-right,
            .leaf-bottom-left {
                display: none;
            }

        }


        @media (max-width: 480px) {

            .security-label {
                display: none;
            }


            .page-title {
                font-size: 1.5rem;
            }


            .page-description {
                font-size: .75rem;
            }


            .reset-card {
                padding: 1.35rem 1rem;
            }


            .password-rule {
                font-size: .67rem;
            }


            .security-note {
                padding: .8rem;
            }


            .footer-links {
                gap: .7rem;
            }

        }

    </style>

</head>


<body>


    <!-- =========================
         MINIMAL SECURITY HEADER
         ========================= -->

    <header class="security-header">

        <div class="security-header-inner">

            <div class="d-flex justify-content-between align-items-center">

                <a
                    href="/"
                    class="brand"
                >
                    NAADAN BOX
                </a>


                <div class="security-label">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Secure Password Recovery
                    </span>

                </div>

            </div>

        </div>

    </header>


    <!-- =========================
         MAIN PAGE
         ========================= -->

    <main class="reset-page">


        <!-- =========================
             BANANA LEAF TOP LEFT
             ========================= -->

        <div class="banana-leaf leaf-top-left">

            <svg
                viewBox="0 0 400 400"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
            >

                <path
                    d="
                        M42 344
                        C75 267 116 178 214 101
                        C270 57 330 35 373 27
                        C366 74 348 132 315 184
                        C259 272 171 329 42 344
                        Z
                    "
                    fill="#1B4D2E"
                />

                <path
                    d="
                        M48 340
                        C129 292 205 218 351 48
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="3"
                    stroke-linecap="round"
                />

                <path
                    d="
                        M117 293
                        C108 250 111 214 123 180
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="1.4"
                    opacity=".7"
                />

                <path
                    d="
                        M166 260
                        C159 214 165 174 181 139
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="1.4"
                    opacity=".7"
                />

                <path
                    d="
                        M220 215
                        C220 176 232 136 249 106
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="1.4"
                    opacity=".7"
                />

            </svg>

        </div>


        <!-- =========================
             SMALL LEAF
             ========================= -->

        <div class="banana-leaf leaf-middle-right">

            <svg
                viewBox="0 0 400 400"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
            >

                <path
                    d="
                        M42 344
                        C75 267 116 178 214 101
                        C270 57 330 35 373 27
                        C366 74 348 132 315 184
                        C259 272 171 329 42 344
                        Z
                    "
                    fill="#1B4D2E"
                />

                <path
                    d="
                        M48 340
                        C129 292 205 218 351 48
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="3"
                    stroke-linecap="round"
                />

            </svg>

        </div>


        <!-- =========================
             BANANA LEAF BOTTOM RIGHT
             ========================= -->

        <div class="banana-leaf leaf-bottom-right">

            <svg
                viewBox="0 0 400 400"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
            >

                <path
                    d="
                        M42 344
                        C75 267 116 178 214 101
                        C270 57 330 35 373 27
                        C366 74 348 132 315 184
                        C259 272 171 329 42 344
                        Z
                    "
                    fill="#1B4D2E"
                />

                <path
                    d="
                        M48 340
                        C129 292 205 218 351 48
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="3"
                    stroke-linecap="round"
                />

                <path
                    d="
                        M117 293
                        C108 250 111 214 123 180
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="1.4"
                    opacity=".7"
                />

                <path
                    d="
                        M166 260
                        C159 214 165 174 181 139
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="1.4"
                    opacity=".7"
                />

                <path
                    d="
                        M220 215
                        C220 176 232 136 249 106
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="1.4"
                    opacity=".7"
                />

            </svg>

        </div>


        <!-- =========================
             SMALL BOTTOM LEAF
             ========================= -->

        <div class="banana-leaf leaf-bottom-left">

            <svg
                viewBox="0 0 400 400"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
            >

                <path
                    d="
                        M42 344
                        C75 267 116 178 214 101
                        C270 57 330 35 373 27
                        C366 74 348 132 315 184
                        C259 272 171 329 42 344
                        Z
                    "
                    fill="#1B4D2E"
                />

                <path
                    d="
                        M48 340
                        C129 292 205 218 351 48
                    "
                    fill="none"
                    stroke="#C89B3C"
                    stroke-width="3"
                    stroke-linecap="round"
                />

            </svg>

        </div>


        <div class="page-content">


            <div class="reset-content">


                <!-- =========================
                     HEADING
                     ========================= -->

                <div class="page-kicker">
                    Account Security
                </div>


                <h1 class="page-title">
                    Create a New Password
                </h1>


                <p class="page-description">

                    Choose a strong password to keep your
                    Naadan Box account secure.

                </p>


                <div class="heading-decoration">

                    <span></span>

                    <span></span>

                    <span></span>

                </div>


                <!-- =========================
                     RESET CARD
                     ========================= -->

                <div class="reset-card">


                    <div class="reset-card-header">

                        <div class="reset-icon">

                            <i class="bi bi-shield-lock"></i>

                        </div>


                        <div>

                            <h2 class="reset-card-title">
                                Reset Password
                            </h2>


                            <p class="reset-card-subtitle">

                                Enter and confirm your new password below.

                            </p>

                        </div>

                    </div>


                    <!-- =========================
                         RESET FORM
                         ========================= -->

                 <form
    id="resetPasswordForm"
    action="<%= resetUrl %>"
    data-reset-url="<%= resetUrl %>"
>


                        <!-- NEW PASSWORD -->

                        <div class="mb-3">

                            <label
                                for="password"
                                class="form-label-custom"
                            >
                                New Password
                            </label>


                            <div class="password-field-wrapper">

                                <input
                                    type="password"
                                    class="form-control form-control-custom"
                                    id="password"
                                    name="password"
                                    autocomplete="new-password"
                                    placeholder="Create a strong password"
                                    required
                                >


                                <button
                                    type="button"
                                    class="password-toggle-btn"
                                    id="passwordToggle"
                                    aria-label="Show password"
                                >

                                    <i class="bi bi-eye"></i>

                                </button>

                            </div>


                            <!-- PASSWORD REQUIREMENTS -->

                            <div
                                id="passwordRequirements"
                                class="password-requirements d-none"
                            >

                                <div
                                    id="rule-length"
                                    class="password-rule text-danger"
                                >

                                    <i class="bi bi-x-circle"></i>

                                    <span>
                                        Minimum 8 characters
                                    </span>

                                </div>


                                <div
                                    id="rule-uppercase"
                                    class="password-rule text-danger"
                                >

                                    <i class="bi bi-x-circle"></i>

                                    <span>
                                        One uppercase letter
                                    </span>

                                </div>


                                <div
                                    id="rule-lowercase"
                                    class="password-rule text-danger"
                                >

                                    <i class="bi bi-x-circle"></i>

                                    <span>
                                        One lowercase letter
                                    </span>

                                </div>


                                <div
                                    id="rule-number"
                                    class="password-rule text-danger"
                                >

                                    <i class="bi bi-x-circle"></i>

                                    <span>
                                        One number
                                    </span>

                                </div>


                                <div
                                    id="rule-special"
                                    class="password-rule text-danger"
                                >

                                    <i class="bi bi-x-circle"></i>

                                    <span>
                                        One special character
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="mb-3">

                            <label
                                for="confirmPassword"
                                class="form-label-custom"
                            >
                                Confirm Password
                            </label>


                            <div class="password-field-wrapper">

                                <input
                                    type="password"
                                    class="form-control form-control-custom"
                                    id="confirmPassword"
                                    name="confirmPassword"
                                    autocomplete="new-password"
                                    placeholder="Re-enter your password"
                                    required
                                >


                                <button
                                    type="button"
                                    class="password-toggle-btn"
                                    id="confirmPasswordToggle"
                                    aria-label="Show password"
                                >

                                    <i class="bi bi-eye"></i>

                                </button>

                            </div>


                            <div
                                id="passwordMatchMessage"
                                class="password-message d-none"
                            ></div>

                        </div>


                        <!-- UPDATE PASSWORD -->

                        <button
                            type="submit"
                            class="btn btn-brand"
                            id="updatePasswordButton"
                        >

                            <i class="bi bi-shield-check me-2"></i>

                            Update Password

                        </button>


                    </form>


                    <!-- BACK TO LOGIN -->

                    <div class="text-center mt-3">

                        <a
                            href="/login"
                            class="back-login"
                        >

                            <i class="bi bi-arrow-left"></i>

                            Back to Login

                        </a>

                    </div>


                </div>


                <!-- =========================
                     SECURITY NOTE
                     ========================= -->

                <div class="security-note">


                    <div class="security-note-icon">

                        <i class="bi bi-shield-lock-fill"></i>

                    </div>


                    <div>

                        <p class="security-note-title">
                            Keep your account protected
                        </p>


                        <p class="security-note-text">

                            Use a password that is unique to your
                            Naadan Box account and avoid sharing it
                            with anyone.

                        </p>

                    </div>


                </div>


            </div>

        </div>

    </main>


    <!-- =========================
         MINIMAL FOOTER
         ========================= -->

    <footer class="security-footer">


        <div class="footer-brand">
            NAADAN BOX
        </div>


        <p class="footer-text">
            Authentic Kerala flavors, made for home.
        </p>


        <div class="footer-links">

            <a href="/privacy">
                Privacy Policy
            </a>


            <a href="/terms">
                Terms of Service
            </a>


            <a href="/">
                Back to Home
            </a>

        </div>


    </footer>


    <!-- =========================
         CONFIRMATION POPUP
         ========================= -->

    <div
        class="popup-overlay"
        id="confirmModal"
    >

        <div class="popup-card">


            <div class="popup-icon">

                <i class="bi bi-shield-check"></i>

            </div>


            <h5 class="popup-title">
                Update Password?
            </h5>


            <p class="popup-message">

                Are you sure you want to update
                your password?

            </p>


            <div class="popup-actions">


                <button
                    type="button"
                    class="popup-btn popup-btn-cancel"
                    id="cancelUpdatePassword"
                >
                    Cancel
                </button>


                <button
                    type="button"
                    class="popup-btn popup-btn-confirm"
                    id="confirmUpdatePassword"
                >
                    Update Password
                </button>


            </div>

        </div>

    </div>


    <!-- =========================
         SUCCESS POPUP
         ========================= -->

    <div
        class="popup-overlay"
        id="successModal"
    >

        <div class="popup-card">


            <div class="popup-icon">

                <i class="bi bi-check-lg"></i>

            </div>


            <h5 class="popup-title">
                Password Updated
            </h5>


            <p class="popup-message">

                Your password has been updated successfully.

            </p>


            <div class="popup-actions">

                <button
                    type="button"
                    class="popup-btn popup-btn-success"
                    id="continueToLogin"
                >
                    Continue
                </button>

            </div>

        </div>

    </div>


    <!-- =========================
         ERROR POPUP
         ========================= -->

    <div
        class="popup-overlay"
        id="errorModal"
    >

        <div class="popup-card">


            <div class="popup-icon">

                <i class="bi bi-exclamation-lg"></i>

            </div>


            <h5 class="popup-title">
                Unable to Update
            </h5>


            <p
                class="popup-message"
                id="errorMessage"
            >
                Unable to update your password.
                Please try again.
            </p>


            <div class="popup-actions">

                <button
                    type="button"
                    class="popup-btn popup-btn-success"
                    id="closeError"
                >
                    Okay
                </button>

            </div>

        </div>

    </div>


    <!-- EXISTING JAVASCRIPT -->

    <script src="/js/resetPassword.js"></script>


</body>

</html>