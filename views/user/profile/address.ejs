                                </option>

                                <option value="Lakshadweep">
                                    Lakshadweep
                                </option>

                                <option value="Andaman and Nicobar Islands">
                                    Andaman and Nicobar Islands
                                </option>

                            </select>

                            <small
                                id="addressStateError"
                                class="address-error"
                            ></small>

                        </div>

                    </div>

                </div>


                <!-- =================================
                     ADDITIONAL DETAILS
                     ================================= -->

                <div class="address-form-section">

                    <div class="address-form-section-title">
                        Additional Details
                    </div>

                    <div class="row address-form-row">

                        <!-- LANDMARK -->

                        <div class="col-12 col-md-6">

                            <label
                                for="addressLandmark"
                                class="address-form-label"
                            >
                                Landmark
                                <span class="text-muted">
                                    (Optional)
                                </span>
                            </label>

                            <input
                                type="text"
                                id="addressLandmark"
                                class="address-form-input"
                                maxlength="100"
                                placeholder="Nearby landmark"
                            >

                        </div>


                        <!-- ADDRESS TYPE -->

                        <div class="col-12 col-md-3">

                            <label
                                for="addressType"
                                class="address-form-label"
                            >
                                Address Type
                            </label>

                            <select
                                id="addressType"
                                class="address-form-select"
                                required
                            >

                                <option value="Home">
                                    Home
                                </option>

                                <option value="Work">
                                    Work
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                        </div>


