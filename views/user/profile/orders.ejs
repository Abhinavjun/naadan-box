<script>
document.addEventListener("DOMContentLoaded", () => {

    const searchInput =
        document.getElementById("orderSearch");

    const statusFilter =
        document.getElementById("orderStatusFilter");

    const sortFilter =
        document.getElementById("orderSort");

    const ordersList =
        document.getElementById("ordersList");

    const emptyMessage =
        document.getElementById("ordersEmpty");


    function filterOrders() {

        const searchValue =
            searchInput
                ? searchInput.value.toLowerCase().trim()
                : "";

        const statusValue =
            statusFilter
                ? statusFilter.value
                : "all";

        const orders =
            document.querySelectorAll(".order-card");

        let visibleOrders = 0;


        orders.forEach(order => {

            const orderSearch =
                (order.dataset.search || "").toLowerCase();

            const orderStatus =
                order.dataset.status || "";

            const matchesSearch =
                orderSearch.includes(searchValue);

            const matchesStatus =
                statusValue === "all" ||
                orderStatus === statusValue;


            if(matchesSearch && matchesStatus){

                order.style.display = "flex";

                visibleOrders++;

            }else{

                order.style.display = "none";

            }

        });


        if(visibleOrders === 0){

            emptyMessage.style.display = "block";

        }else{

            emptyMessage.style.display = "none";

        }

    }


    function sortOrders() {

        if(!ordersList || !sortFilter){
            return;
        }

        const orders =
            Array.from(
                ordersList.querySelectorAll(".order-card")
            );

        const sortValue =
            sortFilter.value;


        orders.sort((firstOrder, secondOrder) => {

            const firstDate =
                new Date(firstOrder.dataset.date);

            const secondDate =
                new Date(secondOrder.dataset.date);


            if(sortValue === "oldest"){

                return firstDate - secondDate;

            }

            return secondDate - firstDate;

        });


        orders.forEach(order => {

            ordersList.appendChild(order);

        });

    }


    function updateOrders(){

        sortOrders();
        filterOrders();

    }


    if(searchInput){

        searchInput.addEventListener(
            "input",
            filterOrders
        );

    }


    if(statusFilter){

        statusFilter.addEventListener(
            "change",
            filterOrders
        );

    }


    if(sortFilter){

        sortFilter.addEventListener(
            "change",
            updateOrders
        );

    }


    updateOrders();

});
</script>