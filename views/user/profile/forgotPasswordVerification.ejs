<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Password Reset - Naadan Box</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        :root {
            --brand-primary-green: #1B4D2E;
            --brand-hover-green: #133821;
            --brand-gold: #C89B3C;
            --background-cream: #FBF7EE;
            --card-background: #F8F3E6;
            --primary-text-dark: #1F2D26;
            --muted-text: #718078;
            --border-neutral: #E2DCCF;
            --soft-green: #E8F3EC;
            --danger-red: #DC3545;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            background: var(--background-cream);
            color: var(--primary-text-dark);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            position: relative;
            overflow-x: hidden;
        }

        /* =========================
           SECURITY HEADER
        ========================= */

        .security-header {
            height: 74px;
            background: rgba(251, 247, 238, 0.96);
            border-bottom: 1px solid rgba(27, 77, 46, 0.10);
            display: flex;
            align-items: center;
            position: relative;
            z-index: 10;
        }

        .security-header-inner {
            width: 100%;
            max-width: 1180px;
            margin: 0 auto;
            padding: 0 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-logo {
            color: var(--brand-primary-green);
            text-decoration: none;
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: .6px;
        }

        .security-label {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #65736C;
            font-size: .76rem;
            font-weight: 500;
        }

        .security-label i {
            color: var(--brand-primary-green);
            font-size: .95rem;
        }

        /* =========================
           DECORATIVE LEAVES
        ========================= */

        .leaf-decoration {
            position: fixed;
            pointer-events: none;
            opacity: .38;
            z-index: 0;
        }

        .leaf-left {
            width: 175px;
            height: 280px;
            left: -55px;
            top: 125px;
            transform: rotate(-18deg);
        }

        .leaf-right {
            width: 130px;
            height: 225px;
            right: -35px;
            top: 215px;
            transform: rotate(18deg);
        }

        .leaf-bottom-left {
            width: 105px;
            height: 175px;
            left: 170px;
            bottom: 55px;
            transform: rotate(-25deg);
            opacity: .20;
        }

        .leaf-bottom-right {
            width: 165px;
            height: 250px;
            right: -35px;
            bottom: -45px;
            transform: rotate(25deg);
            opacity: .22;
        }

        /* =========================
           MAIN PAGE
        ========================= */

        .verification-page {
            min-height: calc(100vh - 74px);
            padding: 3.5rem 1.25rem 2.5rem;
            position: relative;
            z-index: 1;
        }

        .page-heading {
            text-align: center;
            max-width: 650px;
            margin: 0 auto 1.8rem;
        }

        .page-eyebrow {
            margin: 0 0 .45rem;
            color: var(--brand-gold);
            font-size: .72rem;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .page-title {
            margin: 0;
            color: var(--brand-primary-green);
            font-size: 1.85rem;
            font-weight: 800;
            letter-spacing: -.4px;
        }

        .page-description {
            max-width: 570px;
            margin: .55rem auto 0;
            color: var(--muted-text);
            font-size: .82rem;
            line-height: 1.55;
        }

        .heading-decoration {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            margin-top: .8rem;
        }

        .heading-decoration span {
            display: block;
            width: 32px;
            height: 1.5px;
            background: var(--brand-gold);
        }

        .heading-decoration span:nth-child(2) {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        /* =========================
           OTP CARD
        ========================= */

        .verification-card {
            width: 100%;
            max-width: 510px;
            margin: 0 auto;
            background: #fff;
            border: 1px solid rgba(27, 77, 46, .09);
            border-top: 3px solid var(--brand-primary-green);
            border-radius: 15px;
            padding: 1.9rem 2rem 1.7rem;
            box-shadow: 0 12px 30px rgba(27, 77, 46, .07);
        }

        .verification-icon {
            width: 50px;
            height: 50px;
            margin: 0 auto .9rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--soft-green);
            color: var(--brand-primary-green);
            border-radius: 13px;
            font-size: 1.35rem;
        }

        .verification-title {
            margin: 0 0 .35rem;
            color: var(--brand-primary-green);
            font-size: 1.28rem;
            font-weight: 800;
        }

        .verification-description {
            max-width: 365px;
            margin: 0 auto 1.45rem;
            color: var(--muted-text);
            font-size: .78rem;
            line-height: 1.55;
        }

        /* =========================
           OTP INPUTS
        ========================= */

        .otp-inputs {
            display: flex;
            justify-content: center;
            gap: .65rem;
            margin-bottom: 1.35rem;
        }

        .otp-input {
            width: 48px;
            height: 54px;
            padding: 0;
            background: #FCFAF5;
            border: 1px solid #DDD8CD;
            border-radius: 9px;
            text-align: center;
            font-size: 1.18rem;
            font-weight: 700;
            color: var(--brand-primary-green);
            outline: none;
            transition: all .2s ease;
        }

        .otp-input:hover {
            border-color: rgba(27, 77, 46, .35);
        }

        .otp-input:focus {
            background: #fff;
            border-color: var(--brand-primary-green);
            box-shadow: 0 0 0 3px rgba(27, 77, 46, .09);
        }

        /* =========================
           VERIFY BUTTON
        ========================= */

        .verify-btn {
            width: 100%;
            height: 43px;
            border: none;
            border-radius: 8px;
            background: var(--brand-primary-green);
            color: #fff;
            font-size: .76rem;
            font-weight: 700;
            letter-spacing: .15px;
            cursor: pointer;
            transition: background .2s ease, transform .2s ease;
            box-shadow: 0 4px 10px rgba(27, 77, 46, .12);
        }

        .verify-btn:hover {
            background: var(--brand-hover-green);
            transform: translateY(-1px);
        }

        .verify-btn:disabled {
            opacity: .7;
            cursor: not-allowed;
            transform: none;
        }

        /* =========================
           RESEND
        ========================= */

        .resend-section {
            margin-top: 1.3rem;
            text-align: center;
            color: var(--muted-text);
            font-size: .74rem;
            font-weight: 500;
        }

        .resend-link {
            color: var(--brand-gold);
            font-weight: 700;
            text-decoration: none;
            transition: color .2s ease;
        }

        .resend-link:hover {
            color: #9C751E;
        }

        .resend-link.disabled {
            pointer-events: none;
            opacity: .55;
        }

        /* =========================
           BOTTOM LINKS
        ========================= */

        .bottom-links {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .65rem;
            margin-top: 1.15rem;
            padding-top: 1rem;
            border-top: 1px solid #ECE7DC;
            font-size: .73rem;
            font-weight: 700;
        }

        .bottom-links a {
            color: var(--brand-primary-green);
            text-decoration: none;
            transition: color .2s ease;
        }

        .bottom-links a:hover {
            color: var(--brand-hover-green);
        }

        .bottom-divider {
            color: #C8C0B4;
        }

        /* =========================
           SECURITY INFORMATION
        ========================= */

        .verification-info {
            width: 100%;
            max-width: 760px;
            margin: 1.5rem auto 0;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: .75rem;
        }

        .info-item {
            min-height: 78px;
            display: flex;
            align-items: flex-start;
            gap: .65rem;
            padding: .85rem .9rem;
            background: rgba(248, 243, 230, .72);
            border: 1px solid var(--border-neutral);
            border-radius: 10px;
        }

        .info-icon {
            width: 30px;
            height: 30px;
            min-width: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #E4F2E9;
            color: var(--brand-primary-green);
            border-radius: 50%;
            font-size: .78rem;
        }

        .info-item h6 {
            margin: .05rem 0 .2rem;
            color: var(--brand-primary-green);
            font-size: .68rem;
            font-weight: 800;
        }

        .info-item p {
            margin: 0;
            color: var(--muted-text);
            font-size: .62rem;
            line-height: 1.45;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            background: var(--card-background);
            border-top: 1px solid var(--border-neutral);
            position: relative;
            z-index: 2;
        }

        .footer-inner {
            max-width: 1180px;
            margin: 0 auto;
            padding: 13px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .footer-brand {
            color: var(--brand-primary-green);
            font-size: .74rem;
            font-weight: 800;
            letter-spacing: .4px;
        }

        .footer-links {
            display: flex;
            align-items: center;
            gap: 1.1rem;
        }

        .footer-links a {
            color: #68736D;
            font-size: .68rem;
            text-decoration: none;
        }

        .footer-links a:hover {
            color: var(--brand-primary-green);
        }

        .footer-copy {
            color: #8A908C;
            font-size: .65rem;
        }

        /* =========================
           POPUPS
        ========================= */

        .custom-popup-overlay {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(20, 35, 27, .28);
            backdrop-filter: blur(3px);
            z-index: 3000;
            padding: 1rem;
        }

        .custom-popup {
            width: 100%;
            max-width: 350px;
            background: #fff;
            border: 1px solid rgba(27, 77, 46, .10);
            border-top: 3px solid var(--brand-primary-green);
            border-radius: 12px;
            padding: 1.45rem 1.5rem;
            text-align: center;
            box-shadow: 0 18px 45px rgba(0, 0, 0, .14);
        }

        .popup-icon {
            width: 42px;
            height: 42px;
            margin: 0 auto .7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--soft-green);
            color: var(--brand-primary-green);
            border-radius: 50%;
            font-size: 1rem;
        }

        .popup-title {
            margin: 0 0 .35rem;
            color: var(--brand-primary-green);
            font-size: .98rem;
            font-weight: 800;
        }

        .popup-message {
            max-width: 280px;
            margin: 0 auto;
            color: var(--muted-text);
            font-size: .72rem;
            line-height: 1.5;
        }

        .popup-actions {
            display: flex;
            justify-content: center;
            gap: .6rem;
            margin-top: 1rem;
        }

        .popup-btn {
            min-width: 88px;
            height: 35px;
            padding: 0 .9rem;
            border-radius: 7px;
            font-size: .7rem;
            font-weight: 700;
            cursor: pointer;
        }

        .popup-cancel {
            background: #fff;
            border: 1px solid var(--border-neutral);
            color: #59615C;
        }

        .popup-cancel:hover {
            background: var(--card-background);
        }

        .popup-confirm,
        .popup-ok {
            background: var(--brand-primary-green);
            border: 1px solid var(--brand-primary-green);
            color: #fff;
        }

        .popup-confirm:hover,
        .popup-ok:hover {
            background: var(--brand-hover-green);
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 900px) {
            .verification-info {
                max-width: 510px;
                grid-template-columns: 1fr;
            }

            .info-item {
                min-height: auto;
            }
        }

        @media (max-width: 600px) {
            .security-header {
                height: 66px;
            }

            .security-header-inner {
                padding: 0 18px;
            }

            .brand-logo {
                font-size: 1.15rem;
            }

            .security-label {
                font-size: .68rem;
            }

            .verification-page {
                min-height: calc(100vh - 66px);
                padding: 2.4rem 1rem 2rem;
            }

            .page-title {
                font-size: 1.5rem;
            }

            .page-description {
                font-size: .76rem;
            }

            .verification-card {
                padding: 1.65rem 1.1rem 1.45rem;
            }

            .otp-inputs {
                gap: .42rem;
            }

            .otp-input {
                width: 43px;
                height: 50px;
            }

            .footer-inner {
                padding: 13px 18px;
                flex-direction: column;
                justify-content: center;
            }

            .footer-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: .75rem;
            }

            .footer-copy {
                text-align: center;
            }

            .leaf-left {
                left: -95px;
            }

            .leaf-right {
                right: -70px;
            }
        }

        @media (max-width: 380px) {
            .security-label {
                display: none;
            }

            .otp-inputs {
                gap: .32rem;
            }

            .otp-input {
                width: 39px;
                height: 47px;
                font-size: 1.05rem;
            }
        }
    </style>
</head>

<body>

    <!-- Subtle Kerala-inspired decorative leaves -->

    <svg class="leaf-decoration leaf-left" viewBox="0 0 200 320" aria-hidden="true">
        <path
            d="M175 20C100 55 35 120 30 215C28 260 45 288 63 305C91 258 115 215 133 166C151 118 164 69 175 20Z"
            fill="#DDE4D7"
        />
        <path
            d="M157 48C112 104 77 164 57 251"
            fill="none"
            stroke="#F1E6C7"
            stroke-width="2"
        />
    </svg>

    <svg class="leaf-decoration leaf-right" viewBox="0 0 150 250" aria-hidden="true">
        <path
            d="M35 15C80 48 113 100 112 160C111 198 96 222 81 238C60 200 44 166 35 126C26 86 28 48 35 15Z"
            fill="#E1E6DB"
        />
        <path
            d="M43 38C65 82 78 126 86 194"
            fill="none"
            stroke="#F1E6C7"
            stroke-width="2"
        />
    </svg>

    <svg class="leaf-decoration leaf-bottom-left" viewBox="0 0 120 200" aria-hidden="true">
        <path
            d="M90 8C53 34 24 74 25 119C26 151 40 175 54 190C71 153 83 122 88 91C94 58 94 28 90 8Z"
            fill="#DDE4D7"
        />
    </svg>

    <svg class="leaf-decoration leaf-bottom-right" viewBox="0 0 180 270" aria-hidden="true">
        <path
            d="M145 12C94 47 57 99 55 158C53 207 72 241 91 258C113 214 129 177 137 137C145 96 148 53 145 12Z"
            fill="#DDE4D7"
        />
        <path
            d="M130 40C103 92 89 145 82 216"
            fill="none"
            stroke="#F1E6C7"
            stroke-width="2"
        />
    </svg>

    <!-- =========================
         SECURITY HEADER
    ========================= -->

    <header class="security-header">
        <div class="security-header-inner">

            <a href="/" class="brand-logo">
                NAADAN BOX
            </a>

            <div class="security-label">
                <i class="bi bi-shield-check"></i>
                <span>Secure Account Verification</span>
            </div>

        </div>
    </header>

    <!-- =========================
         MAIN CONTENT
    ========================= -->

    <main class="verification-page">

        <div class="page-heading">

            <p class="page-eyebrow">
                PASSWORD RECOVERY
            </p>

            <h1 class="page-title">
                Verify Your Account
            </h1>

            <p class="page-description">
                Enter the verification code sent to your registered email address to continue resetting your password.
            </p>

            <div class="heading-decoration">
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>

        <!-- OTP CARD -->

        <div class="verification-card">

            <div class="verification-icon">
                <i class="bi bi-person-lock"></i>
            </div>

            <h2 class="verification-title">
                Enter Verification Code
            </h2>

            <p class="verification-description">
                Enter the 6-digit OTP sent to your registered email address.
            </p>

            <form id="verifyForgotPasswordForm">

                <div class="otp-inputs">

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                        autocomplete="one-time-code"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                    <input
                        type="text"
                        class="otp-input"
                        maxlength="1"
                        inputmode="numeric"
                    >

                </div>

                <button
                    type="submit"
                    class="verify-btn"
                    id="verifyButton"
                >
                    Verify OTP
                </button>

            </form>

            <div class="resend-section">
                <span>Didn't receive the code?</span>

                <a
                    href="#"
                    id="resendOtp"
                    class="resend-link disabled"
                >
                    Resend OTP (<span id="timer">60</span>s)
                </a>
            </div>

            <div class="bottom-links">

                <a href="/profile/security/change-password">
                    Change Password
                </a>

                <span class="bottom-divider">•</span>

                <a href="/profile">
                    ← Back
                </a>

            </div>

        </div>

        <!-- SECURITY INFORMATION -->

        <div class="verification-info">

            <div class="info-item">

                <div class="info-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <h6>Secure Verification</h6>

                    <p>
                        Your password reset is protected with a one-time verification code.
                    </p>
                </div>

            </div>

            <div class="info-item">

                <div class="info-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div>
                    <h6>OTP Valid for 5 Minutes</h6>

                    <p>
                        For your security, the verification code expires after 5 minutes.
                    </p>
                </div>

            </div>

            <div class="info-item">

                <div class="info-icon">
                    <i class="bi bi-envelope-check"></i>
                </div>

                <div>
                    <h6>Check Your Email</h6>

                    <p>
                        Make sure you enter the latest verification code sent to your registered email.
                    </p>
                </div>

            </div>

        </div>

    </main>

    <!-- =========================
         FOOTER
    ========================= -->

    <footer>

        <div class="footer-inner">

            <div class="footer-brand">
                NAADAN BOX
            </div>

            <div class="footer-links">

                <a href="#">
                    Privacy Policy
                </a>

                <a href="#">
                    Terms of Service
                </a>

                <a href="#">
                    Shipping Policy
                </a>

                <a href="#">
                    Refund Policy
                </a>

            </div>

            <div class="footer-copy">
                © 2024 NAADAN BOX. Authentic Kerala Flavors.
            </div>

        </div>

    </footer>

    <!-- RESEND TIMER -->

    <span
        id="resendAvailableAt"
        data-time="<%= resendAvailableAt %>"
        style="display:none;"
    ></span>

    <!-- =========================
         CONFIRMATION POPUP
    ========================= -->

    <div
        class="custom-popup-overlay"
        id="confirmPopup"
    >

        <div class="custom-popup">

            <div class="popup-icon">
                <i class="bi bi-key"></i>
            </div>

            <h3 class="popup-title">
                Confirm Password Reset
            </h3>

            <p class="popup-message">
                Are you sure you want to continue and create a new password?
            </p>

            <div class="popup-actions">

                <button
                    type="button"
                    class="popup-btn popup-cancel"
                    id="cancelConfirm"
                >
                    Cancel
                </button>

                <button
                    type="button"
                    class="popup-btn popup-confirm"
                    id="confirmReset"
                >
                    Confirm
                </button>

            </div>

        </div>

    </div>

    <!-- =========================
         SUCCESS POPUP
    ========================= -->

    <div
        class="custom-popup-overlay"
        id="successPopup"
    >

        <div class="custom-popup">

            <div class="popup-icon">
                <i class="bi bi-check-lg"></i>
            </div>

            <h3 class="popup-title">
                OTP Verified Successfully
            </h3>

            <p class="popup-message">
                You can now create a new password for your account.
            </p>

            <div class="popup-actions">

                <button
                    type="button"
                    class="popup-btn popup-ok"
                    id="successOk"
                >
                    Continue
                </button>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const otpInputs = document.querySelectorAll(".otp-input");
        const verifyForm = document.getElementById("verifyForgotPasswordForm");
        const verifyButton = document.getElementById("verifyButton");
        const confirmPopup = document.getElementById("confirmPopup");
        const cancelConfirm = document.getElementById("cancelConfirm");
        const confirmReset = document.getElementById("confirmReset");
        const successPopup = document.getElementById("successPopup");
        const successOk = document.getElementById("successOk");
        const resendOtp = document.getElementById("resendOtp");
        const resendAvailableAt = Number(
            document.getElementById("resendAvailableAt").dataset.time
        );

        otpInputs.forEach((input, index) => {

            input.addEventListener("input", () => {

                input.value = input.value.replace(/\D/g, "");

                if (
                    input.value &&
                    index < otpInputs.length - 1
                ) {
                    otpInputs[index + 1].focus();
                }
            });

            input.addEventListener("keydown", event => {

                if (
                    event.key === "Backspace" &&
                    !input.value &&
                    index > 0
                ) {
                    otpInputs[index - 1].focus();
                }
            });

            input.addEventListener("paste", event => {

                event.preventDefault();

                const pasted = event.clipboardData
                    .getData("text")
                    .replace(/\D/g, "")
                    .slice(0, 6);

                pasted.split("").forEach((digit, i) => {

                    if (otpInputs[i]) {
                        otpInputs[i].value = digit;
                    }
                });

                if (pasted.length) {
                    otpInputs[
                        Math.min(pasted.length - 1, 5)
                    ].focus();
                }
            });
        });


      
verifyForm.addEventListener("submit", async event => {
    event.preventDefault();

    const otp = Array.from(otpInputs)
        .map(input => input.value)
        .join("");

    if (!/^\d{6}$/.test(otp)) {
        showMessagePopup(
            "bi-exclamation-circle",
            "Incomplete OTP",
            "Please enter the complete 6-digit OTP."
        );
        return;
    }

    verifyButton.disabled = true;
    verifyButton.textContent = "Verifying...";

    try {
        const response = await fetch(
            "/profile/security/forgot-password/verify-otp",
            {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify({ otp })
            }
        );

        const data = await response.json();

        if (response.ok && data.success === true) {
            successPopup.style.display = "flex";
            successOk.focus();
            return;
        }

        showMessagePopup(
            "bi-exclamation-circle",
            "Verification Failed",
            data.message || "Incorrect OTP. Please try again."
        );

        otpInputs.forEach(input => {
            input.value = "";
        });

        otpInputs[0].focus();
    } catch (error) {
        console.error("Forgot password OTP verification error:", error);

        showMessagePopup(
            "bi-exclamation-circle",
            "Something Went Wrong",
            "Unable to verify the OTP. Please try again."
        );
    } finally {
        verifyButton.disabled = false;
        verifyButton.textContent = "Verify OTP";
    }
});

// The confirmation popup is no longer needed on the OTP page.
// Do not open it when submitting the OTP form.

successOk.addEventListener("click", () => {
    window.location.replace("/profile/security/reset-password");
});




        successOk.addEventListener("click", () => {

            window.location.replace(
                "/profile/security/reset-password"
            );
        });

        function showMessagePopup(icon, title, message) {

            const popup = document.getElementById("confirmPopup");

            popup.querySelector(".popup-icon i").className =
                "bi " + icon;

            popup.querySelector(".popup-title").textContent =
                title;

            popup.querySelector(".popup-message").textContent =
                message;

            popup.querySelector(".popup-actions").innerHTML = `
                <button
                    type="button"
                    class="popup-btn popup-ok"
                    id="messagePopupOk"
                >
                    OK
                </button>
            `;

            popup.style.display = "flex";

            document.getElementById("messagePopupOk").onclick = () => {

                popup.style.display = "none";

                location.reload();
            };
        }

        /* REFRESH-SAFE RESEND TIMER */

        let countdown;

        const startCountdown = duration => {

            let seconds = Math.max(
                0,
                Math.ceil(duration)
            );

            clearInterval(countdown);

            if (seconds <= 0) {

                resendOtp.classList.remove("disabled");

                resendOtp.innerHTML = "Resend OTP";

                return;
            }

            resendOtp.classList.add("disabled");

            resendOtp.innerHTML =
                `Resend OTP (<span id="timer">${seconds}</span>s)`;

            countdown = setInterval(() => {

                seconds--;

                const timer =
                    document.getElementById("timer");

                if (timer) {
                    timer.textContent = seconds;
                }

                if (seconds <= 0) {

                    clearInterval(countdown);

                    resendOtp.classList.remove("disabled");

                    resendOtp.innerHTML = "Resend OTP";
                }

            }, 1000);
        };

        const initialRemaining = Math.max(
            0,
            Math.ceil(
                (resendAvailableAt - Date.now()) / 1000
            )
        );

        startCountdown(initialRemaining);

        resendOtp.addEventListener("click", async event => {

            event.preventDefault();

            if (
                resendOtp.classList.contains("disabled")
            ) {
                return;
            }

            resendOtp.classList.add("disabled");
            resendOtp.textContent = "Sending...";

            try {

                const response = await fetch(
                    "/profile/security/forgot-password/resend-otp",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    }
                );

                const data = await response.json();

                if (data.success) {

                    otpInputs.forEach(input => {
                        input.value = "";
                    });

                    otpInputs[0].focus();

                    startCountdown(60);

                    showMessagePopup(
                        "bi-envelope-check",
                        "OTP Sent",
                        data.message
                    );

                    return;
                }

                showMessagePopup(
                    "bi-exclamation-circle",
                    "Unable to Resend OTP",
                    data.message
                );

                if (data.remaining) {

                    startCountdown(data.remaining);

                } else {

                    resendOtp.classList.remove("disabled");

                    resendOtp.textContent = "Resend OTP";
                }

            } catch (error) {

                console.error(
                    "Resend OTP error:",
                    error
                );

                showMessagePopup(
                    "bi-exclamation-circle",
                    "Something Went Wrong",
                    "Unable to resend OTP. Please try again."
                );

                resendOtp.classList.remove("disabled");

                resendOtp.textContent = "Resend OTP";
            }
        });
    </script>

