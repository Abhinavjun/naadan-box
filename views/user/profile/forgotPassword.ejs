<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Forgot Password - Naadan Box</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
    >

    <style>


  :root {
            --green: #1B4D2E;
            --green-dark: #133821;
            --gold: #C89B3C;
            --cream: #FBF7EE;
            --cream-dark: #F4EEDF;
            --white: #FFFFFF;
            --text: #1F2D26;
            --muted: #718078;
            --border: #DED8CC;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            background: var(--cream);
            color: var(--text);
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                "Helvetica Neue",
                Arial,
                sans-serif;
        }

        /* SECURITY HEADER */

        .security-header {
            height: 68px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 52px;
            background: rgba(255, 255, 255, 0.92);
            border-bottom: 1px solid rgba(27, 77, 46, 0.10);
            position: relative;
            z-index: 10;
        }

        .brand {
            color: var(--green);
            text-decoration: none;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .security-status {
            display: flex;
            align-items: center;
            gap: 7px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 600;
        }

        .security-status i {
            color: var(--green);
            font-size: 14px;
        }

        /* PAGE */

        .page {
            min-height: calc(100vh - 68px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 20px 28px;
            position: relative;
            overflow: hidden;
        }

        /* LEAF DECORATIONS */

        .leaf {
            position: absolute;
            pointer-events: none;
            z-index: 0;
        }

        .leaf-left {
            width: 250px;
            height: 430px;
            left: -145px;
            top: 50px;
            background: rgba(27, 77, 46, 0.065);
            border-radius: 100% 0 100% 0;
            transform: rotate(27deg);
        }

        .leaf-left::before {
            content: "";
            position: absolute;
            width: 2px;
            height: 355px;
            left: 52%;
            top: 35px;
            background: rgba(27, 77, 46, 0.12);
            transform: rotate(-27deg);
        }

        .leaf-left::after {
            content: "";
            position: absolute;
            width: 105px;
            height: 2px;
            left: 45px;
            top: 190px;
            background: rgba(27, 77, 46, 0.07);
            transform: rotate(-27deg);
            box-shadow:
                10px -65px 0 rgba(27, 77, 46, 0.055),
                10px 65px 0 rgba(27, 77, 46, 0.055);
        }

        .leaf-right {
            width: 220px;
            height: 390px;
            right: -125px;
            bottom: -20px;
            background: rgba(27, 77, 46, 0.055);
            border-radius: 0 100% 0 100%;
            transform: rotate(-25deg);
        }

        .leaf-right::before {
            content: "";
            position: absolute;
            width: 2px;
            height: 320px;
            right: 49%;
            top: 32px;
            background: rgba(27, 77, 46, 0.10);
            transform: rotate(25deg);
        }

        .leaf-right::after {
            content: "";
            position: absolute;
            width: 95px;
            height: 2px;
            right: 45px;
            top: 175px;
            background: rgba(27, 77, 46, 0.065);
            transform: rotate(25deg);
            box-shadow:
                -10px -60px 0 rgba(27, 77, 46, 0.05),
                -10px 60px 0 rgba(27, 77, 46, 0.05);
        }

        .gold-leaf {
            width: 110px;
            height: 210px;
            left: 12%;
            bottom: -155px;
            background: rgba(200, 155, 60, 0.055);
            border-radius: 100% 0 100% 0;
            transform: rotate(25deg);
        }

        /* CONTENT */

        .content {
            width: 100%;
            max-width: 470px;
            position: relative;
            z-index: 2;
        }

        /* PAGE TITLE */

        .heading {
            text-align: center;
            margin-bottom: 20px;
        }

        .eyebrow {
            color: var(--gold);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 2.2px;
            margin-bottom: 7px;
        }

        .heading h1 {
            margin: 0;
            color: var(--green);
            font-size: 27px;
            font-weight: 800;
            line-height: 1.2;
        }

        .heading p {
            margin: 7px auto 10px;
            max-width: 380px;
            color: var(--muted);
            font-size: 11px;
            line-height: 1.55;
        }

        .heading-decoration {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 7px;
        }

        .heading-decoration span {
            display: block;
            width: 27px;
            height: 2px;
            background: var(--gold);
        }

        .heading-decoration span:nth-child(2) {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        /* MAIN CARD */

        .security-card {
            background: var(--white);
            border: 1px solid rgba(27, 77, 46, 0.08);
            border-top: 3px solid var(--green);
            border-radius: 16px;
            padding: 27px 30px 25px;
            box-shadow:
                0 14px 38px rgba(27, 77, 46, 0.08);
        }

        /* ICON */

        .main-icon {
            width: 52px;
            height: 52px;
            margin: 0 auto 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: rgba(27, 77, 46, 0.08);
            color: var(--green);
            font-size: 22px;
        }

        .card-title {
            text-align: center;
            color: var(--green);
            font-size: 20px;
            font-weight: 800;
            margin: 0 0 7px;
        }

        .card-description {
            max-width: 365px;
            margin: 0 auto 23px;
            text-align: center;
            color: var(--muted);
            font-size: 11px;
            line-height: 1.55;
        }

        /* EMAIL BOX */

        .field-label {
            display: block;
            color: var(--text);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.4px;
            margin-bottom: 7px;
        }

        .email-box {
            min-height: 47px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 10px 8px 13px;
            background: #FAF7EF;
            border: 1px solid var(--border);
            border-radius: 9px;
        }

        .email-value {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
        }

        .email-icon {
            width: 28px;
            height: 28px;
            min-width: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: rgba(27, 77, 46, 0.08);
            color: var(--green);
            font-size: 12px;
        }

        .email-text {
            color: var(--text);
            font-size: 11px;
            font-weight: 600;
            word-break: break-all;
        }

        .verified-badge {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 5px 8px;
            border-radius: 20px;
            background: rgba(38, 166, 91, 0.10);
            color: var(--green);
            font-size: 9px;
            font-weight: 800;
            white-space: nowrap;
        }

        .email-info {
            margin: 7px 0 20px;
            color: var(--muted);
            font-size: 9.5px;
            line-height: 1.45;
        }

        /* BUTTON */

        .send-button {
            width: 100%;
            height: 44px;
            border: none;
            border-radius: 8px;
            background: var(--green);
            color: white;
            font-size: 11px;
            font-weight: 800;
            transition: 0.2s ease;
        }

        .send-button:hover {
            background: var(--green-dark);
        }

        .send-button i {
            margin-right: 6px;
        }

        /* BACK */

        .back-link {
            display: block;
            width: fit-content;
            margin: 17px auto 0;
            color: var(--green);
            text-decoration: none;
            font-size: 10px;
            font-weight: 800;
        }

        .back-link:hover {
            color: var(--green-dark);
        }

        /* SECURITY NOTE */

        .security-note {
            margin-top: 13px;
            padding: 12px 14px;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: rgba(255, 255, 255, 0.68);
            border: 1px solid rgba(200, 155, 60, 0.24);
            border-radius: 10px;
        }

        .note-icon {
            width: 29px;
            height: 29px;
            min-width: 29px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(27, 77, 46, 0.08);
            border-radius: 9px;
            color: var(--green);
            font-size: 13px;
        }

        .note-title {
            margin: 0 0 2px;
            color: var(--green);
            font-size: 10px;
            font-weight: 800;
        }

        .note-text {
            margin: 0;
            color: var(--muted);
            font-size: 9.5px;
            line-height: 1.45;
        }

        /* FOOTER */

        .security-footer {
            width: 100%;
            padding: 13px 40px;
            border-top: 1px solid rgba(27, 77, 46, 0.09);
            background: rgba(255, 255, 255, 0.60);
            position: relative;
            z-index: 5;
        }

        .footer-inner {
            max-width: 1100px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .footer-brand {
            color: var(--green);
            font-size: 10px;
            font-weight: 800;
        }

        .footer-links {
            display: flex;
            gap: 17px;
        }

        .footer-links a {
            color: var(--muted);
            font-size: 9px;
            text-decoration: none;
        }

        .footer-links a:hover {
            color: var(--green);
        }

        .footer-copy {
            color: var(--muted);
            font-size: 9px;
        }

        /* MOBILE */

        @media (max-width: 700px) {

            .security-header {
                height: 62px;
                padding: 0 20px;
            }

            .brand {
                font-size: 21px;
            }

            .security-status {
                display: none;
            }

            .page {
                min-height: calc(100vh - 62px);
                padding: 28px 13px 24px;
                align-items: flex-start;
            }

            .content {
                margin-top: 3px;
            }

            .heading h1 {
                font-size: 24px;
            }

            .security-card {
                padding: 24px 18px;
            }

            .leaf-left {
                left: -145px;
            }

            .leaf-right {
                right: -140px;
            }

            .footer-inner {
                flex-direction: column;
                gap: 7px;
                text-align: center;
            }

            .footer-links {
                flex-wrap: wrap;
                justify-content: center;
                gap: 11px;
            }
        }

        @media (max-width: 400px) {

            .page {
                padding-left: 10px;
                padding-right: 10px;
            }

            .security-card {
                padding: 22px 16px;
            }

            .heading h1 {
                font-size: 22px;
            }

            .email-text {
                font-size: 10px;
            }

            .verified-badge {
                font-size: 8px;
                padding: 4px 6px;
            }
        }

    </style>

</head>


<body>
    
   

    <!-- SECURITY HEADER -->

    <header class="security-header">

        <a
            href="/"
            class="brand"
        >
            NAADAN BOX
        </a>

        <div class="security-status">

            <i class="bi bi-shield-check"></i>

            Secure Account Verification

        </div>

    </header>


    <!-- PAGE -->

    <main class="page">


        <!-- LEAF DECORATIONS -->

        <div class="leaf leaf-left"></div>

        <div class="leaf leaf-right"></div>

        <div class="gold-leaf"></div>


        <div class="content">


            <!-- HEADING -->

            <div class="heading">

                <div class="eyebrow">
                    ACCOUNT SECURITY
                </div>

                <h1>
                    Forgot Current Password?
                </h1>

                <p>
                    We'll send a secure verification code to your registered email so you can create a new password.
                </p>

                <div class="heading-decoration">

                    <span></span>

                    <span></span>

                    <span></span>

                </div>

            </div>


            <!-- CARD -->

            <section class="security-card">


                <div class="main-icon">

                    <i class="bi bi-key-fill"></i>

                </div>


                <h2 class="card-title">
                    Verify Your Account
                </h2>


                <p class="card-description">
                    We'll send a verification code to the email address connected to your Naadan Box account.
                </p>


                <!-- REGISTERED EMAIL -->

                <label class="field-label">
                    REGISTERED EMAIL ADDRESS
                </label>


                <div class="email-box">

                    <div class="email-value">

                        <div class="email-icon">

                            <i class="bi bi-envelope"></i>

                        </div>

                        <span class="email-text">
                            <%= email %>
                        </span>

                    </div>


                    <div class="verified-badge">

                        <i class="bi bi-check-circle-fill"></i>

                        Verified

                    </div>

                </div>


                <p class="email-info">
                    For your security, the verification code will only be sent to the email address associated with your current account.
                </p>


                <!-- SEND VERIFICATION CODE -->

                <button
                    type="button"
                    class="send-button"
                    id="sendVerificationCode"
                >

                    <i class="bi bi-send-fill"></i>

                    Send Verification Code

                </button>


                <!-- BACK -->

                <a
                    href="/profile/security/change-password"
                    class="back-link"
                >
                    <i class="bi bi-arrow-left"></i>
                    Back to Change Password
                </a>


            </section>


            <!-- SECURITY NOTE -->

            <div class="security-note">

                <div class="note-icon">

                    <i class="bi bi-shield-lock-fill"></i>

                </div>

                <div>

                    <p class="note-title">
                        Secure Password Recovery
                    </p>

                    <p class="note-text">
                        Your verification code will only be sent to your registered email address. Never share your OTP with anyone.
                    </p>

                </div>

            </div>


        </div>

    </main>


    <!-- FOOTER -->

    <footer class="security-footer">

        <div class="footer-inner">

            <div class="footer-brand">
                NAADAN BOX
            </div>

            <div class="footer-links">

                <a href="#">
                    Privacy Policy
                </a>

                <a href="#">
                    Terms of Service
                </a>

                <a href="#">
                    Shipping Policy
                </a>

                <a href="#">
                    Refund Policy
                </a>

            </div>

            <div class="footer-copy">
                © 2026 NAADAN BOX. Authentic Kerala Flavors.
            </div>

        </div>

    </footer>


    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
    ></script>


    <script>

        document.addEventListener("DOMContentLoaded", () => {

            const sendButton =
                document.getElementById("sendVerificationCode");

            if (!sendButton) {
                return;
            }

            sendButton.addEventListener("click", async () => {

                sendButton.disabled = true;

                sendButton.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>Sending...';

                try {

                    const response = await fetch(
                        "/profile/security/forgot-password/send-otp",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                                "Accept": "application/json"
                            },
                            credentials: "same-origin"
                        }
                    );

                    const data = await response.json();

                    if (data.success) {

                        window.location.href =
                            "/profile/security/forgot-password/verify";

                        return;
                    }

                    alert(
                        data.message ||
                        "Unable to send verification code. Please try again."
                    );

                } catch (error) {

                    console.error(
                        "Forgot password OTP error:",
                        error
                    );

                    alert(
                        "Something went wrong. Please try again."
                    );

                } finally {

                    sendButton.disabled = false;

                    sendButton.innerHTML =
                        '<i class="bi bi-send-fill"></i> Send Verification Code';

                }

            });

        });

    </script>


</body>

</html>