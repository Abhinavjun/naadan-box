<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Email - Naadan Box</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --brand-primary-green: #1B4D2E;
            --brand-hover-green: #133821;
            --brand-gold: #C89B3C;
            --brand-cream: #F8F4EA;
            --brand-white: #FFFFFF;
            --brand-text: #1F2D26;
            --brand-muted: #718078;
            --danger-validation-red: #DC3545;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--brand-cream);
            color: var(--brand-text);
            font-family: Arial, sans-serif;
        }

        .security-header {
            height: 64px;
            background: rgba(255, 255, 255, 0.92);
            border-bottom: 1px solid rgba(27, 77, 46, 0.12);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 15.5%;
        }

        .brand-name {
            color: var(--brand-primary-green);
            font-size: 21px;
            font-weight: 800;
            letter-spacing: 0.4px;
        }

        .security-label {
            color: var(--brand-muted);
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .security-label i {
            color: var(--brand-primary-green);
            font-size: 14px;
        }

        .verification-page {
            min-height: calc(100vh - 64px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 50px 20px;
            position: relative;
            overflow: hidden;
        }

        .leaf {
            position: absolute;
            opacity: 0.12;
            pointer-events: none;
        }

        .leaf-left {
            width: 180px;
            height: 330px;
            left: -55px;
            top: 40px;
            background: #8EA68F;
            border-radius: 100% 0 100% 0;
            transform: rotate(28deg);
        }

        .leaf-right {
            width: 130px;
            height: 250px;
            right: -30px;
            bottom: 40px;
            background: #8EA68F;
            border-radius: 0 100% 0 100%;
            transform: rotate(-25deg);
        }

        .verification-wrapper {
            width: 100%;
            max-width: 500px;
            position: relative;
            z-index: 2;
        }

        .verification-heading {
            text-align: center;
            margin-bottom: 24px;
        }

        .eyebrow {
            color: var(--brand-gold);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 9px;
        }

        .verification-heading h1 {
            margin: 0;
            color: var(--brand-primary-green);
            font-size: 30px;
            font-weight: 800;
        }

        .verification-description {
            margin: 10px auto 12px;
            max-width: 430px;
            color: var(--brand-muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .heading-decoration {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .heading-decoration span {
            display: block;
            width: 28px;
            height: 2px;
            background: var(--brand-gold);
        }

        .heading-decoration span:nth-child(2) {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .verification-card {
            background: var(--brand-white);
            border: 1px solid rgba(27, 77, 46, 0.08);
            border-top: 3px solid var(--brand-primary-green);
            border-radius: 15px;
            padding: 30px 32px;
            box-shadow: 0 12px 32px rgba(27, 77, 46, 0.08);
        }

        .icon-box {
            width: 50px;
            height: 50px;
            margin: 0 auto 15px;
            border-radius: 12px;
            background: rgba(27, 77, 46, 0.08);
            color: var(--brand-primary-green);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .card-title {
            text-align: center;
            color: var(--brand-primary-green);
            font-size: 19px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .card-description {
            text-align: center;
            color: var(--brand-muted);
            font-size: 13px;
            line-height: 1.55;
            margin-bottom: 22px;
        }

        .email-display {
            background: var(--brand-cream);
            border: 1px solid rgba(27, 77, 46, 0.10);
            border-radius: 10px;
            padding: 11px 14px;
            text-align: center;
            color: var(--brand-primary-green);
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 22px;
            word-break: break-word;
        }

        .form-label-custom {
            display: block;
            color: var(--brand-text);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.7px;
            margin-bottom: 10px;
            text-align: center;
        }

        .otp-inputs {
            display: flex;
            justify-content: center;
            gap: 9px;
            margin-bottom: 12px;
        }

        .otp-input {
            width: 48px;
            height: 52px;
            border: 1px solid #D9DED8;
            border-radius: 9px;
            background: #FCFBF7;
            color: var(--brand-primary-green);
            text-align: center;
            font-size: 21px;
            font-weight: 700;
            outline: none;
            transition: 0.2s ease;
        }

        .otp-input:focus {
            border-color: var(--brand-primary-green);
            box-shadow: 0 0 0 3px rgba(27, 77, 46, 0.08);
            background: #FFFFFF;
        }

        .otp-error {
            color: var(--danger-validation-red);
            text-align: center;
            font-size: 12px;
            min-height: 18px;
            margin-bottom: 8px;
        }

        .timer-text {
            text-align: center;
            color: var(--brand-muted);
            font-size: 12px;
            margin-bottom: 18px;
        }

        .timer-text span {
            color: var(--brand-primary-green);
            font-weight: 700;
        }

        .verify-button {
            width: 100%;
            height: 44px;
            border: none;
            border-radius: 8px;
            background: var(--brand-primary-green);
            color: #FFFFFF;
            font-size: 13px;
            font-weight: 700;
            transition: 0.2s ease;
        }

        .verify-button:hover {
            background: var(--brand-hover-green);
        }

        .verify-button:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

        .secondary-actions {
            display: flex;
            justify-content: center;
            gap: 22px;
            margin-top: 17px;
        }

        .secondary-actions button,
        .secondary-actions a {
            border: none;
            background: transparent;
            color: var(--brand-primary-green);
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
            padding: 0;
        }

        .secondary-actions button:hover,
        .secondary-actions a:hover {
            color: var(--brand-hover-green);
            text-decoration: underline;
        }

        .security-note {
            margin-top: 15px;
            padding: 13px 15px;
            border: 1px solid rgba(200, 155, 60, 0.25);
            background: rgba(255, 255, 255, 0.55);
            border-radius: 10px;
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .security-note i {
            color: var(--brand-primary-green);
            font-size: 16px;
            margin-top: 1px;
        }

        .security-note-title {
            color: var(--brand-primary-green);
            font-size: 11px;
            font-weight: 800;
            margin-bottom: 2px;
        }

        .security-note p {
            margin: 0;
            color: var(--brand-muted);
            font-size: 11px;
            line-height: 1.45;
        }

        .page-footer {
            text-align: center;
            margin-top: 20px;
            color: var(--brand-muted);
            font-size: 11px;
        }

        @media (max-width: 600px) {
            .security-header {
                padding: 0 20px;
            }

            .security-label {
                display: none;
            }

            .verification-page {
                padding: 35px 15px;
            }

            .verification-heading h1 {
                font-size: 26px;
            }

            .verification-card {
                padding: 25px 18px;
            }

            .otp-inputs {
                gap: 6px;
            }

            .otp-input {
                width: 42px;
                height: 48px;
            }
        }
    </style>
</head>

<body>

<header class="security-header">
    <div class="brand-name">NAADAN BOX</div>

    <div class="security-label">
        <i class="bi bi-shield-check"></i>
        Secure Account Verification
    </div>
</header>

<main class="verification-page">

    <div class="leaf leaf-left"></div>
    <div class="leaf leaf-right"></div>

    <div class="verification-wrapper">

        <div class="verification-heading">
            <div class="eyebrow">ACCOUNT SECURITY</div>

            <h1>Verify Your Email</h1>

            <p class="verification-description">
                Enter the verification code sent to your new email address
                to complete the email change.
            </p>

            <div class="heading-decoration">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>

        <div class="verification-card">

            <div class="icon-box">
                <i class="bi bi-envelope-check"></i>
            </div>

            <h2 class="card-title">Enter Verification Code</h2>

            <p class="card-description">
                We've sent a 6-digit verification code to your new email address.
            </p>

            <div class="email-display">
                Check your new email for the OTP
            </div>

            <form id="emailVerificationForm">

                <label class="form-label-custom">
                    VERIFICATION CODE
                </label>

                <div class="otp-inputs">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric" autocomplete="one-time-code">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric">
                    <input type="text" class="otp-input" maxlength="1" inputmode="numeric">
                </div>

                <input type="hidden" id="otp" name="otp">

                <div id="otpError" class="otp-error"></div>

                <div class="timer-text">
                    <span id="timerText">Resend available soon</span>
                </div>

                <button type="submit" class="verify-button" id="verifyButton">
                    <i class="bi bi-shield-check me-1"></i>
                    Verify Email
                </button>

            </form>

            <div class="secondary-actions">
                <button type="button" id="resendOtpButton" disabled>
                    Resend Code
                </button>

                <a href="/profile/security/change-email">
                    Change Email
                </a>
            </div>

        </div>

        <div class="security-note">
            <i class="bi bi-shield-lock-fill"></i>

            <div>
                <div class="security-note-title">
                    Your account stays protected
                </div>

                <p>
                    Your email will only be changed after the verification
                    code is successfully confirmed.
                </p>
            </div>
        </div>

        <div class="page-footer">
            © <%= new Date().getFullYear() %> Naadan Box. All rights reserved.
        </div>

    </div>

</main>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const otpInputs = document.querySelectorAll(".otp-input");
    const hiddenOtp = document.getElementById("otp");
    const form = document.getElementById("emailVerificationForm");
    const verifyButton = document.getElementById("verifyButton");
    const resendButton = document.getElementById("resendOtpButton");
    const otpError = document.getElementById("otpError");
    const timerText = document.getElementById("timerText");

    /*
     * The server sends the exact time when Resend becomes available.
     * This keeps the timer synchronized with the session.
     */
    let resendAvailableAt = Number(
        "<%= Number(resendAvailableAt || 0) %>"
    );

    function updateOtp() {
        hiddenOtp.value = Array.from(otpInputs)
            .map(input => input.value)
            .join("");
    }

    // OTP input handling
    otpInputs.forEach((input, index) => {

        input.addEventListener("input", () => {

            input.value = input.value
                .replace(/\D/g, "")
                .slice(0, 1);

            if (
                input.value &&
                index < otpInputs.length - 1
            ) {
                otpInputs[index + 1].focus();
            }

            updateOtp();
            otpError.textContent = "";
        });

        input.addEventListener("keydown", event => {

            if (
                event.key === "Backspace" &&
                !input.value &&
                index > 0
            ) {
                otpInputs[index - 1].focus();
            }
        });

        input.addEventListener("paste", event => {

            event.preventDefault();

            const pasted = event.clipboardData
                .getData("text")
                .replace(/\D/g, "")
                .slice(0, 6);

            pasted.split("").forEach((digit, i) => {

                if (otpInputs[i]) {
                    otpInputs[i].value = digit;
                }
            });

            updateOtp();

            const nextIndex = Math.min(
                pasted.length,
                otpInputs.length - 1
            );

            otpInputs[nextIndex].focus();
            otpError.textContent = "";
        });
    });

    // Verify OTP
    form.addEventListener("submit", async event => {

        event.preventDefault();

        updateOtp();

        const otpValue = hiddenOtp.value;

        if (!/^\d{6}$/.test(otpValue)) {

            otpError.textContent =
                "Please enter the 6-digit verification code.";

            return;
        }

        verifyButton.disabled = true;

        verifyButton.innerHTML =
            '<i class="bi bi-hourglass-split me-1"></i> Verifying...';

        otpError.textContent = "";

        try {

            const response = await fetch(
                "/profile/email/verify-otp",
                {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        otp: otpValue
                    })
                }
            );

            const data = await response.json();

            if (data.success) {

                window.location.href = "/profile";

                return;
            }

            otpError.textContent =
                data.message ||
                "Unable to verify the code.";

        } catch (error) {

            console.error(
                "Email verification error:",
                error
            );

            otpError.textContent =
                "Something went wrong. Please try again.";

        } finally {

            verifyButton.disabled = false;

            verifyButton.innerHTML =
                '<i class="bi bi-shield-check me-1"></i> Verify Email';
        }
    });

    // Resend timer
    function updateTimer() {

        const remaining = Math.max(
            0,
            Math.ceil(
                (resendAvailableAt - Date.now()) / 1000
            )
        );

        if (remaining > 0) {

            resendButton.disabled = true;

            timerText.textContent =
                `Resend available in ${remaining}s`;

        } else {

            resendButton.disabled = false;

            timerText.textContent =
                "Didn't receive the code?";
        }
    }

    /*
     * Run immediately.
     * This is important because the timer should be visible
     * as soon as the verification page opens.
     */
    updateTimer();

    const timer = setInterval(() => {

        updateTimer();

        if (Date.now() >= resendAvailableAt) {
            clearInterval(timer);
        }

    }, 1000);

    // Resend OTP
    resendButton.addEventListener("click", async () => {

        resendButton.disabled = true;
        resendButton.textContent = "Sending...";

        otpError.textContent = "";

        try {

            const response = await fetch(
                "/profile/email/resend-otp",
                {
                    method: "POST"
                }
            );

            const data = await response.json();

            if (data.success) {

                /*
                 * Start the new 60-second timer immediately.
                 */
                resendAvailableAt =
                    Date.now() + 60000;

                otpInputs.forEach(input => {
                    input.value = "";
                });

                updateOtp();

                otpInputs[0].focus();

                updateTimer();

            } else {

                otpError.textContent =
                    data.message ||
                    "Unable to resend the code.";

                resendButton.disabled = false;
                resendButton.textContent = "Resend Code";

                /*
                 * If backend provides remaining seconds,
                 * synchronize the timer with it.
                 */
                if (data.remaining) {

                    resendAvailableAt =
                        Date.now() +
                        Number(data.remaining) * 1000;

                    updateTimer();
                }
            }

        } catch (error) {

            console.error(
                "Resend OTP error:",
                error
            );

            otpError.textContent =
                "Unable to resend the code.";

            resendButton.disabled = false;
            resendButton.textContent = "Resend Code";
        }

        if (!resendButton.disabled) {
            resendButton.textContent = "Resend Code";
        }
    });

    // Focus first OTP box when page opens
    otpInputs[0].focus();

});
</script>

</body>
</html>