    <!-- =========================
         EXISTING CHANGE EMAIL FUNCTIONALITY
         ========================= -->

    <script>
        const showInlineMessage = (message, type = "error") => {
            const messageBox = document.getElementById("emailFormMessage");
            const messageText = document.getElementById("emailFormMessageText");
            const messageIcon = document.getElementById("emailFormMessageIcon");

            if (!messageBox || !messageText || !messageIcon) return;

            messageText.textContent = String(message || "Something went wrong. Please try again.");

            messageBox.classList.remove("success");
            if (type === "success") {
                messageBox.classList.add("success");
                messageIcon.className = "bi bi-check-circle-fill";
            } else {
                messageIcon.className = "bi bi-exclamation-circle-fill";
            }

            messageBox.classList.add("show");
        };

        const clearInlineMessage = () => {
            const messageBox = document.getElementById("emailFormMessage");
            const messageText = document.getElementById("emailFormMessageText");

            messageBox.classList.remove("show", "success");
            messageText.textContent = "";
        };

        document
            .getElementById("newEmail")
            .addEventListener("input", clearInlineMessage);

        document
            .getElementById("changeEmailForm")
            .addEventListener("submit", async function(e) {
                e.preventDefault();
                clearInlineMessage();

                const newEmail = document
                    .getElementById("newEmail")
                    .value
                    .trim();

                const button = document.getElementById("btnUpdateEmail");

                if (!newEmail) {
                    showInlineMessage("Please enter your new email address.");
                    document.getElementById("newEmail").focus();
                    return;
                }

                button.disabled = true;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Sending...';

                try {
                    const response = await fetch("/profile/email/send-otp", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ newEmail })
                    });

                    let data;

                    try {
                        data = await response.json();
                    } catch (parseError) {
                        showInlineMessage("The server returned an unexpected response. Please try again.");
                        return;
                    }

                    if (response.ok && data.success) {
                        window.location.href = "/profile/security/verify-email";
                        return;
                    }

                    showInlineMessage(data.message || "Unable to send the verification code. Please try again.");

                } catch (error) {
                    console.error("Email change error:", error);
                    showInlineMessage("Something went wrong. Please check your connection and try again.");

                } finally {
                    button.disabled = false;
                    button.innerHTML = '<i class="bi bi-shield-check me-2"></i>Update Email';
                }
            });
    </script>


