<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Change Password - Naadan Box</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
:root{
    --brand-green:#1B4D2E;
    --brand-green-hover:#133821;
    --brand-gold:#C89B3C;
    --bg-cream:#F8F4EA;
    --white:#FFFFFF;
    --text-dark:#1F2D26;
    --text-muted:#718078;
    --border:#DED8CC;
    --danger:#DC3545;
    --success:#198754;
}

*{
    box-sizing:border-box;
}

html,
body{
    margin:0;
    min-height:100%;
}

body{
    background:var(--bg-cream);
    color:var(--text-dark);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
}

/* SECURITY HEADER */

.security-header{
    height:64px;
    background:rgba(255,255,255,.96);
    border-bottom:1px solid rgba(27,77,46,.10);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 15.5%;
    position:relative;
    z-index:20;
}

.brand-name{
    color:var(--brand-green);
    font-size:21px;
    font-weight:800;
    letter-spacing:.5px;
    text-decoration:none;
}

.security-label{
    display:flex;
    align-items:center;
    gap:7px;
    color:var(--text-muted);
    font-size:12px;
}

.security-label i{
    color:var(--brand-green);
    font-size:14px;
}

/* PAGE */

.password-page{
    min-height:calc(100vh - 64px);
    display:flex;
    justify-content:center;
    align-items:flex-start;
    padding:42px 20px 28px;
    position:relative;
    overflow:hidden;
}

/* LEAF DECORATIONS */

.leaf{
    position:absolute;
    pointer-events:none;
    z-index:0;
}

/* large left leaf */

.leaf-left{
    width:190px;
    height:350px;
    left:-72px;
    top:80px;
    background:rgba(116,139,110,.12);
    border-radius:100% 0 100% 0;
    transform:rotate(31deg);
}

.leaf-left::before{
    content:"";
    position:absolute;
    width:2px;
    height:285px;
    background:rgba(116,139,110,.18);
    left:51%;
    top:30px;
    transform:rotate(-30deg);
}

.leaf-left::after{
    content:"";
    position:absolute;
    width:90px;
    height:2px;
    background:rgba(116,139,110,.10);
    left:43px;
    top:160px;
    transform:rotate(-30deg);
    box-shadow:
        15px -48px 0 rgba(116,139,110,.08),
        15px 48px 0 rgba(116,139,110,.08);
}

/* right leaf */

.leaf-right{
    width:145px;
    height:275px;
    right:-48px;
    bottom:90px;
    background:rgba(116,139,110,.11);
    border-radius:0 100% 0 100%;
    transform:rotate(-27deg);
}

.leaf-right::before{
    content:"";
    position:absolute;
    width:2px;
    height:220px;
    background:rgba(116,139,110,.17);
    right:48%;
    top:28px;
    transform:rotate(27deg);
}

.leaf-right::after{
    content:"";
    position:absolute;
    width:75px;
    height:2px;
    background:rgba(116,139,110,.09);
    right:40px;
    top:125px;
    transform:rotate(27deg);
    box-shadow:
        -8px -43px 0 rgba(116,139,110,.07),
        -8px 43px 0 rgba(116,139,110,.07);
}

/* small decorative leaf */

.leaf-small{
    width:85px;
    height:165px;
    left:14%;
    bottom:-75px;
    background:rgba(200,155,60,.07);
    border-radius:100% 0 100% 0;
    transform:rotate(18deg);
}

/* MAIN CONTENT */

.password-wrapper{
    width:100%;
    max-width:500px;
    position:relative;
    z-index:2;
}

/* HEADING */

.password-heading{
    text-align:center;
    margin-bottom:22px;
}

.heading-eyebrow{
    color:var(--brand-gold);
    font-size:11px;
    font-weight:800;
    letter-spacing:2px;
    margin-bottom:7px;
}

.password-heading h1{
    margin:0;
    color:var(--brand-green);
    font-size:28px;
    font-weight:800;
    line-height:1.2;
}

.password-heading p{
    max-width:420px;
    margin:9px auto 12px;
    color:var(--text-muted);
    font-size:12px;
    line-height:1.5;
}

.heading-decoration{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:7px;
}

.heading-decoration span{
    display:block;
    width:28px;
    height:2px;
    background:var(--brand-gold);
}

.heading-decoration span:nth-child(2){
    width:6px;
    height:6px;
    border-radius:50%;
}

/* PASSWORD CARD */

.password-card{
    width:100%;
    background:var(--white);
    border:1px solid rgba(27,77,46,.08);
    border-top:3px solid var(--brand-green);
    border-radius:15px;
    padding:27px 30px 25px;
    box-shadow:0 12px 32px rgba(27,77,46,.08);
}

/* CARD HEADER */

.password-header{
    text-align:center;
    margin-bottom:20px;
}

.password-icon{
    width:48px;
    height:48px;
    margin:0 auto 11px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(27,77,46,.08);
    color:var(--brand-green);
    border-radius:12px;
    font-size:21px;
}

.password-title{
    margin:0 0 5px;
    color:var(--brand-green);
    font-size:19px;
    font-weight:800;
}

.password-subtitle{
    margin:0 auto;
    color:var(--text-muted);
    font-size:11px;
    line-height:1.5;
}

/* FORM */

.form-group{
    margin-bottom:13px;
}

.form-label{
    display:block;
    margin-bottom:6px;
    color:var(--text-dark);
    font-size:10px;
    font-weight:800;
    letter-spacing:.4px;
}

.password-input-wrapper{
    position:relative;
}

.password-input{
    width:100%;
    height:43px;
    padding:10px 43px 10px 12px;
    border:1px solid var(--border);
    border-radius:8px;
    background:#FCFBF7;
    color:var(--text-dark);
    font-size:12px;
    outline:none;
    transition:.2s ease;
}

.password-input::placeholder{
    color:#89918D;
}

.password-input:focus{
    background:#fff;
    border-color:var(--brand-green);
    box-shadow:0 0 0 3px rgba(27,77,46,.08);
}

.password-input.is-valid{
    border-color:var(--success);
}

.password-input.is-invalid{
    border-color:var(--danger);
}

.password-toggle{
    position:absolute;
    top:0;
    right:0;
    width:42px;
    height:43px;
    border:0;
    background:transparent;
    color:#7B8580;
    cursor:pointer;
}

.password-toggle:hover{
    color:var(--brand-green);
}

/* VALIDATION */

.validation-message{
    display:none;
    margin-top:4px;
    font-size:10px;
}

.validation-message.error{
    display:block;
    color:var(--danger);
}

.validation-message.success{
    display:block;
    color:var(--success);
}

/* FORGOT PASSWORD */

.forgot-password-link{
    margin-top:5px;
    text-align:right;
}

.forgot-password-link a{
    color:var(--brand-green);
    font-size:10px;
    font-weight:700;
    text-decoration:none;
}

.forgot-password-link a:hover{
    color:var(--brand-green-hover);
    text-decoration:underline;
}

/* PASSWORD REQUIREMENTS */

.password-requirements{
    display:none;
    background:#FCFBF7;
    border:1px solid var(--border);
    border-radius:9px;
    padding:11px 12px;
    margin:4px 0 13px;
}

.password-requirements.active{
    display:block;
}

.strength-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:5px;
}

.strength-label{
    color:var(--text-dark);
    font-size:10px;
    font-weight:800;
}

.strength-text{
    font-size:10px;
    font-weight:800;
}

.progress{
    height:4px;
    background:#E9E7E1;
    margin-bottom:9px;
    border-radius:10px;
    overflow:hidden;
}

.progress-bar{
    transition:width .2s ease;
}

.requirement-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:5px 8px;
}

.req-item{
    display:flex;
    align-items:center;
    gap:5px;
    color:var(--danger);
    font-size:9px;
}

.req-item.valid{
    color:var(--success);
}

.req-item i{
    font-size:10px;
}

/* PASSWORD MATCH */

.match-message{
    display:none;
    margin-top:4px;
    font-size:10px;
}

.match-message.error{
    display:block;
    color:var(--danger);
}

.match-message.success{
    display:block;
    color:var(--success);
}

/* BUTTONS */

.password-actions{
    display:flex;
    gap:10px;
    margin-top:18px;
}

.password-btn{
    height:42px;
    flex:1;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:8px;
    font-size:11px;
    font-weight:800;
    text-decoration:none;
    cursor:pointer;
    transition:.2s ease;
}

.cancel-btn{
    background:#fff;
    border:1px solid var(--border);
    color:var(--text-dark);
}

.cancel-btn:hover{
    background:var(--bg-cream);
    color:var(--text-dark);
}

.update-btn{
    background:var(--brand-green);
    border:1px solid var(--brand-green);
    color:#fff;
}

.update-btn:hover{
    background:var(--brand-green-hover);
}

.update-btn:disabled{
    opacity:.65;
    cursor:not-allowed;
}

/* SECURITY NOTE */

.security-note{
    width:100%;
    margin-top:13px;
    padding:12px 14px;
    display:flex;
    align-items:flex-start;
    gap:10px;
    background:rgba(255,255,255,.68);
    border:1px solid rgba(200,155,60,.25);
    border-radius:10px;
}

.security-note-icon{
    width:29px;
    height:29px;
    min-width:29px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(27,77,46,.08);
    color:var(--brand-green);
    border-radius:9px;
    font-size:13px;
}

.security-note-title{
    margin:0 0 2px;
    color:var(--brand-green);
    font-size:10px;
    font-weight:800;
}

.security-note-text{
    margin:0;
    color:var(--text-muted);
    font-size:9.5px;
    line-height:1.45;
}

/* POPUPS */

.popup-overlay{
    position:fixed;
    inset:0;
    display:none;
    align-items:center;
    justify-content:center;
    background:rgba(20,35,27,.35);
    backdrop-filter:blur(3px);
    z-index:3000;
    padding:20px;
}

.popup{
    width:100%;
    max-width:340px;
    background:#fff;
    border:1px solid rgba(27,77,46,.08);
    border-top:3px solid var(--brand-green);
    border-radius:13px;
    padding:23px 22px;
    text-align:center;
    box-shadow:0 15px 40px rgba(27,77,46,.15);
}

.popup-icon{
    width:42px;
    height:42px;
    margin:0 auto 10px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(27,77,46,.08);
    color:var(--brand-green);
    border-radius:11px;
    font-size:17px;
}

.popup-title{
    margin:0 0 5px;
    color:var(--brand-green);
    font-size:15px;
    font-weight:800;
}

.popup-message{
    max-width:280px;
    margin:0 auto;
    color:var(--text-muted);
    font-size:11px;
    line-height:1.5;
}

.popup-actions{
    display:flex;
    justify-content:center;
    gap:8px;
    margin-top:17px;
}

.popup-btn{
    min-width:82px;
    height:35px;
    padding:0 14px;
    border-radius:7px;
    font-size:10px;
    font-weight:800;
    cursor:pointer;
}

.popup-cancel{
    background:#fff;
    border:1px solid var(--border);
    color:var(--text-dark);
}

.popup-confirm,
.popup-ok{
    background:var(--brand-green);
    border:1px solid var(--brand-green);
    color:#fff;
}

.popup-confirm:hover,
.popup-ok:hover{
    background:var(--brand-green-hover);
}

/* FOOTER */

.security-footer{
    padding:14px 20px;
    border-top:1px solid rgba(27,77,46,.10);
    background:rgba(255,255,255,.65);
    position:relative;
    z-index:2;
}

.footer-inner{
    max-width:1000px;
    margin:0 auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.footer-brand{
    color:var(--brand-green);
    font-size:11px;
    font-weight:800;
}

.footer-links{
    display:flex;
    gap:18px;
}

.footer-links a{
    color:var(--text-muted);
    font-size:10px;
    text-decoration:none;
}

.footer-links a:hover{
    color:var(--brand-green);
}

.footer-copy{
    color:var(--text-muted);
    font-size:10px;
}

/* RESPONSIVE */

@media(max-width:700px){

    .security-header{
        padding:0 20px;
    }

    .security-label{
        display:none;
    }

    .password-page{
        min-height:calc(100vh - 64px);
        padding:34px 15px 25px;
        justify-content:flex-start;
    }

    .password-heading h1{
        font-size:26px;
    }

    .password-heading p{
        font-size:12px;
    }

    .password-card{
        padding:24px 18px;
    }

    .requirement-grid{
        grid-template-columns:1fr;
    }

    .footer-inner{
        flex-direction:column;
        gap:8px;
        text-align:center;
    }

    .footer-links{
        gap:12px;
    }

    .leaf-left{
        left:-105px;
    }

    .leaf-right{
        right:-85px;
    }
}

@media(max-width:420px){

    .password-actions{
        flex-direction:column;
    }

    .password-btn{
        width:100%;
    }

    .password-heading{
        margin-bottom:18px;
    }

    .password-card{
        padding:22px 16px;
    }
}
</style>
</head>

<body>

<!-- SECURITY HEADER -->

<header class="security-header">

    <a href="/" class="brand-name">
        NAADAN BOX
    </a>

    <div class="security-label">
        <i class="bi bi-shield-check"></i>
        Secure Account Verification
    </div>

</header>


<!-- PAGE -->

<main class="password-page">

    <!-- LEAF DECORATIONS -->

    <div class="leaf leaf-left"></div>
    <div class="leaf leaf-right"></div>
    <div class="leaf leaf-small"></div>


    <div class="password-wrapper">

        <!-- PAGE HEADING -->

        <div class="password-heading">

            <div class="heading-eyebrow">
                ACCOUNT SECURITY
            </div>

            <h1>
                Change Password
            </h1>

            <p>
                Update your password to keep your Naadan Box account secure.
            </p>

            <div class="heading-decoration">
                <span></span>
                <span></span>
                <span></span>
            </div>

        </div>


        <!-- PASSWORD CARD -->

        <div class="password-card">

            <div class="password-header">

                <div class="password-icon">
                    <i class="bi bi-key"></i>
                </div>

                <h2 class="password-title">
                    Update Your Password
                </h2>

                <p class="password-subtitle">
                    Create a strong password that you don't use anywhere else.
                </p>

            </div>


            <form id="changePasswordForm" novalidate>

                <!-- CURRENT PASSWORD -->

                <div class="form-group">

                    <label
                        for="currentPassword"
                        class="form-label"
                    >
                        CURRENT PASSWORD
                    </label>

                    <div class="password-input-wrapper">

                        <input
                            type="password"
                            id="currentPassword"
                            name="currentPassword"
                            class="password-input"
                            placeholder="Enter your current password"
                            autocomplete="current-password"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            data-target="currentPassword"
                            aria-label="Toggle current password visibility"
                        >
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <div
                        id="currentPasswordError"
                        class="validation-message"
                    ></div>

                    <div class="forgot-password-link">

                        <a href="/profile/security/forgot-password">
                            Forgot your current password?
                        </a>

                    </div>

                </div>


                <!-- NEW PASSWORD -->

                <div class="form-group">

                    <label
                        for="newPassword"
                        class="form-label"
                    >
                        NEW PASSWORD
                    </label>

                    <div class="password-input-wrapper">

                        <input
                            type="password"
                            id="newPassword"
                            name="newPassword"
                            class="password-input"
                            placeholder="Enter your new password"
                            autocomplete="new-password"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            data-target="newPassword"
                            aria-label="Toggle new password visibility"
                        >
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <div
                        id="newPasswordError"
                        class="validation-message"
                    ></div>

                </div>


                <!-- PASSWORD REQUIREMENTS -->

                <div
                    id="passwordRequirements"
                    class="password-requirements"
                >

                    <div class="strength-header">

                        <span class="strength-label">
                            PASSWORD STRENGTH
                        </span>

                        <span
                            id="strengthText"
                            class="strength-text text-danger"
                        >
                            Weak
                        </span>

                    </div>

                    <div class="progress">

                        <div
                            id="passwordStrengthBar"
                            class="progress-bar bg-danger"
                            style="width:0%"
                        ></div>

                    </div>

                    <div class="requirement-grid">

                        <div
                            id="rule-length"
                            class="req-item"
                        >
                            <i class="bi bi-x-circle"></i>
                            Minimum 8 characters
                        </div>

                        <div
                            id="rule-uppercase"
                            class="req-item"
                        >
                            <i class="bi bi-x-circle"></i>
                            One uppercase
                        </div>

                        <div
                            id="rule-lowercase"
                            class="req-item"
                        >
                            <i class="bi bi-x-circle"></i>
                            One lowercase
                        </div>

                        <div
                            id="rule-number"
                            class="req-item"
                        >
                            <i class="bi bi-x-circle"></i>
                            One number
                        </div>

                        <div
                            id="rule-special"
                            class="req-item"
                        >
                            <i class="bi bi-x-circle"></i>
                            One special character
                        </div>

                    </div>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label
                        for="confirmPassword"
                        class="form-label"
                    >
                        CONFIRM NEW PASSWORD
                    </label>

                    <div class="password-input-wrapper">

                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            class="password-input"
                            placeholder="Confirm your new password"
                            autocomplete="new-password"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            data-target="confirmPassword"
                            aria-label="Toggle confirm password visibility"
                        >
                            <i class="bi bi-eye"></i>
                        </button>

                    </div>

                    <div
                        id="passwordMatchMessage"
                        class="match-message"
                    ></div>

                </div>


                <!-- ACTIONS -->

                <div class="password-actions">

                    <a
                        href="/profile"
                        class="password-btn cancel-btn"
                    >
                        Cancel
                    </a>

                    <button
                        type="submit"
                        class="password-btn update-btn"
                        id="updatePasswordButton"
                    >
                        Update Password
                    </button>

                </div>

            </form>

        </div>


        <!-- SECURITY NOTE -->

        <div class="security-note">

            <div class="security-note-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>

                <p class="security-note-title">
                    Your account stays protected
                </p>

                <p class="security-note-text">
                    Never share your password with anyone. Naadan Box will never ask you for your password.
                </p>

            </div>

        </div>

    </div>

</main>


<!-- CONFIRMATION POPUP -->

<div
    class="popup-overlay"
    id="confirmPopup"
>

    <div class="popup">

        <div class="popup-icon">
            <i class="bi bi-key"></i>
        </div>

        <h3 class="popup-title">
            Confirm Password Change
        </h3>

        <p class="popup-message">
            Are you sure you want to change your password?
        </p>

        <div class="popup-actions">

            <button
                type="button"
                class="popup-btn popup-cancel"
                id="cancelConfirm"
            >
                Cancel
            </button>

            <button
                type="button"
                class="popup-btn popup-confirm"
                id="confirmChange"
            >
                Confirm
            </button>

        </div>

    </div>

</div>


<!-- MESSAGE POPUP -->

<div
    class="popup-overlay"
    id="messagePopup"
>

    <div class="popup">

        <div class="popup-icon">
            <i class="bi bi-exclamation-circle"></i>
        </div>

        <h3
            class="popup-title"
            id="messageTitle"
        >
            Validation Error
        </h3>

        <p
            class="popup-message"
            id="messageText"
        >
            Please check your details.
        </p>

        <div class="popup-actions">

            <button
                type="button"
                class="popup-btn popup-ok"
                id="messageOk"
            >
                OK
            </button>

        </div>

    </div>

</div>


<!-- SUCCESS POPUP -->

<div
    class="popup-overlay"
    id="successPopup"
>

    <div class="popup">

        <div class="popup-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <h3 class="popup-title">
            Password Changed Successfully
        </h3>

        <p class="popup-message">
            Your password has been updated successfully.
        </p>

        <div class="popup-actions">

            <button
                type="button"
                class="popup-btn popup-ok"
                id="successOk"
            >
                OK
            </button>

        </div>

    </div>

</div>


<!-- SECURITY FOOTER -->

<footer class="security-footer">

    <div class="footer-inner">

        <div class="footer-brand">
            NAADAN BOX
        </div>

        <div class="footer-links">

            <a href="#">
                Privacy Policy
            </a>

            <a href="#">
                Terms of Service
            </a>

            <a href="#">
                Shipping Policy
            </a>

            <a href="#">
                Refund Policy
            </a>

        </div>

        <div class="footer-copy">
            © 2026 Naadan Box. Authentic Kerala Flavors.
        </div>

    </div>

</footer>


<script>

const form=document.getElementById("changePasswordForm");

const currentPassword=
document.getElementById("currentPassword");

const newPassword=
document.getElementById("newPassword");

const confirmPassword=
document.getElementById("confirmPassword");

const requirements=
document.getElementById("passwordRequirements");

const strengthText=
document.getElementById("strengthText");

const strengthBar=
document.getElementById("passwordStrengthBar");

const currentPasswordError=
document.getElementById("currentPasswordError");

const newPasswordError=
document.getElementById("newPasswordError");

const passwordMatchMessage=
document.getElementById("passwordMatchMessage");

const confirmPopup=
document.getElementById("confirmPopup");

const messagePopup=
document.getElementById("messagePopup");

const successPopup=
document.getElementById("successPopup");

const cancelConfirm=
document.getElementById("cancelConfirm");

const confirmChange=
document.getElementById("confirmChange");

const messageOk=
document.getElementById("messageOk");

const successOk=
document.getElementById("successOk");

const updateButton=
document.getElementById("updatePasswordButton");


const rules={

    length:
    document.getElementById("rule-length"),

    uppercase:
    document.getElementById("rule-uppercase"),

    lowercase:
    document.getElementById("rule-lowercase"),

    number:
    document.getElementById("rule-number"),

    special:
    document.getElementById("rule-special")

};


let strengthTimeout;


/* PASSWORD VISIBILITY */

document
.querySelectorAll(".password-toggle")
.forEach(button=>{

    button.addEventListener("click",()=>{

        const input=
        document.getElementById(
            button.dataset.target
        );

        const icon=
        button.querySelector("i");

        if(input.type==="password"){

            input.type="text";

            icon.className=
            "bi bi-eye-slash";

        }else{

            input.type="password";

            icon.className=
            "bi bi-eye";

        }

    });

});


/* PASSWORD VALIDATION */

function checkPassword(){

    const value=
    newPassword.value;

    clearTimeout(
        strengthTimeout
    );


    if(!value){

        requirements
        .classList
        .remove("active");

        newPassword
        .classList
        .remove(
            "is-valid",
            "is-invalid"
        );

        newPasswordError
        .className=
        "validation-message";

        newPasswordError
        .textContent="";

        return false;
    }


    requirements
    .classList
    .add("active");


    const checks={

        length:
        value.length>=8,

        uppercase:
        /[A-Z]/.test(value),

        lowercase:
        /[a-z]/.test(value),

        number:
        /[0-9]/.test(value),

        special:
        /[^A-Za-z0-9]/.test(value)

    };


    updateRule(
        rules.length,
        checks.length
    );

    updateRule(
        rules.uppercase,
        checks.uppercase
    );

    updateRule(
        rules.lowercase,
        checks.lowercase
    );

    updateRule(
        rules.number,
        checks.number
    );

    updateRule(
        rules.special,
        checks.special
    );


    const score=
    Object.values(checks)
    .filter(Boolean)
    .length;


    strengthBar.style.width=
    score*20+"%";


    if(score<=2){

        strengthText.textContent=
        "Weak";

        strengthText.className=
        "strength-text text-danger";

        strengthBar.className=
        "progress-bar bg-danger";

    }else if(score<=4){

        strengthText.textContent=
        "Medium";

        strengthText.className=
        "strength-text text-warning";

        strengthBar.className=
        "progress-bar bg-warning";

    }else{

        strengthText.textContent=
        "Strong";

        strengthText.className=
        "strength-text text-success";

        strengthBar.className=
        "progress-bar bg-success";

        strengthTimeout=
        setTimeout(()=>{

            requirements
            .classList
            .remove("active");

        },2000);

    }


    const valid=
    Object.values(checks)
    .every(Boolean);


    if(valid){

        newPassword
        .classList
        .add("is-valid");

        newPassword
        .classList
        .remove("is-invalid");

        newPasswordError
        .className=
        "validation-message success";

        newPasswordError
        .textContent=
        "Password meets all requirements.";

    }else{

        newPassword
        .classList
        .add("is-invalid");

        newPassword
        .classList
        .remove("is-valid");

        newPasswordError
        .className=
        "validation-message error";

        newPasswordError
        .textContent=
        "Password does not meet all requirements.";

    }


    checkPasswordMatch();

    return valid;
}


function updateRule(
    element,
    valid
){

    if(valid){

        element
        .classList
        .add("valid");

        element
        .querySelector("i")
        .className=
        "bi bi-check-circle";

    }else{

        element
        .classList
        .remove("valid");

        element
        .querySelector("i")
        .className=
        "bi bi-x-circle";

    }

}


/* CONFIRM PASSWORD */

function checkPasswordMatch(){

    if(!confirmPassword.value){

        confirmPassword
        .classList
        .remove(
            "is-valid",
            "is-invalid"
        );

        passwordMatchMessage
        .className=
        "match-message";

        passwordMatchMessage
        .textContent="";

        return false;
    }


    if(
        confirmPassword.value===
        newPassword.value
    ){

        confirmPassword
        .classList
        .add("is-valid");

        confirmPassword
        .classList
        .remove("is-invalid");

        passwordMatchMessage
        .className=
        "match-message success";

        passwordMatchMessage
        .textContent=
        "Passwords match.";

        return true;
    }


    confirmPassword
    .classList
    .add("is-invalid");

    confirmPassword
    .classList
    .remove("is-valid");

    passwordMatchMessage
    .className=
    "match-message error";

    passwordMatchMessage
    .textContent=
    "Passwords do not match.";

    return false;
}


/* INPUT EVENTS */

newPassword.addEventListener(
    "input",
    checkPassword
);

confirmPassword.addEventListener(
    "input",
    checkPasswordMatch
);


currentPassword.addEventListener(
    "input",
    ()=>{

        if(currentPassword.value){

            currentPassword
            .classList
            .remove("is-invalid");

            currentPasswordError
            .className=
            "validation-message";

            currentPasswordError
            .textContent="";

        }

    }
);


/* FORM SUBMIT */

form.addEventListener(
    "submit",
    event=>{

        event.preventDefault();


        const current=
        currentPassword.value.trim();


        const passwordValid=
        checkPassword();


        const matchValid=
        checkPasswordMatch();


        if(!current){

            currentPassword
            .classList
            .add("is-invalid");

            currentPasswordError
            .className=
            "validation-message error";

            currentPasswordError
            .textContent=
            "Current password is required.";

            currentPassword.focus();

            return;
        }


        if(!passwordValid){

            newPassword.focus();

            return;
        }


        if(!matchValid){

            confirmPassword.focus();

            return;
        }


        confirmPopup.style.display=
        "flex";

    }
);


/* CANCEL */

cancelConfirm.addEventListener(
    "click",
    ()=>{

        confirmPopup.style.display=
        "none";

    }
);


/* CONFIRM */

confirmChange.addEventListener(
    "click",
    async()=>{

        confirmPopup.style.display=
        "none";

        updateButton.disabled=
        true;

        updateButton.textContent=
        "Updating...";


        try{

            const response=
            await fetch(
                "/profile/security/change-password",
                {
                    method:"POST",

                    headers:{
                        "Content-Type":
                        "application/json"
                    },

                    body:JSON.stringify({

                        currentPassword:
                        currentPassword.value,

                        newPassword:
                        newPassword.value,

                        confirmPassword:
                        confirmPassword.value

                    })

                }
            );


            const data=
            await response.json();


            if(data.success){

                successPopup.style.display=
                "flex";

            }else{

                showMessage(
                    "Unable to Change Password",
                    data.message ||
                    "Unable to change your password."
                );

            }

        }catch(error){

            console.error(
                "Change password error:",
                error
            );

            showMessage(
                "Something Went Wrong",
                "Unable to change your password. Please try again."
            );

        }finally{

            updateButton.disabled=
            false;

            updateButton.textContent=
            "Update Password";

        }

    }
);


/* MESSAGE POPUP */

function showMessage(
    title,
    message
){

    document.getElementById(
        "messageTitle"
    ).textContent=
    title;

    document.getElementById(
        "messageText"
    ).textContent=
    message;

    messagePopup.style.display=
    "flex";

}


messageOk.addEventListener(
    "click",
    ()=>{

        messagePopup.style.display=
        "none";

    }
);


/* SUCCESS */

successOk.addEventListener(
    "click",
    ()=>{

        window.location.href=
        "/profile";

    }
);

</script>

</body>
</html>